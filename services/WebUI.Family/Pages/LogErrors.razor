@page "/log-errors"
@rendermode InteractiveServer
@layout WebUI.Shared.MainLayout

<PageTitle>错误日志 - 百花</PageTitle>

<div class="container-fluid py-3">
    <h4 class="mb-3">🚨 错误日志</h4>
    <div class="mb-2 d-flex gap-2 align-items-center">
        <button class="btn btn-sm btn-outline-secondary" @onclick="Refresh">🔄 刷新</button>
        <span class="small">@status</span>
    </div>

    @if (loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (entries.Count == 0)
    {
        <div class="alert alert-info">暂无错误日志</div>
    }
    else
    {
        <div class="list-group" style="font-size: 0.85rem;">
            @foreach (var e in entries)
            {
                <div class="list-group-item py-1 px-2">
                    <small class="text-muted">@e.Time</small>
                    <code style="font-size:0.8rem;white-space:pre-wrap;word-break:break-all;">@e.Msg</code>
                </div>
            }
        </div>
    }
</div>

@code {
    private record Entry(string Time, string Msg);
    private List<Entry> entries = new();
    private bool loading = true;
    private string status = "";

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        loading = true;
        entries.Clear();

        try
        {
            foreach (var svc in new[] { "taskrunner", "webui", "vault", "ai" })
            {
                var path = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"bh-{svc}.log");
                if (!System.IO.File.Exists(path)) continue;

                var text = await System.IO.File.ReadAllTextAsync(path);
                var lines = text.Split('\n');
                foreach (var line in lines.Reverse())
                {
                    var t = line.Trim();
                    if (t.Length == 0) continue;
                    if (!t.Contains("ERR") && !t.Contains("Error") && !t.Contains("Exception") && !t.Contains("fail") && !t.Contains("WRN")) continue;

                    var time = "";
                    var m = System.Text.RegularExpressions.Regex.Match(t, @"\d{2}:\d{2}:\d{2}");
                    if (m.Success) time = m.Value;

                    entries.Add(new Entry(time, $"[{svc}] {t}"));
                    if (entries.Count >= 200) break;
                }
                if (entries.Count >= 200) break;
            }
            status = $"{entries.Count} 条";
        }
        catch (Exception ex)
        {
            entries.Add(new Entry("", $"读取失败: {ex.Message}"));
            status = "❌";
        }

        loading = false;
    }
}
