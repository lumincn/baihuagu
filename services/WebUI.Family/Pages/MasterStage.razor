@page "/master-stage"
@rendermode InteractiveServer
@using WebUI.Services
@using TaskRunner.Contracts.Master
@inject WebUI.Services.IApiService ApiService
@inject NavigationManager NavigationManager

<PageTitle>阶段进度</PageTitle>

<h1>阶段进度</h1>

@if (masterId == null)
{
    <div class="empty-state">
        <p>未选择师父，<a href="master-chat">返回师父对话页</a></p>
    </div>
}
else if (isLoading)
{
    <div class="loading">加载中...</div>
}
else
{
    <div class="stage-header">
        <div class="stage-master-info">
            <span class="master-label">师父：</span>
            <span class="master-value">@masterName</span>
        </div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="GoBack">返回对话</button>
    </div>

    <div class="timeline">
        @foreach (var stage in allStages)
        {
            var status = GetStageStatus(stage.Name);
            <div class="timeline-item @status.ToLower()">
                <div class="timeline-marker">
                    @if (status == "Completed")
                    {
                        <span class="marker-done">✓</span>
                    }
                    else if (status == "Current")
                    {
                        <span class="marker-current">▶</span>
                    }
                    else
                    {
                        <span class="marker-pending">@stage.Order</span>
                    }
                </div>
                <div class="timeline-content">
                    <div class="timeline-title">
                        <span class="stage-name">@stage.DisplayName</span>
                        <span class="stage-status-badge @status.ToLower()">@GetStatusText(status)</span>
                    </div>
                    <div class="timeline-desc">@stage.Description</div>
                    @if (status == "Current")
                    {
                        <div class="timeline-progress">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @GetProgressWidth(stage.Name)"></div>
                            </div>
                            <span class="progress-text">@graduatedStages.Count/5 阶段完成</span>
                        </div>
                        <button class="btn btn-sm btn-primary" @onclick="() => CompleteStageAsync(stage.Name)" disabled="@isCompleting">
                            @(isCompleting ? "处理中..." : "完成此阶段")
                        </button>
                    }
                    @if (status == "Completed" && stageSummaries.ContainsKey(stage.Name))
                    {
                        <div class="stage-summary">
                            <div class="summary-label">阶段摘要</div>
                            <div class="summary-text">@stageSummaries[stage.Name]</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: rgba(255,255,255,0.5);
    }
    .empty-state a { color: #2e8baf; }
    .loading {
        text-align: center;
        padding: 3rem;
        color: rgba(255,255,255,0.5);
    }
    .stage-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .master-label {
        color: rgba(255,255,255,0.6);
        font-size: 0.9rem;
    }
    .master-value {
        font-weight: 600;
        font-size: 1rem;
    }
    .timeline {
        position: relative;
        padding-left: 2rem;
    }
    .timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: rgba(255,255,255,0.1);
    }
    .timeline-item {
        position: relative;
        margin-bottom: 1.5rem;
    }
    .timeline-marker {
        position: absolute;
        left: -2rem;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 600;
    }
    .timeline-item.completed .timeline-marker {
        background: #2e7d32;
        color: #fff;
    }
    .timeline-item.current .timeline-marker {
        background: #2e8baf;
        color: #fff;
    }
    .timeline-item.pending .timeline-marker {
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.4);
    }
    .timeline-content {
        padding-left: 0.5rem;
    }
    .timeline-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.3rem;
    }
    .stage-name {
        font-weight: 600;
        font-size: 1rem;
    }
    .stage-status-badge {
        padding: 0.1rem 0.5rem;
        border-radius: 1rem;
        font-size: 0.7rem;
        font-weight: 500;
    }
    .stage-status-badge.completed { background: #2e7d32; color: #fff; }
    .stage-status-badge.current { background: #2e8baf; color: #fff; }
    .stage-status-badge.pending { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.4); }
    .timeline-desc {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.6);
        margin-bottom: 0.5rem;
    }
    .timeline-progress {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }
    .progress-bar {
        flex: 1;
        max-width: 200px;
        height: 6px;
        border-radius: 3px;
        background: rgba(255,255,255,0.1);
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        border-radius: 3px;
        background: #2e8baf;
        transition: width 0.3s;
    }
    .progress-text {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.5);
    }
    .stage-summary {
        margin-top: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
    }
    .summary-label {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.4);
        margin-bottom: 0.25rem;
    }
    .summary-text {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.7);
        line-height: 1.5;
    }
</style>

@code {
    private string? masterId;
    private string masterName = "";
    private string currentStage = "入道";
    private List<string> graduatedStages = new();
    private Dictionary<string, string> stageSummaries = new();
    private List<StageInfo> allStages = new();
    private bool isLoading = true;
    private bool isCompleting = false;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        masterId = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).GetValueOrDefault("masterId").ToString();

        if (string.IsNullOrEmpty(masterId))
        {
            isLoading = false;
            return;
        }

        allStages = new List<StageInfo>
        {
            new() { Name = "入道", DisplayName = "入道", Description = "确定目标、评估基础、生成初始知识库和任务", Order = 1 },
            new() { Name = "筑基", DisplayName = "筑基", Description = "建立知识框架、每日任务、养成学习习惯", Order = 2 },
            new() { Name = "精进", DisplayName = "精进", Description = "分科细化、攻克细节、消除薄弱环节", Order = 3 },
            new() { Name = "磨砺", DisplayName = "磨砺", Description = "模拟考试、查漏补缺、强化高频考点", Order = 4 },
            new() { Name = "出师", DisplayName = "出师", Description = "能力认证、报考指导、考前冲刺", Order = 5 },
        };

        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            var profile = await ApiService.GetMasterProfileAsync(masterId!);
            if (profile.Success)
            {
                masterName = profile.CurrentStage;
                currentStage = profile.CurrentStage;
                graduatedStages = profile.GraduatedStages;
                masterName = (await ApiService.GetMastersAsync()).FirstOrDefault(m => m.MasterId == masterId)?.MasterName ?? "师父";
            }
        }
        catch { }
        isLoading = false;
        StateHasChanged();
    }

    private string GetStageStatus(string stageName)
    {
        if (graduatedStages.Contains(stageName)) return "Completed";
        if (stageName == currentStage) return "Current";
        return "Pending";
    }

    private static string GetStatusText(string status) => status switch
    {
        "Completed" => "已完成",
        "Current" => "进行中",
        _ => "未开始"
    };

    private string GetProgressWidth(string stageName)
    {
        return $"{(graduatedStages.Count / 5.0 * 100):F0}%";
    }

    private async Task CompleteStageAsync(string stageName)
    {
        isCompleting = true;
        StateHasChanged();

        try
        {
            var result = await ApiService.MasterStageCompleteAsync(masterId!, stageName);
            if (result.Success)
            {
                if (!graduatedStages.Contains(stageName))
                    graduatedStages.Add(stageName);
                if (!string.IsNullOrEmpty(result.NextStage))
                    currentStage = result.NextStage;
                if (!string.IsNullOrEmpty(result.Summary))
                    stageSummaries[stageName] = result.Summary;
            }
        }
        catch { }
        finally
        {
            isCompleting = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("master-chat");
    }
}
