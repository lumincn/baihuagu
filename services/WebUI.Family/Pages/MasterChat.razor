@page "/master-chat"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using WebUI.Services
@using Markdig
@using Microsoft.JSInterop
@using TaskRunner.Contracts.Master
@inject WebUI.Services.IApiService ApiService
@inject GlobalStateService GlobalStateService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>虚拟师父</PageTitle>

<div class="master-layout">
    <div class="master-sidebar">
        <div class="sidebar-header">
            <h3>师父</h3>
            <button class="btn btn-sm btn-primary" @onclick="ShowCreateModal">+ 拜师</button>
        </div>
        <div class="master-list">
            @foreach (var m in masters)
            {
                <div class="master-card @(selectedMasterId == m.MasterId ? "active" : "")" @onclick="() => SelectMaster(m)">
                    <div class="master-card-name">@m.MasterName</div>
                    <div class="master-card-goal">@Truncate(m.Goal, 30)</div>
                    <div class="master-card-stage">
                        <span class="stage-badge stage-@m.CurrentStageOrder">@m.CurrentStage</span>
                        <span class="stage-progress">@m.GraduatedStages.Count/5</span>
                    </div>
                </div>
            }
            @if (masters.Count == 0)
            {
                <div class="empty-hint">还没有师父，点击「拜师」创建</div>
            }
        </div>
    </div>

    <div class="master-main">
        @if (selectedMaster == null)
        {
            <div class="master-empty">
                <div class="empty-icon">🏛️</div>
                <div class="empty-text">选择一位师父开始学习之旅</div>
            </div>
        }
        else
        {
            <div class="master-header">
                <div class="master-info">
                    <span class="master-name">@selectedMaster.MasterName</span>
                    <span class="stage-badge stage-@selectedMaster.CurrentStageOrder">@selectedMaster.CurrentStage</span>
                </div>
                <div class="master-actions">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GoToProfile" title="画像">👤</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GoToStage">阶段进度</button>
                    <button class="btn btn-sm btn-outline-info" @onclick="RunEvictAsync" title="清理旧数据">🧹</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMasterAsync(selectedMaster.MasterId)">删除</button>
                </div>
            </div>

            <div class="stage-tip">
                @GetStageTip(selectedMaster.CurrentStage)
            </div>

            <div class="chat-messages">
                @if (chatMessages.Count == 0 && !isThinking)
                {
                    <div class="quick-questions">
                        <div class="quick-hint">不知道该问什么？试试这些：</div>
                        @foreach (var q in GetQuickQuestions())
                        {
                            <button class="quick-q-btn" @onclick="() => SetQuickQuestion(q)">@q</button>
                        }
                    </div>
                }

                @foreach (var msg in chatMessages)
                {
                    <div class="message @(msg.IsUser ? "user" : "master")">
                        <div class="message-avatar">
                            @(msg.IsUser ? "👤" : selectedMaster.MasterName[..1])
                        </div>
                        <div class="message-content">
                            <div class="message-text">
                                @if (msg.IsUser)
                                {
                                    @msg.Content
                                }
                                else
                                {
                                    @((MarkupString)RenderMarkdown(msg.Content))
                                }
                            </div>
                            <div class="message-time">@msg.Time.ToString("HH:mm")</div>
                        </div>
                    </div>
                }

                @if (isThinking)
                {
                    <div class="message master">
                        <div class="message-avatar">@selectedMaster.MasterName[..1]</div>
                        <div class="message-content">
                            <div class="typing-indicator">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="chat-input">
                <textarea @bind="inputMessage"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="向师父请教...&#10;Shift+Enter 换行，Enter 发送"
                          class="form-control chat-textarea"
                          rows="1"
                          disabled="@isThinking"></textarea>
                @if (isThinking)
                {
                    <button @onclick="StopChat" class="btn btn-danger">⏹ 停止</button>
                }
                else
                {
                    <button @onclick="SendMessage" class="btn btn-primary" disabled="@(!CanSend)">发送</button>
                }
            </div>
        }
    </div>
</div>

@if (showDisclaimer)
{
    <MasterDisclaimerDialog
        IsMedicalOrLegal="@IsMedicalOrLegalIndustry(createIndustry)"
        OnConfirmCallback="OnDisclaimerConfirmed"
        OnCancelCallback="OnDisclaimerCancelled" />
}

@if (showAiConfigWarning)
{
    <div class="modal-overlay" @onclick="DismissAiWarning">
        <div class="modal-content" @onclick:stopPropagation>
            <h4>AI 未配置</h4>
            <p style="color: rgba(255,255,255,0.7); margin: 1rem 0;">虚拟师父需要 AI 服务支持，请先配置 API Key 和模型。</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="DismissAiWarning">稍后再说</button>
                <button class="btn btn-primary" @onclick="GoToAiSettings">前往配置</button>
            </div>
        </div>
    </div>
}

@if (showCreateModal)
{
    <div class="modal-overlay" @onclick="HideCreateModal">
        <div class="modal-content" @onclick:stopPropagation>
            <h4>拜师学艺</h4>
            <div class="form-group">
                <label>行业</label>
                <input type="text" class="form-control" @bind="createIndustry" list="industry-list" placeholder="输入或选择行业" />
                <datalist id="industry-list">
                    <option value="中医" />
                    <option value="医学" />
                    <option value="计算机" />
                    <option value="IT" />
                    <option value="会计" />
                    <option value="财务" />
                    <option value="教资" />
                    <option value="教育" />
                    <option value="法律" />
                    <option value="建筑" />
                    <option value="通用" />
                </datalist>
            </div>
            <div class="form-group">
                <label>学习目标</label>
                <input type="text" class="form-control" @bind="createGoal" placeholder="例如：通过执业医师资格考试" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="HideCreateModal">取消</button>
                <button class="btn btn-primary" @onclick="CreateMasterAsync" disabled="@isCreating">
                    @(isCreating ? "正在拜师..." : "确认拜师")
                </button>
            </div>
        </div>
    </div>
}

