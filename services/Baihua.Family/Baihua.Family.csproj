<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bh-family</AssemblyName>
    <UseAppHost>true</UseAppHost>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">linux-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateResource>false</GenerateResource>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <RootNamespace>Baihua.Family</RootNamespace>
    <UserSecretsId>baihua-family-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅测试支撑：允许集成测试（WebApplicationFactory<Program>）访问内部 Program 类 -->
    <InternalsVisibleTo Include="Baihua.Family.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.26.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.13.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="OpenTelemetry" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.11.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="OpenAI" Version="2.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnkiGen.Core" Version="1.0.0" />
    <ProjectReference Include="..\Baihua.Data\Baihua.Data.csproj" />
    <ProjectReference Include="..\Baihua.Core\Baihua.Core.csproj" />
    <ProjectReference Include="..\Baihua.AI.Provider\Baihua.AI.Provider.csproj" />
    <ProjectReference Include="..\Baihua.Contracts\Baihua.Contracts.csproj" />
    <ProjectReference Include="..\..\libs\MobileContract\MobileContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="**/*.resx" />
    <EmbeddedResource Include="Data/ExamOutlines/*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本地视觉推理服务（OpenVINO），随发布拷贝 -->
    <None Include="..\Baihua.AI.Provider\LocalVision\vision_server.py" Link="LocalVision\vision_server.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- OpenVINO OpenAI 兼容推理服务（OpenClaw 本地 AI 配置启动用），随发布拷贝 -->
    <None Include="..\Baihua.AI.Provider\LocalVision\openvino_llm_server.py" Link="LocalVision\openvino_llm_server.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>


