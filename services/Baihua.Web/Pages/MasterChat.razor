@page "/master-chat"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using Baihua.Web.Services
@using Microsoft.Extensions.Localization
@using Markdig
@using Microsoft.JSInterop
@using Baihua.Contracts.Master
@inject Baihua.Web.Services.IApiService ApiService
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@inject GlobalStateService GlobalStateService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@L["MasterChat_PageTitle"]</PageTitle>

<div class="master-layout">
    <div class="master-sidebar">
        <div class="sidebar-header">
            <h3>@L["MasterChat_Title"]</h3>
            <button class="btn btn-sm btn-primary" @onclick="ShowCreateModal">@L["MasterChat_CreateMaster"]</button>
        </div>
        <div class="master-list">
            @foreach (var m in masters)
            {
                <div class="master-card @(selectedMasterId == m.MasterId ? "active" : "")" @onclick="() => SelectMaster(m)">
                    <div class="master-card-name">@m.MasterName</div>
                    <div class="master-card-goal">@Truncate(m.Goal, 30)</div>
                    <div class="master-card-stage">
                        <span class="stage-badge stage-@m.CurrentStageOrder">@m.CurrentStage</span>
                        <span class="stage-progress">@m.GraduatedStages.Count/5</span>
                    </div>
                </div>
            }
            @if (masters.Count == 0)
            {
                <div class="empty-hint">@L["MasterChat_EmptyHint"]</div>
            }
        </div>
    </div>

    <div class="master-main">
        @if (selectedMaster == null)
        {
            <div class="master-empty">
                <div class="empty-icon">🏛️</div>
                <div class="empty-text">@L["MasterChat_EmptyDesc"]</div>
            </div>
        }
        else
        {
            <div class="master-header">
                <div class="master-info">
                    <span class="master-name">@selectedMaster.MasterName</span>
                    <span class="stage-badge stage-@selectedMaster.CurrentStageOrder">@selectedMaster.CurrentStage</span>
                </div>
                <div class="master-actions">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GoToProfile" title="@L["MasterChat_ViewProfile"]">👤</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GoToStage">@L["MasterChat_StageProgress"]</button>
                    <button class="btn btn-sm btn-outline-info" @onclick="RunEvictAsync" title="@L["MasterChat_EvictData"]">🧹</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDeleteMaster(selectedMaster.MasterId, selectedMaster.MasterName)">@L["MasterChat_DeleteMaster"]</button>
                </div>
            </div>

            <div class="stage-tip">
                @GetStageTip(selectedMaster.CurrentStage)
            </div>

            <div class="chat-messages">
                @if (chatMessages.Count == 0 && !isThinking)
                {
                    <div class="quick-questions">
                        <div class="quick-hint">@L["MasterChat_QuickHint"]</div>
                        @foreach (var q in GetQuickQuestions())
                        {
                            <button class="quick-q-btn" @onclick="() => SetQuickQuestion(q)">@q</button>
                        }
                    </div>
                }

                @foreach (var msg in chatMessages)
                {
                    <div class="message @(msg.IsUser ? "user" : "master")">
                        <div class="message-avatar">
                            @(msg.IsUser ? "👤" : selectedMaster.MasterName[..1])
                        </div>
                        <div class="message-content">
                            <div class="message-text">
                                @if (msg.IsUser)
                                {
                                    @msg.Content
                                }
                                else
                                {
                                    @((MarkupString)RenderMarkdown(msg.Content))
                                }
                            </div>
                            <div class="message-time">@msg.Time.ToString("HH:mm")</div>
                        </div>
                    </div>
                }

                @if (isThinking)
                {
                    <div class="message master">
                        <div class="message-avatar">@selectedMaster.MasterName[..1]</div>
                        <div class="message-content">
                            <div class="typing-indicator">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="chat-input">
                <textarea @bind="inputMessage"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="@L["MasterChat_InputPlaceholder"]"
                          class="form-control chat-textarea"
                          rows="1"
                          disabled="@isThinking"></textarea>
                @if (isThinking)
                {
                    <button @onclick="StopChat" class="btn btn-danger">⏹ @L["MasterChat_StopBtn"]</button>
                }
                else
                {
                    <button @onclick="SendMessage" class="btn btn-primary" disabled="@(!CanSend)">@L["MasterChat_SendBtn"]</button>
                }
            </div>
        }
    </div>
</div>

@if (showDisclaimer)
{
    <MasterDisclaimerDialog
        IsMedicalOrLegal="@IsMedicalOrLegalIndustry(createIndustry)"
        OnConfirmCallback="OnDisclaimerConfirmed"
        OnCancelCallback="OnDisclaimerCancelled" />
}

@if (showAiConfigWarning)
{
    <div class="modal-overlay" @onclick="DismissAiWarning">
        <div class="modal-content" @onclick:stopPropagation>
            <h4>@L["MasterChat_AiNotConfigured"]</h4>
            <p style="color: var(--master-text-secondary); margin: 1rem 0;">@L["MasterChat_AiConfigRequired"]</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="DismissAiWarning">@L["MasterChat_AiConfigLater"]</button>
                <button class="btn btn-primary" @onclick="GoToAiSettings">@L["MasterChat_AiConfigGo"]</button>
            </div>
        </div>
    </div>
}

@if (showCreateModal)
{
    <div class="modal-overlay" @onclick="HideCreateModal">
        <div class="modal-content" @onclick:stopPropagation>
            <h4>@L["MasterChat_ModalTitle"]</h4>
            <div class="form-group">
                <label>@L["MasterChat_Industry"]</label>
                <input type="text" class="form-control" @bind="createIndustry" list="industry-list" placeholder="输入或选择行业" />
                <datalist id="industry-list">
                    <option value="中医" />
                    <option value="医学" />
                    <option value="计算机" />
                    <option value="IT" />
                    <option value="会计" />
                    <option value="财务" />
                    <option value="教资" />
                    <option value="教育" />
                    <option value="法律" />
                    <option value="建筑" />
                    <option value="通用" />
                </datalist>
            </div>
            <div class="form-group">
                <label>@L["MasterChat_LearningGoal"]</label>
                <input type="text" class="form-control" @bind="createGoal" placeholder="@L["MasterChat_GoalPlaceholder"]" />
            </div>
            @if (!string.IsNullOrEmpty(createError))
            {
                <div class="create-error">@createError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="HideCreateModal">@L["MasterChat_Cancel"]</button>
                <button class="btn btn-primary" @onclick="CreateMasterAsync" disabled="@isCreating">
                    @(isCreating ? L["MasterChat_Creating"] : L["MasterChat_ConfirmCreate"])
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(pendingDeleteMasterId))
{
    <div class="modal-overlay" @onclick="CancelDeleteMaster">
        <div class="modal-content" @onclick:stopPropagation>
            <h4>⚠️ @L["MasterChat_DeleteMaster"]</h4>
            <p style="color: var(--master-text-secondary); margin: 1rem 0;">
                确定要删除师父「@pendingDeleteMasterName」吗？拜师进度与师徒关系将一并删除，此操作不可恢复。
            </p>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelDeleteMaster">@L["MasterChat_Cancel"]</button>
                <button class="btn btn-danger" @onclick="ConfirmDeleteMaster">确认删除</button>
            </div>
        </div>
    </div>
}

<style>
    .master-layout {
        display: flex;
        gap: 1rem;
        height: calc(100vh - 120px);
    }
    .master-sidebar {
        width: 240px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #d8e2e8;
        padding-right: 1rem;
    }
    [data-bs-theme="dark"] .master-sidebar {
        border-right-color: rgba(255,255,255,0.1);
    }
    .sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }
    .sidebar-header h3 {
        margin: 0;
        font-size: 1rem;
    }
    .master-list {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .master-card {
        padding: 0.75rem;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #d8e2e8;
        cursor: pointer;
        transition: all 0.2s;
    }
    .master-card:hover {
        background: #f0f5f8;
        border-color: #d8e2e8;
    }
    [data-bs-theme="dark"] .master-card {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.1);
    }
    [data-bs-theme="dark"] .master-card:hover {
        background: rgba(255,255,255,0.03);
        border-color: rgba(255,255,255,0.1);
    }
    .master-card.active {
        background: rgba(var(--master-accent-rgb), 0.2);
        border-color: rgba(var(--master-accent-rgb), 0.5);
    }
    .master-card-name {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
    }
    .master-card-goal {
        font-size: 0.8rem;
        color: var(--master-text-muted);
        margin-bottom: 0.4rem;
    }
    .master-card-stage {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .stage-badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 500;
    }
    .stage-1 { background: #e8f5e9; color: #2e7d32; }
    .stage-2 { background: #e3f2fd; color: #1565c0; }
    .stage-3 { background: #fff3e0; color: #e65100; }
    .stage-4 { background: #fce4ec; color: #c62828; }
    .stage-5 { background: #f3e5f5; color: #6a1b9a; }
    [data-bs-theme="dark"] .stage-1 { background: rgba(46,125,50,0.2); color: #66bb6a; }
    [data-bs-theme="dark"] .stage-2 { background: rgba(21,101,192,0.2); color: #64b5f6; }
    [data-bs-theme="dark"] .stage-3 { background: rgba(230,81,0,0.2); color: #ff9800; }
    [data-bs-theme="dark"] .stage-4 { background: rgba(198,40,40,0.2); color: #ef5350; }
    [data-bs-theme="dark"] .stage-5 { background: rgba(106,27,154,0.2); color: #ce93d8; }
    .stage-progress {
        font-size: 0.75rem;
        color: var(--master-text-dim);
    }
    .empty-hint {
        text-align: center;
        color: var(--master-text-dim);
        font-size: 0.85rem;
        padding: 2rem 0;
    }
    .master-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .master-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--master-text-dim);
    }
    .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
    .empty-text {
        font-size: 1rem;
    }
    .master-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--master-border);
        margin-bottom: 0.5rem;
    }
    .master-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .master-name {
        font-size: 1.1rem;
        font-weight: 600;
    }
    .master-actions {
        display: flex;
        gap: 0.5rem;
    }
    .stage-tip {
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        background: rgba(var(--master-accent-rgb), 0.1);
        border: 1px solid rgba(var(--master-accent-rgb), 0.2);
        font-size: 0.85rem;
        color: var(--master-text-secondary);
        margin-bottom: 0.75rem;
    }
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem 0;
    }
    .message {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }
    .message.user {
        flex-direction: row-reverse;
    }
    .message-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }
    .message.user .message-avatar {
        background: var(--master-user-bubble);
        color: var(--master-user-text);
    }
    .message.master .message-avatar {
        background: var(--master-ai-bubble);
        color: var(--master-ai-text);
        font-weight: 600;
    }
    .message-content {
        max-width: 75%;
        min-width: 0; /* flex 子项允许收缩，防止长内容撑破气泡 */
    }
    [data-bs-theme="dark"] .message-content {
        background: transparent;
    }
    .message-text {
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        line-height: 1.5;
        font-size: 0.9rem;
        min-width: 0;
        word-break: break-word;
        overflow-wrap: anywhere;
    }
    .message.user .message-content {
        background: transparent;
    }
    [data-bs-theme="dark"] .message.user .message-content {
        background: #1a1f2e;
    }
    .message.user .message-text {
        background: var(--master-user-bubble);
        color: var(--master-user-text);
    }
    .message.master .message-text {
        background: #f0f5f8;
        color: #333333;
    }
    [data-bs-theme="dark"] .message.master .message-text {
        background: #2a3648;
        color: rgba(255,255,255,0.88);
    }
    .message-time {
        font-size: 0.75rem;
        color: #888888;
        margin-top: 0.25rem;
    }
    .message.user .message-time {
        text-align: right;
    }
    [data-bs-theme="dark"] .message-time {
        color: rgba(255,255,255,0.65);
    }
    [data-bs-theme="dark"] .message.user .message-time {
        color: rgba(255,255,255,0.70);
    }
    .typing-indicator {
        display: flex;
        gap: 4px;
        padding: 0.5rem;
    }
    .typing-indicator span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #888888;
        animation: typing 1.4s infinite;
    }
    [data-bs-theme="dark"] .typing-indicator span {
        background: rgba(255,255,255,0.45);
    }
    .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
    .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes typing {
        0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
        30% { transform: translateY(-6px); opacity: 1; }
    }
    .chat-input {
        display: flex;
        gap: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid #d8e2e8;
    }
    [data-bs-theme="dark"] .chat-input {
        border-top-color: rgba(255,255,255,0.1);
    }
    .chat-input textarea {
        flex: 1;
        resize: none;
        min-height: 2.5rem;
        max-height: 8rem;
        overflow-y: auto;
        line-height: 1.4;
        padding: 0.5rem 0.75rem;
        background: #ffffff;
        border: 1px solid #d8e2e8;
        color: #333333;
    }
    .chat-input textarea:focus {
        outline: none;
        border-color: #2e8baf;
    }
    .chat-input textarea::placeholder {
        color: #aaaaaa;
    }
    [data-bs-theme="dark"] .chat-input textarea {
        background: rgba(255,255,255,0.08);
        border-color: rgba(255,255,255,0.15);
        color: #ffffff;
    }
    [data-bs-theme="dark"] .chat-input textarea::placeholder {
        color: rgba(255,255,255,0.35);
    }
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    [data-bs-theme="dark"] .modal-overlay {
        background: rgba(0,0,0,0.5);
    }
    .modal-content {
        background: #ffffff;
        border: 1px solid #d8e2e8;
        border-radius: 12px;
        padding: 1.5rem;
        width: 400px;
        max-width: 90vw;
    }
    [data-bs-theme="dark"] .modal-content {
        background: #1e2a3a;
        border-color: rgba(255,255,255,0.1);
    }
    .modal-content h4 {
        margin: 0 0 1rem;
    }
    .form-group {
        margin-bottom: 1rem;
    }
    .form-group label {
        display: block;
        font-size: 0.85rem;
        margin-bottom: 0.3rem;
        color: var(--master-text-secondary);
    }
    .form-group select, .form-group input {
        background: var(--master-input-bg);
        border: 1px solid var(--master-input-border);
        color: var(--master-input-text);
    }
    .form-group select:focus, .form-group input:focus {
        outline: none;
        border-color: var(--master-accent);
    }
    .create-error {
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        background: #fff0f0;
        border: 1px solid #f5c6cb;
        color: #c62828;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
    }
    [data-bs-theme="dark"] .create-error {
        background: #3a1a1a;
        border-color: #5a2a2a;
        color: #f5a0a0;
    }
    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    /* 对话消息中 Markdown 渲染样式 — 仅作用于师父回复 */
    /* 亮色模式 */
    .message.master .message-text h1,
    .message.master .message-text h2,
    .message.master .message-text h3 {
        margin: 0.5rem 0 0.3rem;
        font-weight: 600;
        color: #333333;
    }
    .message.master .message-text h1 { font-size: 1.15rem; }
    .message.master .message-text h2 { font-size: 1.05rem; }
    .message.master .message-text h3 { font-size: 1rem; }
    .message.master .message-text p {
        margin: 0.3rem 0;
        line-height: 1.6;
        color: #333333;
    }
    .message.master .message-text ul,
    .message.master .message-text ol {
        margin: 0.3rem 0;
        padding-left: 1.5rem;
        color: #333333;
    }
    .message.master .message-text li { margin: 0.15rem 0; }
    .message.master .message-text code {
        background: rgba(46,139,175,0.10);
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
        font-size: 0.9em;
        color: #333333;
    }
    .message.master .message-text pre {
        background: #eef3f6;
        padding: 0.75rem;
        border-radius: 6px;
        overflow-x: auto;
        max-width: 100%;
        overflow-x: auto;
        border: 1px solid #d8e2e8;
    }
    .message.master .message-text pre code {
        background: transparent;
        padding: 0;
        color: #333333;
    }
    .message.master .message-text blockquote {
        border-left: 3px solid #2e8baf;
        padding: 0.3rem 0.5rem;
        margin: 0.3rem 0;
        background: #eef3f6;
        color: #555555;
    }
    .message.master .message-text strong { color: #333333; }
    .message.master .message-text a { color: #2e8baf; }
    .message.master .message-text hr { border: none; border-top: 1px solid #d8e2e8; margin: 0.5rem 0; }
    .message.master .message-text table { border-collapse: collapse; width: 100%; max-width: 100%; margin: 0.3rem 0; }
    .message.master .message-text th,
    .message.master .message-text td {
        border: 1px solid #d8e2e8;
        padding: 0.3rem 0.5rem;
        color: #333333;
    }
    .message.master .message-text th {
        background: #eef3f6;
        font-weight: 600;
    }

    /* 暗色模式 */
    [data-bs-theme="dark"] .message.master .message-text h1,
    [data-bs-theme="dark"] .message.master .message-text h2,
    [data-bs-theme="dark"] .message.master .message-text h3 {
        color: rgba(255,255,255,0.88);
    }
    [data-bs-theme="dark"] .message.master .message-text p {
        color: rgba(255,255,255,0.85);
    }
    [data-bs-theme="dark"] .message.master .message-text ul,
    [data-bs-theme="dark"] .message.master .message-text ol {
        color: rgba(255,255,255,0.85);
    }
    [data-bs-theme="dark"] .message.master .message-text code {
        background: rgba(46,139,175,0.18);
        color: rgba(255,255,255,0.85);
    }
    [data-bs-theme="dark"] .message.master .message-text pre {
        background: #1e2a3a;
        border-color: rgba(255,255,255,0.1);
    }
    [data-bs-theme="dark"] .message.master .message-text pre code {
        color: rgba(255,255,255,0.85) !important;
        background: transparent !important;
    }
    [data-bs-theme="dark"] .message.master .message-text blockquote {
        border-left-color: #2e8baf;
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.65);
    }
    [data-bs-theme="dark"] .message.master .message-text strong { color: rgba(255,255,255,0.9); }
    [data-bs-theme="dark"] .message.master .message-text a { color: #5ab0d4; }
    [data-bs-theme="dark"] .message.master .message-text hr { border-top-color: rgba(255,255,255,0.1); }
    [data-bs-theme="dark"] .message.master .message-text th,
    [data-bs-theme="dark"] .message.master .message-text td {
        border-color: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.85);
    }
    [data-bs-theme="dark"] .message.master .message-text th {
        background: rgba(255,255,255,0.08);
    }
    [data-bs-theme="dark"] .message.master .message-text pre code.hljs {
        background: transparent !important;
        color: rgba(255,255,255,0.85) !important;
    }
    .quick-questions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem 1rem;
    }
