@code {
    private List<MasterListItem> masters = new();
    private string selectedMasterId = "";
    private MasterListItem? selectedMaster;
    private List<ChatMsg> chatMessages = new();
    private string inputMessage = "";
    private bool isThinking = false;
    private bool isCreating = false;
    private CancellationTokenSource? _chatCts;

    private bool showCreateModal = false;
    private bool showAiConfigWarning = false;
    private bool showDisclaimer = false;
    private string createIndustry = "";
    private string createGoal = "";
    private string createError = "";

    private enum AiCheckState { Idle, Checking, Valid, Invalid, NotConfigured }
    private AiCheckState aiCheckState = AiCheckState.Idle;

    private static readonly string[] UnsafeKeywords = [
        "真实诊断", "开处方", "开药方", "真实法律建议", "代理诉讼",
        "医疗诊断", "处方药", "手术方案", "法律代理"
    ];
    private const string SafetyWarning = "\n\n⚠️ 以上内容仅供参考，不构成专业医疗/法律意见，请以权威资源为准。";

    private static string SanitizeInput(string input, int maxLength = 200) =>
        string.Concat(input.Take(maxLength)).Replace("\n", " ").Replace("\r", " ").Replace("【", " ").Replace("】", " ").Trim();

    private static string ApplySafetyFilter(string text)
    {
        foreach (var kw in UnsafeKeywords)
            if (text.Contains(kw, StringComparison.OrdinalIgnoreCase))
                return text + SafetyWarning;
        return text;
    }

    private bool CanSend => !isThinking && !string.IsNullOrWhiteSpace(inputMessage) && selectedMaster != null && (aiCheckState == AiCheckState.Valid || aiCheckState == AiCheckState.Idle);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadMastersAsync();
        }
    }

    private async Task LoadMastersAsync()
    {
        try
        {
            masters = await ApiService.GetMastersAsync();
            if (!string.IsNullOrEmpty(selectedMasterId))
            {
                selectedMaster = masters.FirstOrDefault(m => m.MasterId == selectedMasterId);
            }
            StateHasChanged();
        }
        catch { }
    }

    private async Task SelectMaster(MasterListItem m)
    {
        selectedMasterId = m.MasterId;
        selectedMaster = m;
        chatMessages.Clear();
        await LoadChatHistoryAsync(m.MasterId);
        StateHasChanged();
    }

    private async Task LoadChatHistoryAsync(string masterId)
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", $"master_chat_{masterId}");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var history = System.Text.Json.JsonSerializer.Deserialize<List<ChatMsg>>(json);
                if (history != null && history.Count > 0)
                {
                    chatMessages = history;
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    private async Task SaveChatHistoryAsync()
    {
        if (selectedMaster == null) return;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(chatMessages);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"master_chat_{selectedMaster.MasterId}", json);
        }
        catch { }
    }

    private AIStatusSummary? aiStatus;

    private void ShowCreateModal()
    {
        aiStatus = GlobalStateService.GetAIStatus();
        if (aiStatus is not { IsConfigured: true })
        {
            showAiConfigWarning = true;
            return;
        }
        showAiConfigWarning = false;
        showDisclaimer = true;
    }
    private void HideCreateModal() { showCreateModal = false; createError = ""; }

    private void OnDisclaimerConfirmed()
    {
        showDisclaimer = false;
        showCreateModal = true;
        createError = "";
    }

    private void OnDisclaimerCancelled()
    {
        showDisclaimer = false;
    }

    private static bool IsMedicalOrLegalIndustry(string industry)
    {
        if (string.IsNullOrEmpty(industry)) return false;
        var lower = industry.ToLowerInvariant();
        return lower.Contains("医") || lower.Contains("药") || lower.Contains("法") || lower.Contains("律");
    }

    private void GoToAiSettings()
    {
        showAiConfigWarning = false;
        NavigationManager.NavigateTo("settings");
    }

    private void DismissAiWarning()
    {
        showAiConfigWarning = false;
    }

    private async Task CreateMasterAsync()
    {
        if (string.IsNullOrWhiteSpace(createGoal) || string.IsNullOrWhiteSpace(createIndustry))
            return;

        isCreating = true;
        createError = "";
        StateHasChanged();

        try
        {
            var result = await ApiService.CreateMasterAsync(SanitizeInput(createGoal), SanitizeInput(createIndustry));
            if (result.Success)
            {
                showCreateModal = false;
                createIndustry = "";
                createGoal = "";
                createError = "";
                await LoadMastersAsync();

                var newMaster = masters.FirstOrDefault(m => m.MasterId == result.MasterId);
                if (newMaster != null)
                {
                    await SelectMaster(newMaster);
                    chatMessages.Add(new ChatMsg { IsUser = false, Content = result.Message, Time = DateTime.Now });
                    StateHasChanged();
                }
            }
            else
            {
                createError = $"拜师失败：{result.Message ?? "未知错误"}";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            createError = $"拜师失败：{ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputMessage) || selectedMaster == null)
            return;

        chatMessages.Add(new ChatMsg { IsUser = true, Content = inputMessage, Time = DateTime.Now });
        var userMessage = SanitizeInput(inputMessage, 2000);
        inputMessage = "";
        isThinking = true;

        var aiMessage = new ChatMsg { IsUser = false, Content = "", Time = DateTime.Now };
        chatMessages.Add(aiMessage);
        StateHasChanged();

        _chatCts = new CancellationTokenSource();
        try
        {
            var history = chatMessages.Take(chatMessages.Count - 1)
                .Select(m => (m.IsUser, m.Content))
                .ToList();

            await foreach (var evt in ApiService.StreamMasterChatAsync(
                selectedMaster.MasterId, userMessage, selectedMaster.CurrentStage, history, _chatCts.Token))
            {
                if (_chatCts.IsCancellationRequested) break;
                if (evt.Type == "delta" && !string.IsNullOrEmpty(evt.Content))
                {
                    aiMessage.Content += evt.Content;
                    StateHasChanged();
                    await Task.Yield();
                }
            }

            if (_chatCts.IsCancellationRequested)
            {
                aiMessage.Content = string.IsNullOrEmpty(aiMessage.Content) ? "（已停止）" : aiMessage.Content + "\n\n（已停止）";
            }
            else
            {
                aiMessage.Content = ApplySafetyFilter(aiMessage.Content);
            }
        }
        catch (OperationCanceledException)
        {
            aiMessage.Content = string.IsNullOrEmpty(aiMessage.Content) ? "（已停止）" : aiMessage.Content + "\n\n（已停止）";
        }
        catch (Exception ex)
        {
            aiMessage.Content = $"请求失败：{ex.Message}";
        }
        finally
        {
            isThinking = false;
            _chatCts?.Dispose();
            _chatCts = null;
            StateHasChanged();
            await SaveChatHistoryAsync();
        }
    }

    private void StopChat()
    {
        try { _chatCts?.Cancel(); } catch { }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task DeleteMasterAsync(string masterId)
    {
        await ApiService.DeleteMasterAsync(masterId);
        if (selectedMasterId == masterId)
        {
            selectedMasterId = "";
            selectedMaster = null;
            chatMessages.Clear();
        }
        await LoadMastersAsync();
    }

    // 删除师父确认弹窗（拜师慎重，删除同样需要确认）
    private string? pendingDeleteMasterId;
    private string? pendingDeleteMasterName;

    private void AskDeleteMaster(string id, string name)
    {
        pendingDeleteMasterId = id;
        pendingDeleteMasterName = name;
    }

    private void CancelDeleteMaster()
    {
        pendingDeleteMasterId = null;
        pendingDeleteMasterName = null;
    }

    private async Task ConfirmDeleteMaster()
    {
        if (string.IsNullOrEmpty(pendingDeleteMasterId)) return;
        var id = pendingDeleteMasterId;
        pendingDeleteMasterId = null;
        pendingDeleteMasterName = null;
        await DeleteMasterAsync(id);
    }

    private void GoToStage()
    {
        if (selectedMaster != null)
        {
            NavigationManager.NavigateTo($"master-stage?masterId={selectedMaster.MasterId}");
        }
    }

    private void GoToProfile()
    {
        if (selectedMaster != null)
        {
            NavigationManager.NavigateTo($"master-profile?masterId={selectedMaster.MasterId}");
        }
    }

    private List<string> GetQuickQuestions()
    {
        if (selectedMaster == null) return new();
        return selectedMaster.CurrentStage switch
        {
            "入道" => new() { "我应该如何开始学习？", "请帮我制定一个学习计划", "这个考试的重点是什么？" },
            "筑基" => new() { "如何打好基础？", "有哪些核心知识点必须掌握？", "请布置一些基础练习题" },
            "精进" => new() { "如何突破薄弱环节？", "请详细讲解这个知识点", "有哪些常见的考试陷阱？" },
            "磨砺" => new() { "请出一套模拟题", "考试时有哪些答题技巧？", "如何提高答题速度？" },
            "出师" => new() { "如何做最后的冲刺？", "有哪些报考注意事项？", "请给我一些考前建议" },
            _ => new() { "请帮我开始学习", "这个考试需要准备什么？", "请给我一些学习建议" }
        };
    }

    private void SetQuickQuestion(string question)
    {
        inputMessage = question;
    }

    private async Task RunEvictAsync()
    {
        if (selectedMaster == null) return;
        try
        {
            if (!await JSRuntime.InvokeAsync<bool>("confirm", "确定要清理旧数据吗？这将压缩7天前的对话并淘汰30天前的摘要。"))
                return;

            var result = await ApiService.EvictMasterAsync(selectedMaster.MasterId);
            if (result.Success)
            {
                chatMessages.Add(new ChatMsg { IsUser = false, Content = $"✅ 数据清理完成：压缩 {result.CompressedStages} 个阶段，淘汰 {result.EvictedStages} 个阶段", Time = DateTime.Now });
                StateHasChanged();
                await SaveChatHistoryAsync();
            }
            else
            {
                chatMessages.Add(new ChatMsg { IsUser = false, Content = $"❌ {result.Message}", Time = DateTime.Now });
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            chatMessages.Add(new ChatMsg { IsUser = false, Content = $"清理失败：{ex.Message}", Time = DateTime.Now });
            StateHasChanged();
        }
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private string RenderMarkdown(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();
        return Markdown.ToHtml(content, pipeline);
    }

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "...";

    private static string GetStageTip(string stage) => stage switch
    {
        "入道" => "引导阶段：师父会通过提问了解你的基础和目标，帮助你明确学习方向。",
        "筑基" => "基础阶段：师父会严格要求你掌握基础知识，每日布置功课并检查完成情况。",
        "精进" => "精进阶段：师父会对细节有近乎偏执的追求，任何微小错误都要指出并纠正。",
        "磨砺" => "磨砺阶段：师父会模拟真实考试环境，出题考察你的综合能力。",
        "出师" => "出师阶段：师父会分享实战经验和考试技巧，帮助你做好最后的冲刺准备。",
        _ => ""
    };

    public class ChatMsg
    {
        public bool IsUser { get; set; }
        public string Content { get; set; } = "";
        public DateTime Time { get; set; }
    }

    public void Dispose()
    {
        try { _chatCts?.Cancel(); _chatCts?.Dispose(); } catch { }
    }
}
