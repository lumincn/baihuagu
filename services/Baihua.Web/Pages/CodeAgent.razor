@page "/code-agent"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using Baihua.Web.Services
@using Microsoft.JSInterop
@inject IApiService ApiService
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@implements IDisposable

<PageTitle>@L["CodeAgent_PageTitle"]</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-code-square"></i> @L["CodeAgent_Title"]</h2>
            <p class="text-muted">@L["CodeAgent_Subtitle"]</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-robot"></i> @L["CodeAgent_InputTitle"]
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">@L["CodeAgent_Language"]</label>
                            <select class="form-select" @bind="_language">
                                <option value="">@L["CodeAgent_LanguageAuto"]</option>
                                <option value="C# console (.NET)">C# Console (.NET)</option>
                                <option value="Python">Python</option>
                                <option value="C# ASP.NET Core Web API">C# ASP.NET Core Web API</option>
                                <option value="Blazor (C#)">Blazor (C#)</option>
                                <option value="SQL">SQL</option>
                                <option value="Shell / PowerShell">Shell / PowerShell</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["CodeAgent_Provider"]</label>
                            <select class="form-select" @bind="_providerId" @bind:after="OnProviderChanged">
                                @foreach (var p in _providers)
                                {
                                    <option value="@p.Id">@p.Name@(IsLocalProvider(p) ? "（本地）" : "（云端）")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["CodeAgent_Model"]</label>
                            <select class="form-select" @bind="_model">
                                <option value="">@L["CodeAgent_ModelAuto"]</option>
                                @foreach (var p in _providers.Where(p => p.Id == _providerId))
                                {
                                    @foreach (var m in p.Models)
                                    {
                                        <option value="@m.Name">@m.Name@(m.IsPaid ? "（云端）" : "")</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4">
                            <label class="form-label">@L["CodeAgent_ToolMode"]</label>
                            <select class="form-select" @bind="_toolMode">
                                <option value="All">@L["CodeAgent_ToolMode_All"]</option>
                                <option value="Search">@L["CodeAgent_ToolMode_Search"]</option>
                                <option value="CodeGraph">@L["CodeAgent_ToolMode_CodeGraph"]</option>
                                <option value="None">@L["CodeAgent_ToolMode_None"]</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="pipelineMode" @bind="_pipeline">
                                <label class="form-check-label" for="pipelineMode">@L["CodeAgent_PipelineMode"]</label>
                            </div>
                            @if (_pipeline)
                            {
                                <div class="form-check mb-2 ms-3">
                                    <input class="form-check-input" type="checkbox" id="planPro" @bind="_planPro">
                                    <label class="form-check-label" for="planPro">@L["CodeAgent_PlanPro"]</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">@L["CodeAgent_Prompt"]</label>
                        <textarea class="form-control" rows="4" @bind="_prompt"
                                  placeholder="@L["CodeAgent_PromptPlaceholder"]"></textarea>
                    </div>

                    <div class="mt-3 d-flex align-items-center gap-2">
                        <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@(isRunning || string.IsNullOrWhiteSpace(_prompt))">
                            @(isRunning ? L["CodeAgent_Running"] : L["CodeAgent_Generate"])
                        </button>
                        @if (isRunning)
                        {
                            <button class="btn btn-outline-danger" @onclick="StopAsync">@L["CodeAgent_Stop"]</button>
                        }
                        @if (!string.IsNullOrEmpty(_output))
                        {
                            <button class="btn btn-outline-secondary" @onclick="CopyOutputAsync">@L["CodeAgent_Copy"]</button>
                            <button class="btn btn-outline-secondary" @onclick="DownloadOutputAsync">@L["CodeAgent_Download"]</button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@_error</div>
                    }
                    @if (!string.IsNullOrEmpty(_fileName))
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <i class="bi bi-file-earmark-code"></i> @L["CodeAgent_File"]: <code>@_fileName</code>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_pipeline)
    {
        <div class="card mt-3">
            <div class="card-header bg-info text-white"><i class="bi bi-diagram-3"></i> @L["CodeAgent_PipelineTitle"]</div>
            <div class="card-body">
                <h6>@L["CodeAgent_StageResearch"]</h6>
                <pre class="code-output mb-3"><code>@_research</code></pre>
                <h6>@L["CodeAgent_StageCode"]</h6>
                <pre class="code-output mb-3"><code>@_codeOut</code></pre>
                <h6>@L["CodeAgent_StageReview"]</h6>
                <pre class="code-output mb-0"><code>@_review</code></pre>
            </div>
        </div>
    }
    @if (!_pipeline && (!string.IsNullOrEmpty(_output) || isRunning))
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-terminal"></i> @L["CodeAgent_OutputTitle"]</span>
                        @if (isRunning)
                        {
                            <span class="badge bg-info"><span class="spinner-border spinner-border-sm me-1" style="width:0.7rem;height:0.7rem;"></span>@L["CodeAgent_Streaming"]</span>
                        }
                    </div>
                    <div class="card-body p-0">
                        <pre class="code-output mb-0" id="code-output"><code>@_output</code></pre>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_history.Count > 0)
    {
        <div class="card mt-3">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history"></i> @L["CodeAgent_HistoryTitle"]</span>
                @if (_historyLoading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" style="max-height: 40vh; overflow-y: auto;">
                    @foreach (var item in _history)
                    {
                        <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-start"
                            @onclick="() => LoadHistoryItem(item.Id)" style="cursor:pointer">
                            <div class="flex-grow-1 me-2" style="min-width:0">
                                <div class="text-truncate">@item.Prompt</div>
                                <small class="text-muted">
                                    @item.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                                    @if (item.IsPipeline)
                                    {
                                        <span class="badge bg-info ms-1">@L["CodeAgent_PipelineMode"]</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Model))
                                    {
                                        <span class="badge bg-secondary ms-1">@item.Model</span>
                                    }
                                    @if (item.OutputLength > 0)
                                    {
                                        <span class="badge bg-light text-dark ms-1">@item.OutputLength @L["CodeAgent_HistoryChars"]</span>
                                    }
                                </small>
                            </div>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteHistoryItem(item.Id)" @onclick:stopPropagation>
                                <i class="bi bi-trash"></i>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

<style>
    .code-output {
        max-height: 60vh;
        overflow: auto;
        background: #1e1e2e;
        color: #e6e6e6;
        padding: 1rem;
        font-size: 0.85rem;
        line-height: 1.5;
        border-radius: 0 0 0.375rem 0.375rem;
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>

@code {
    private string _prompt = "";
    private string _language = "";
    private string _providerId = "";
    private string _model = "";
    private string _toolMode = "All";
    private bool _pipeline;
    private bool _planPro = true;
    private string _research = "";
    private string _codeOut = "";
    private string _review = "";
    private string _currentStage = "";
    private string _output = "";
    private string? _error;
    private string? _fileName;
    private bool isRunning;
    private CancellationTokenSource? _cts;
    private List<CodeAgentProviderInfo> _providers = new();
    private List<CodeAgentSessionSummaryDto> _history = new();
    private bool _historyLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var providers = await ApiService.GetCodeAgentProvidersAsync();
            _providers = providers.ToList();
            // 默认选本地编程模型（ID 含 coder），否则主提供方
            var coder = _providers.FirstOrDefault(p => p.Id?.Contains("coder", StringComparison.OrdinalIgnoreCase) == true);
            var selected = coder ?? _providers.FirstOrDefault(p => p.IsMain) ?? _providers.FirstOrDefault();
            if (selected != null)
            {
                _providerId = selected.Id;
                _model = selected.Model;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        await LoadHistoryAsync();
    }

    /// <summary>加载历史列表</summary>
    private async Task LoadHistoryAsync()
    {
        _historyLoading = true;
        try
        {
            _history = await ApiService.GetCodeAgentHistoryAsync(20);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _historyLoading = false;
        }
    }

    /// <summary>保存当前生成结果到历史</summary>
    private async Task SaveSessionAsync()
    {
        try
        {
            var req = new CodeAgentSessionSaveRequest
            {
                Prompt = _prompt,
                Language = string.IsNullOrWhiteSpace(_language) ? null : _language,
                ProviderId = string.IsNullOrWhiteSpace(_providerId) ? null : _providerId,
                Model = string.IsNullOrWhiteSpace(_model) ? null : _model,
                ToolMode = _toolMode,
                IsPipeline = _pipeline,
                PlanPro = _planPro,
                Output = _pipeline ? null : _output,
                Research = _pipeline ? _research : null,
                Code = _pipeline ? _codeOut : null,
                Review = _pipeline ? _review : null,
                FileName = _fileName
            };
            await ApiService.SaveCodeAgentSessionAsync(req);
            await LoadHistoryAsync();
        }
        catch (Exception)
        {
            // 保存失败不打扰用户（历史是附加功能）
        }
    }

    /// <summary>加载一条历史到页面（回填输入区 + 显示输出）</summary>
    private async Task LoadHistoryItem(int id)
    {
        try
        {
            var item = await ApiService.GetCodeAgentHistoryItemAsync(id);
            if (item is null) return;
            _prompt = item.Prompt;
            _language = item.Language ?? "";
            _providerId = item.ProviderId ?? "";
            _model = item.Model ?? "";
            _toolMode = string.IsNullOrEmpty(item.ToolMode) ? "All" : item.ToolMode;
            _pipeline = item.IsPipeline;
            _planPro = item.PlanPro;
            _output = item.Output ?? "";
            _research = item.Research ?? "";
            _codeOut = item.Code ?? "";
            _review = item.Review ?? "";
            _fileName = item.FileName;
            _error = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>删除一条历史</summary>
    private async Task DeleteHistoryItem(int id)
    {
        try
        {
            await ApiService.DeleteCodeAgentSessionAsync(id);
            _history.RemoveAll(h => h.Id == id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>切换提供方时重置模型为默认值，避免选中残留上一提供方的模型（如云端模型）</summary>
    private void OnProviderChanged()
    {
        var p = _providers.FirstOrDefault(x => x.Id == _providerId);
        _model = p?.Model ?? "";
    }

    /// <summary>本地提供方识别（OpenVINO/Ollama/LM Studio/llama.cpp/coder）——用于提供方下拉标注，避免误用云端</summary>
    private static bool IsLocalProvider(CodeAgentProviderInfo p)
    {
        var s = (p.Id + " " + p.Name).ToLowerInvariant();
        return s.Contains("openvino") || s.Contains("ollama") || s.Contains("lmstudio")
            || s.Contains("llamacpp") || s.Contains("local") || s.Contains("coder");
    }

    private async Task GenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt) || isRunning) return;
        _error = null;
        _fileName = null;
        _output = "";
        isRunning = true;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var request = new CodeAgentRequest
            {
                Prompt = _prompt,
                Language = string.IsNullOrWhiteSpace(_language) ? null : _language,
                ProviderId = string.IsNullOrWhiteSpace(_providerId) ? null : _providerId,
                Model = string.IsNullOrWhiteSpace(_model) ? null : _model,
                ToolMode = Enum.TryParse<CodeAgentToolMode>(_toolMode, out var tm) ? tm : CodeAgentToolMode.All,
                Stream = true
            };

            if (_pipeline)
            {
                _research = "";
                _codeOut = "";
                _review = "";
                var pipeRequest = new CodeAgentPipelineRequest
                {
                    Prompt = request.Prompt,
                    Language = request.Language,
                    ProviderId = request.ProviderId,
                    Model = request.Model,
                    ToolMode = request.ToolMode,
                    PlanModel = _planPro && request.ProviderId == "deepseek" ? "deepseek-v4-pro" : null,
                    Stream = true
                };

                await foreach (var item in ApiService.StreamCodeAgentPipelineAsync(pipeRequest, _cts.Token))
                {
                    switch (item.Type)
                    {
                        case "stage":
                            _currentStage = item.Data;
                            break;
                        case "delta":
                        case "tool":
                            AppendStageText(item.Data);
                            break;
                    }
                    StateHasChanged();
                    await Task.Yield();
                }

                var pipeFileMatch = System.Text.RegularExpressions.Regex.Match(_codeOut,
                    @"(?i)(?:File|文件名)\s*[:：]\s*([^\r\n`]+)");
                if (pipeFileMatch.Success)
                {
                    var candidate = pipeFileMatch.Groups[1].Value.Trim().Trim('"', '\'', '*');
                    if (!string.IsNullOrWhiteSpace(candidate))
                        _fileName = candidate;
                }
                await SaveSessionAsync();
            }
            else
            {
                await foreach (var delta in ApiService.StreamCodeAgentAsync(request, _cts.Token))
                {
                    _output += delta;
                    StateHasChanged();
                    await Task.Yield();
                }

                // 从输出中识别文件名（File: xxx）
                var fileMatch = System.Text.RegularExpressions.Regex.Match(_output,
                    @"(?i)(?:File|文件名)\s*[:：]\s*([^\r\n`]+)");
                if (fileMatch.Success)
                {
                    var candidate = fileMatch.Groups[1].Value.Trim().Trim('"', '\'', '*');
                    if (!string.IsNullOrWhiteSpace(candidate))
                        _fileName = candidate;
                }
                await SaveSessionAsync();
            }
        }
        catch (OperationCanceledException)
        {
            _output += "\n\n--- " + L["Messages_Stopped"] + " ---";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            isRunning = false;
            StateHasChanged();
        }
    }

    /// <summary>把流水线文本追加到当前阶段。</summary>
    private void AppendStageText(string text)
    {
        switch (_currentStage)
        {
            case "research":
                _research += text;
                break;
            case "code":
                _codeOut += text;
                break;
            case "review":
                _review += text;
                break;
            default:
                _output += text;
                break;
        }
    }

    private void StopAsync()
    {
        _cts?.Cancel();
    }

    private async Task CopyOutputAsync()
    {
        if (string.IsNullOrEmpty(_output)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _output);
    }

    private async Task DownloadOutputAsync()
    {
        if (string.IsNullOrEmpty(_output)) return;
        var fileName = string.IsNullOrEmpty(_fileName)
            ? $"code-{DateTime.Now:yyyyMMdd-HHmmss}.txt"
            : _fileName;
        var bytes = System.Text.Encoding.UTF8.GetBytes(_output);
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, $"data:text/plain;base64,{base64}");
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
