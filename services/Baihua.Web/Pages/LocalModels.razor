</style>

    @if (_activeTab == "openvino")
    {
    <!-- OpenVINO 视觉模型（Intel Arc GPU） -->
    <div class="section-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showOpenVino)">
        <h2>@(_showOpenVino ? "▼" : "▶") 🧠 OpenVINO 视觉模型（Intel Arc GPU）</h2>
    </div>
    @if (_showOpenVino)
    {
        <!-- 区域职责帮助 -->
        <div class="alert alert-info small" style="margin-top:0.5rem;">
            <b>📖 区域说明：</b>
            <ul class="mb-0 mt-1" style="padding-left:1.2rem;">
                <li><b>⬇️ 下载任务</b>：从 ModelScope/HuggingFace 拉取模型文件到本地磁盘（后台任务，可取消）。</li>
                <li><b>🧠 OpenVINO 视觉模型（已下载+可下载合并表）</b>：一张表看全部模型。未下载→「下载」；已下载→「▶ 运行」（启动独立 LLM 服务进程，端口 8000-8030，供对话/编程）／「停止」／「删除」。</li>
                <li><b>🧿 已下载模型（通用表）</b>：跨工具汇总的已下载模型。<b>加载</b>＝把 Qwen2.5-VL 视觉模型预热进 vision_server（8801 端口）显存，首次识别图片免冷加载；<b>详情</b>＝查看配置。</li>
                <li><b>🤖 OpenVINO LLM 服务</b>：宿主机托管的 openvino_llm_server.py 常驻实例（一模型一端口），显示 PID/健康状态，可手动启停。</li>
            </ul>
        </div>
        <!-- 下载任务 -->
        <div class="mt-3 mb-2">
            <div class="d-flex justify-content-between align-items-center">
                <h4>⬇️ 下载任务</h4>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshOpenVinoAsync">刷新</button>
            </div>
            @if (openVinoDownloads.Count == 0)
            {
                <div class="text-muted small">暂无下载任务</div>
            }
            else
            {
                @foreach (var t in openVinoDownloads)
                {
                    var active = t.Status is "running" or "pending";
                    <div class="mb-2 p-2 border rounded">
                        <div class="d-flex justify-content-between small">
                            <span><b>@t.ModelName</b>
                                <span class="badge @(t.Status == "completed" ? "bg-success" : t.Status == "failed" ? "bg-danger" : t.Status == "cancelled" ? "bg-secondary" : "bg-primary")">@t.Status</span>
                            </span>
                            <span>
                                @if (active)
                                {
                                    <span class="text-muted">@t.ProgressPercent%@(t.SpeedMBps > 0 ? $" ({t.SpeedMBps:F1}MB/s)" : "")</span>
                                    <button class="btn btn-sm btn-outline-secondary ms-2" @onclick='() => CancelDownloadAsync(t.TaskId)'>取消</button>
                                }
                                else if (t.CompletedAt.HasValue)
                                {
                                    <span class="text-muted">@t.CompletedAt.Value.ToString("HH:mm:ss")</span>
                                }
                            </span>
                        </div>
                        @if (t.TotalBytes > 0)
                        {
                            <div class="progress mt-1" style="height:6px">
                                <div class="progress-bar @(t.Status == "failed" ? "bg-danger" : "") " style="width:@(t.ProgressPercent)%"></div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(t.CurrentFile))
                        {
                            <div class="small text-muted mt-1">@t.CurrentFile</div>
                        }
                        @if (!string.IsNullOrEmpty(t.ErrorMessage))
                        {
                            <div class="text-danger small mt-1">@t.ErrorMessage</div>
                        }
                    </div>
                }
            }
        </div>

        <!-- 模型目录（已下载 + 可下载合并） -->
        <div class="mt-3 mb-2">
            <h4>🧠 OpenVINO 视觉模型 <span class="text-muted small fw-normal">（▶ 运行＝启动 LLM 服务供对话/编程，端口 8000-8030；下载自 ModelScope/HF 镜像）</span></h4>
            @if (openVinoCatalog.Count == 0)
            {
                <div class="text-muted small">目录为空</div>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>模型</th><th>参数</th><th>大小</th><th>用途</th><th>状态</th><th class="text-end">操作</th></tr></thead>
                    <tbody>
                        @foreach (var c in openVinoCatalog)
                        {
                            <tr class="@(c.Installed ? "table-active" : "")">
                                <td>@c.Name @(c.IsVision ? "👁" : "")</td>
                                <td>@c.ParameterSize @c.Quantization</td>
                                <td class="small text-muted">
                                    @if (c.Installed && c.SizeBytes > 0)
                                    {
                                        @FormatSize(c.SizeBytes)
                                    }
                                    else
                                    {
                                        @(c.SizeGiB.ToString("F1") + "GB")
                                    }
                                </td>
                                <td class="small text-muted">@c.Description</td>
                                <td>
                                    @if (c.Installed && c.IsRunning)
                                    {
                                        <span class="badge bg-success">运行中 :@c.Port</span>
                                    }
                                    else if (c.Installed)
                                    {
                                        <span class="badge bg-secondary">已下载</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted">未下载</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (c.Installed)
                                    {
                                        @if (c.IsRunning)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => StopModelAsync(c.Port!.Value)'>停止</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick='() => RunModelAsync(c.Path!)'>运行</button>
                                        }
                                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => AskDeleteOpenVino(c)'>删除</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick='() => StartDownloadAsync(c.Id)'>下载</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        @if (!string.IsNullOrEmpty(openVinoMessage))
        {
            <div class="text-warning small mt-2">@openVinoMessage</div>
        }
    }
    <!-- OpenVINO Downloaded Models -->
    <div class="downloaded-section">
        <div class="section-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showDownloadedModels)">
            <h2>@(_showDownloadedModels ? "▼" : "▶") 🧿 @L["LocalModels_DownloadedOpenVino"] <span class="text-muted small fw-normal">（加载＝预热视觉模型到显存，图片识别免冷加载）</span></h2>
            @if (_showDownloadedModels)
            {
                <button class="btn btn-secondary btn-sm" @onclick="RefreshDownloadedModels" disabled="@isLoadingDownloaded">
                    @(isLoadingDownloaded ? "🔄 " + L["LocalModels_Refreshing"] : "🔄 " + L["LocalModels_RefreshModels"])
                </button>
            }
        </div>
        @if (_showDownloadedModels)
        {
        @if (downloadedModels.Count == 0)
        {
            <div class="alert alert-info">@L["LocalModels_NoDownloadedModels"]</div>
        }
        else
        {
            <div class="downloaded-models-table">
                <div class="downloaded-table-header">
                    <span class="col-dl-name">@L["LocalModels_DlName"]</span>
                    <span class="col-dl-tool">@L["LocalModels_DlTool"]</span>
                    <span class="col-dl-size">@L["LocalModels_DlSize"]</span>
                    <span class="col-dl-time">@L["LocalModels_DlTime"]</span>
                    <span class="col-dl-status">@L["LocalModels_DlStatus"]</span>
                    <span class="col-dl-actions">@L["LocalModels_DlActions"]</span>
                </div>
                @foreach (var dm in downloadedModels.Where(m => m.ToolId == "openvino"))
                {
                    <div class="downloaded-table-row">
                        <span class="col-dl-name">
                            <span class="model-name-text">@dm.Name</span>
                            @if (!string.IsNullOrEmpty(dm.Digest))
                            {
                                <span class="digest-text" title="@dm.Digest">@dm.Digest[..Math.Min(12, dm.Digest.Length)]...</span>
                            }
                        </span>
                        <span class="col-dl-tool">
                            <span class="tool-badge @GetToolBadgeClass(dm.ToolId)">@dm.ToolName</span>
                        </span>
                        <span class="col-dl-size">@dm.SizeGiB GB</span>
                        <span class="col-dl-time">
                            @(dm.ModifiedAt.HasValue ? dm.ModifiedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")
                        </span>
                        <span class="col-dl-status">
                            @if (dm.IsRunning)
                            {
                                <span class="badge badge-info">▶ @L["LocalModels_RunningBadge"]</span>
                            }
                            else
                            {
                                <span class="badge badge-light">⏹ @L["LocalModels_StoppedBadge"]</span>
                            }
                        </span>
                        <span class="col-dl-actions">
                            <button class="btn btn-primary btn-sm" @onclick='() => LoadDownloadedModel(dm)' disabled="@isLoadingModel">
                                @L["LocalModels_LoadBtn"]
                            </button>
                            <button class="btn btn-secondary btn-sm" @onclick='() => ShowModelDetails(dm)' disabled="@isLoadingDetails">
