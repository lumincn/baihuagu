    private static string FormatSize(long bytes)
    {
        if (bytes >= 1L << 30) return $"{bytes / 1024d / 1024d / 1024d:F2}GB";
        if (bytes >= 1L << 20) return $"{bytes / 1024d / 1024d:F1}MB";
        return $"{bytes / 1024d:F0}KB";
    }

    private async Task LoadRecommendationsAsync(bool forceRefresh = false)
    {
        recommendedModels = await ApiService.GetRecommendedModelsAsync(
            string.IsNullOrEmpty(currentScenario) ? null : currentScenario, forceRefresh);
        try
        {
            var tierResponse = await ApiService.GetBenchmarkVramTiersAsync(null);
            availableVram = tierResponse.AvailableVramGiB;
            recommendedTierVramGb = tierResponse.RecommendedTierVramGb;
        }
        catch { }
    }

    private async Task RefreshHardware()
    {
        isLoading = true;
        try
        {
            hardwareInfo = await ApiService.GetHardwareInfoAsync(forceRefresh: true);
            localTools = await ApiService.GetLocalToolsAsync(forceRefresh: true);
            await LoadRecommendationsAsync(forceRefresh: true);
            await RefreshRunningModels();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "刷新硬件信息失败");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
