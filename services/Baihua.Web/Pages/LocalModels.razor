</style>

    @if (_activeTab == "openvino")
    {
        @if (_openVinoAvailable == false)
        {
            <div class="alert alert-warning" role="alert">⚠️ @L["LocalModels_OpenVinoNotSupported"]</div>
        }
        else
        {
            <OpenVinoTab ModelsChanged="RefreshRunningModels" />
        }
    }


    <ConfirmDialog Message="@string.Format(L["LocalModels_ConfirmUnload"], unloadTarget?.DisplayName ?? "")"
                   Visible="@(unloadTarget != null)"
                   OnConfirm="ConfirmUnloadModel"
                   OnCancel="CancelUnloadModel" />
@code {
    private bool isLoading = true;
    private string loadingStatus = "";
    private bool isRefreshingLibrary = false;
    private HardwareInfoDto? hardwareInfo;
    private List<RecommendedModelDto> recommendedModels = new();
    private static readonly int[] VramTierValues = new[] { 4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 256, 512, 1024 };
    private double? availableVram;
    private int? recommendedTierVramGb;
    private List<LocalToolInfoDto> localTools = new();
    private List<DeployTaskStatusDto> activeTasks = new();

    private string currentScenario = "";
    private string currentCompany = "";
    private System.Timers.Timer? _statusTimer;


    private string _activeTab = "overview";
    private bool? _openVinoAvailable; // null=未知/加载中（默认不隐藏 OpenVINO）

    // 区域折叠状态（默认只展开最常用的：模型推荐）
    private bool _showHardware = false;
    private bool _showRunningModels = false;
    private bool _showLocalTools = false;
    private bool _showRecommendations = true;

    private void ToggleSection(ref bool flag) => flag = !flag;

    private List<(string Value, string Label)> scenarioTags => new()
    {
        ("", L["LocalModels_ScenarioAll"]),
        ("chat", L["LocalModels_ScenarioChat"]),
        ("chinese", L["LocalModels_ScenarioChinese"]),
        ("tcm", L["LocalModels_ScenarioTcm"]),
        ("code", L["LocalModels_ScenarioCode"]),
        ("reasoning", L["LocalModels_ScenarioReasoning"]),
        ("lightweight", L["LocalModels_ScenarioLightweight"]),
    };

    private List<(string Value, string Label)> companyTags => new()
    {
        ("", L["LocalModels_CompanyAll"]),
        ("阿里云", L["LocalModels_CompanyAliyun"]),
        ("Meta", "👤 Meta"),
        ("Google", "🔍 Google"),
        ("Microsoft", "🪟 Microsoft"),
        ("DeepSeek", "🐋 DeepSeek"),
    };

    protected override void OnInitialized()
    {
        // 立即渲染骨架屏，数据后台加载
        isLoading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 后台并行加载所有数据
        _ = Task.Run(async () =>
        {
            try
            {
                await LoadAllDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "后台加载失败");
            }
            finally
            {
                await InvokeAsync(() =>
                {
                    isLoading = false;
                    StateHasChanged();
                });
            }
        });

        StartStatusPolling();

    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            // 第一步：硬件 + 本地工具（快），完成后即可先渲染概览，不必等慢的提供方扫描
            SetLoadingStatus(L["LocalModels_LoadingHardware"]);
            var hwTask = ApiService.GetHardwareInfoAsync();
            var toolsTask = ApiService.GetLocalToolsAsync();
            var capTask = SafeLoadAsync(async () =>
            {
                try
                {
                    var cap = await CapabilityService.GetCapabilityAsync();
                    _openVinoAvailable = cap.OpenVinoAvailable;
                }
                catch { _openVinoAvailable = true; }
            });
            await Task.WhenAll(hwTask, toolsTask, capTask);

            hardwareInfo = hwTask.Result;
            localTools = toolsTask.Result;
            await InvokeAsync(() =>
            {
                isLoading = false;
                StateHasChanged();
            });

            // 第二步：其余数据独立加载、各自容错（OpenVINO 区由子组件懒加载，不再拖慢整体）
            SetLoadingStatus(L["LocalModels_LoadingScanTools"]);
            var tasks = new List<Task>
            {
                SafeLoadAsync(() => LoadRecommendationsAsync()),
                SafeLoadAsync(RefreshRunningModels),

            };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载数据失败");
        }
    }

    private void SetLoadingStatus(string msg)
    {
        loadingStatus = msg;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SafeLoadAsync(Func<Task> fn)
    {
        try
        {
            await fn();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "分块加载失败");
        }
    }

    private async Task LoadRecommendationsAsync(bool forceRefresh = false)
    {
        recommendedModels = await ApiService.GetRecommendedModelsAsync(
            string.IsNullOrEmpty(currentScenario) ? null : currentScenario, forceRefresh);
        try
        {
            var tierResponse = await ApiService.GetBenchmarkVramTiersAsync(null);
            availableVram = tierResponse.AvailableVramGiB;
            recommendedTierVramGb = tierResponse.RecommendedTierVramGb;
        }
        catch { }
    }

    private async Task RefreshHardware()
    {
        isLoading = true;
        try
        {
            hardwareInfo = await ApiService.GetHardwareInfoAsync(forceRefresh: true);
            localTools = await ApiService.GetLocalToolsAsync(forceRefresh: true);
            await LoadRecommendationsAsync(forceRefresh: true);
            await RefreshRunningModels();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "刷新硬件信息失败");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectScenario(string scenario)
    {
        currentScenario = scenario;
        await LoadRecommendationsAsync();
    }

    private void SelectCompany(string company)
    {
        currentCompany = company;
        StateHasChanged();
    }

    private List<RecommendedModelDto> FilteredRecommendedModels =>
        string.IsNullOrEmpty(currentCompany)
            ? recommendedModels
            : recommendedModels.Where(m => m.Company == currentCompany).ToList();

    private Dictionary<int, List<RecommendedModelDto>> FilteredModelsByTier =>
        FilteredRecommendedModels
            .GroupBy(m => GetVramTierForModel(m))
            .Where(g => g.Key > 0)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(m => m.MatchScore).ToList());

    private static int GetVramTierForModel(RecommendedModelDto model)
    {
        if (!model.MinVramGiB.HasValue) return 4;
        var vram = model.MinVramGiB.Value;
        foreach (var tier in VramTierValues)
        {
            if (vram <= tier) return tier;
        }
        return VramTierValues.Last();
    }

    private RenderFragment RenderModelCard(RecommendedModelDto model) => __builder =>
    {
        <div class="model-card">
            <div class="model-header">
                <span class="model-name">@model.Name</span>
                <span class="model-size">@model.SizeGiB GB</span>
            </div>
            <div class="model-desc">@model.Description</div>
            <div class="model-meta">
                <span class="badge badge-secondary">@model.ParameterSize</span>
                <span class="badge badge-info">@model.Quantization</span>
                @if (model.Modality != "text")
                {
                    <span class="badge modality-badge" title="@L["LocalModels_ModalityHint"]">@GetModalityLabel(model.Modality)</span>
                }
                @foreach (var tag in model.Tags)
                {
                    <span class="badge badge-light">@tag</span>
                }
                <span class="badge" style="background:#e8eef2;color:#4a5860;">@model.Company</span>
            </div>
            <div class="model-requirements">
                <span>@(model.MinVramGiB.HasValue ? string.Format(L["LocalModels_VramLabel"], model.MinVramGiB.Value.ToString("F0")) : L["LocalModels_VramNone"])</span>
                <span>@string.Format(L["LocalModels_RamLabel"], model.MinRamGiB.ToString("F0"))</span>
            </div>
            <div class="model-suitability @(GetSuitabilityClass(model.Suitability))">
                @model.Suitability
                @if (model.MatchScore >= 90)
                {
                    <span> ⭐ @L["LocalModels_RecommendedBadge"]</span>
                }
            </div>
            @if (model.EstimatedTokensPerSecond.HasValue)
            {
                <div class="model-performance">
                    <span class="speed-badge @(GetSpeedClass(model.EstimatedTokensPerSecond.Value))"
                          title="@L["LocalModels_SpeedEstimateHint"]">
                        @GetSpeedLabel(model.EstimatedTokensPerSecond.Value)
                    </span>
                </div>
            }
        </div>
    };

    private async Task RefreshLibrary()
    {
        isRefreshingLibrary = true;
        try
        {
            var success = await ApiService.RefreshLibraryAsync();
            if (success)
            {
                await LoadRecommendationsAsync(forceRefresh: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "刷新模型库失败");
        }
        finally
        {
            isRefreshingLibrary = false;
        }
    }
    private async Task<bool> RefreshTaskStatus(string taskId)
    {
        var status = await ApiService.GetDeployTaskStatusAsync(taskId);
        if (status == null) return true;

        var existing = activeTasks.FirstOrDefault(t => t.TaskId == taskId);
        if (existing != null)
        {
            var idx = activeTasks.IndexOf(existing);
            activeTasks[idx] = status;
        }
        else
        {
            activeTasks.Add(status);
        }

        await InvokeAsync(StateHasChanged);
        return status.Status is "completed" or "failed";
    }

    private async Task CancelDeploy(string taskId)
    {
        var success = await ApiService.CancelDeployTaskAsync(taskId);
        if (success)
        {
            activeTasks.RemoveAll(t => t.TaskId == taskId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartStatusPolling()
    {
        _statusTimer = new System.Timers.Timer(5000);
        _statusTimer.Elapsed += async (_, _) =>
        {
            if (activeTasks.Any(t => t.Status == "running"))
            {
                foreach (var task in activeTasks.Where(t => t.Status == "running").ToList())
                {
                    await RefreshTaskStatus(task.TaskId);
                }
            }
        };
        _statusTimer.AutoReset = true;
        _statusTimer.Start();
    }

    private static string? GetDiskGiB(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0) return null;
        return (bytes.Value / (1024.0 * 1024 * 1024)).ToString("F1");
    }

    private static string GetToolBadgeClass(string toolId)
    {
        return toolId switch
        {
            "openvino" => "tool-openvino",
            _ => ""
        };
    }

    private string GetModalityLabel(string modality) => modality.ToLowerInvariant() switch
    {
        "vision" => $"🖼️ {L["LocalModels_ModalityVision"]}",
        "multimodal" => $"🖼️ {L["LocalModels_ModalityMultimodal"]}",
        "audio" => $"🔊 {L["LocalModels_ModalityAudio"]}",
        _ => $"📄 {L["LocalModels_ModalityText"]}"
    };

    private static string GetSuitabilityClass(string suitability)
    {
        if (suitability.Contains("加速") || suitability.Contains("推荐") || suitability.Contains("可直接"))
            return "suitability-good";
        if (suitability.Contains("混合") || suitability.Contains("较慢"))
            return "suitability-ok";
        return "suitability-slow";
    }

    private static string GetSpeedClass(double tps)
    {
        return tps switch
        {
            >= 30 => "speed-fast",
            >= 10 => "speed-medium",
            >= 3 => "speed-slow",
            _ => "speed-very-slow"
        };
    }

    private string GetSpeedLabel(double tps)
    {
        return tps switch
        {
            >= 30 => string.Format(L["LocalModels_SpeedVeryFast"], tps),
            >= 10 => string.Format(L["LocalModels_SpeedFast"], tps),
            >= 3 => string.Format(L["LocalModels_SpeedMedium"], tps),
            _ => string.Format(L["LocalModels_SpeedSlow"], tps)
        };
    }

    private static string GetTaskStatusClass(string status)
    {
        return status switch
        {
            "running" => "status-running",
            "completed" => "status-completed",
            "failed" => "status-failed",
            _ => ""
        };
    }

    private string GetTaskStatusLabel(string status)
    {
        return status switch
        {
            "pending" => L["LocalModels_DeployStatusPending"],
            "running" => L["LocalModels_DeployStatusRunning"],
            "completed" => L["LocalModels_DeployStatusCompleted"],
            "failed" => L["LocalModels_DeployStatusFailed"],
            _ => status
        };
    }

    #region 运行中模型管理

    private List<RunningModelDto> runningModels = new();
    private bool isLoadingModel = false;

    private async Task RefreshRunningModels()
    {
        runningModels = await ApiService.GetRunningModelsAsync(forceRefresh: true);
        await InvokeAsync(StateHasChanged);
    }
    private RunningModelDto? unloadTarget;

    private void UnloadModel(RunningModelDto model)
    {
        unloadTarget = model;
    }

    private void CancelUnloadModel()
    {
        unloadTarget = null;
    }


    private async Task ConfirmUnloadModel()
    {
        var model = unloadTarget;
        unloadTarget = null;
        if (model == null) return;
        isLoadingModel = true;
        try
        {
            await ApiService.UnloadModelAsync(new UnloadModelRequest
            {
                ToolId = model.ToolId,
                ModelName = model.ModelName
            });

            await Task.Delay(500);
            await RefreshRunningModels();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "卸载模型失败: {Model}", model.DisplayName);
        }
        finally
        {
            isLoadingModel = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private string GetTimeRemaining(DateTime expiresAt)
    {
        var remaining = expiresAt - DateTime.Now;
        if (remaining.TotalSeconds <= 0) return L["LocalModels_ExpireSoon"];
        if (remaining.TotalHours >= 1) return string.Format(L["LocalModels_ExpireHours"], remaining.TotalHours);
        if (remaining.TotalMinutes >= 1) return string.Format(L["LocalModels_ExpireMinutes"], remaining.TotalMinutes);
        return L["LocalModels_ExpireSoon"];
    }

    #endregion

    public void Dispose()
    {
        _statusTimer?.Stop();
        _statusTimer?.Dispose();

    }

    private async Task OnTabChanged(string tab)
    {
        _activeTab = tab;
        await InvokeAsync(StateHasChanged);
    }
}
