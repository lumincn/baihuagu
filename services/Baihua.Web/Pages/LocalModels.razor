        ("DeepSeek", "🐋 DeepSeek"),
    };

    protected override void OnInitialized()
    {
        // 立即渲染骨架屏，数据后台加载
        isLoading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 后台并行加载所有数据
        _ = Task.Run(async () =>
        {
            try
            {
                await LoadAllDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "后台加载失败");
            }
            finally
            {
                await InvokeAsync(() =>
                {
                    isLoading = false;
                    StateHasChanged();
                });
            }
        });

        StartStatusPolling();
    }

    private async Task LoadAllDataAsync()
    {
        try
        {
            // 第一步：硬件 + 本地工具（快），完成后即可先渲染概览，不必等慢的提供方扫描
            SetLoadingStatus("正在检测硬件环境…");
            var hwTask = ApiService.GetHardwareInfoAsync();
            var toolsTask = ApiService.GetLocalToolsAsync();
            await Task.WhenAll(hwTask, toolsTask);

            hardwareInfo = hwTask.Result;
            localTools = toolsTask.Result;
            await InvokeAsync(() =>
            {
                isLoading = false;
                StateHasChanged();
            });

            // 第二步：其余数据独立加载、各自容错（OpenVINO 不可达时不再拖慢整体）
            SetLoadingStatus("正在扫描本地模型服务…");
            var tasks = new List<Task>
            {
                SafeLoadAsync(() => LoadRecommendationsAsync()),
                SafeLoadAsync(RefreshRunningModels),
                SafeLoadAsync(RefreshDownloadedModels),
                SafeLoadAsync(LoadOpenVinoLlmStatus),
                SafeLoadAsync(LoadOpenVinoAsync),
            };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载数据失败");
        }
    }

    private void SetLoadingStatus(string msg)
    {
        loadingStatus = msg;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SafeLoadAsync(Func<Task> fn)
    {
        try
        {
            await fn();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "分块加载失败");
        }
    }

    private async Task LoadOpenVinoAsync()
    {
        try
        {
            var catTask = ApiService.GetOpenVinoCatalogAsync();
            var dlTask = ApiService.GetOpenVinoDownloadsAsync();
            await Task.WhenAll(catTask, dlTask);
            openVinoCatalog = catTask.Result;
            openVinoDownloads = dlTask.Result;

            // 有活跃下载任务则保持定时刷新
            if (openVinoDownloads.Any(t => t.Status is "running" or "pending"))
                EnsureDownloadTimer();
        }
        catch (Exception ex)
        {
            openVinoMessage = "OpenVINO 数据加载失败：" + ex.Message;
        }
    }

    private async Task RefreshOpenVinoAsync()
    {
        await LoadOpenVinoAsync();
        StateHasChanged();
    }

    private void EnsureDownloadTimer()
    {
        if (_downloadTimer != null) return;
        _downloadTimer = new System.Timers.Timer(3000) { AutoReset = true };
        _downloadTimer.Elapsed += async (_, _) =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadOpenVinoAsync();
                    StateHasChanged();
                    if (!openVinoDownloads.Any(t => t.Status is "running" or "pending"))
                    {
                        _downloadTimer?.Stop();
                        _downloadTimer?.Dispose();
                        _downloadTimer = null;
                    }
                });
            }
            catch { }
        };
        _downloadTimer.Start();
    }

    private async Task StartDownloadAsync(string modelId)
    {
        openVinoMessage = null;
        try
        {
            await ApiService.StartOpenVinoDownloadAsync(modelId);
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = "启动下载失败：" + ex.Message;
        }
    }

    private async Task CancelDownloadAsync(string taskId)
    {
        try
        {
            await ApiService.CancelOpenVinoDownloadAsync(taskId);
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = "取消失败：" + ex.Message;
        }
    }

    private async Task RunModelAsync(string path)
    {
        openVinoMessage = null;
        try
        {
            var r = await ApiService.RunOpenVinoModelAsync(path);
            openVinoMessage = r.Success
                ? $"已启动 :{r.Port}（{r.Endpoint}）"
                : $"运行失败：{r.Error}";
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = "运行失败：" + ex.Message;
        }
    }

    private async Task StopModelAsync(int port)
    {
        try
        {
            await ApiService.StopOpenVinoModelAsync(port);
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = "停止失败：" + ex.Message;
        }
    }

    private async Task DeleteModelAsync(string path)
    {
        try
        {
            await ApiService.DeleteOpenVinoModelAsync(path);
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = "删除失败：" + ex.Message;
        }
    }

    // OpenVINO 已下载模型删除确认（与概览 tab 一致的确认流程）
    private OpenVinoCatalogItemDto? openVinoToDelete;

    private void AskDeleteOpenVino(OpenVinoCatalogItemDto m) => openVinoToDelete = m;

    private void CancelDeleteOpenVino() => openVinoToDelete = null;

    private async Task ConfirmDeleteOpenVino()
    {
        if (openVinoToDelete == null) return;
        var path = openVinoToDelete.Path;
        openVinoToDelete = null;
        if (string.IsNullOrWhiteSpace(path)) return;
        await DeleteModelAsync(path);
