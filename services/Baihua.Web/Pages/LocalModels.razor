        padding: 1rem 1.25rem;
        border-top: 1px solid #e8eef2;
    }

    .details-sections {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .detail-section h4 {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
        color: #555;
    }

    .detail-code {
        background: #1e1e1e;
        color: #c8d4dc;
        border-radius: 6px;
        padding: 0.75rem;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.8rem;
        max-height: 200px;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-all;
        margin: 0;
    }

