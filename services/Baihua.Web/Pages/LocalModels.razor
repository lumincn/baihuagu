@page "/local-models"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Baihua.Contracts.LocalModels
@using Baihua.Contracts.OpenClaw
@using Baihua.Contracts.Benchmark
@using Baihua.Web.Components.LocalModels
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.CapabilityService CapabilityService
@inject Baihua.Web.Services.AIStatusService AIStatusService
@inject Baihua.Web.Hubs.StatusUpdateService StatusUpdateService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Localization.IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@inject Microsoft.Extensions.Logging.ILogger<LocalModels> Logger
@implements IDisposable

<PageTitle>@L["LocalModels_PageTitle"]</PageTitle>

<h1>🖥️ @L["LocalModels_Title"]</h1>

<!-- Tab 导航 -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(_activeTab == "overview" ? "active" : "")" @onclick='async () => await OnTabChanged("overview")'>📊 @L["LocalModels_TabOverview"]</button>
    </li>
    @if (_openVinoAvailable != false)
    {
        <li class="nav-item">
            <button class="nav-link @(_activeTab == "openvino" ? "active" : "")" @onclick='async () => await OnTabChanged("openvino")'>🧿 OpenVINO</button>
        </li>
    }
</ul>


@if (isLoading)
{
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["LocalModels_Loading"]</span>
        </div>
        <div class="mt-2">@L["LocalModels_Refreshing"]@(!string.IsNullOrEmpty(loadingStatus) ? $"：{loadingStatus}" : "")
        </div>
    </div>
}
else
{
    <!-- Hardware Overview -->
    @if (_activeTab == "overview")
    {
    <!-- Hardware Overview -->
    <div class="hardware-section">
        <div class="section-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showHardware)">
<h2>@(_showHardware ? "▼" : "▶") @L["LocalModels_HardwareTitle"]</h2>
        </div>
        @if (_showHardware)
        {
        <div class="hardware-cards">
            <div class="hw-card">
                <div class="hw-icon">🖥️</div>
                <div class="hw-title">CPU</div>
                <div class="hw-value">@(hardwareInfo?.Cpu.Name ?? @L["LocalModels_CpuDetecting"])</div>
                <div class="hw-detail">@(hardwareInfo?.Cpu.LogicalProcessorCount ?? 0) @L["LocalModels_CpuCore"] @(hardwareInfo?.Cpu.Architecture ?? "")</div>
            </div>
            <div class="hw-card">
                <div class="hw-icon">🧠</div>
                <div class="hw-title">@L["LocalModels_MemoryTitle"]</div>
                <div class="hw-value">@(hardwareInfo?.Memory.TotalGiB.ToString("F1") ?? "-") GB</div>
                <div class="hw-detail">@L["LocalModels_MemoryDetail", hardwareInfo?.Memory.AvailableGiB.ToString("F1") ?? "-"]</div>
            </div>
            <div class="hw-card">
                <div class="hw-icon">🎮</div>
                <div class="hw-title">@L["LocalModels_GpuTitle"]</div>
                @if (hardwareInfo?.Gpus?.Count > 0)
                {
                    @foreach (var gpu in hardwareInfo.Gpus)
                    {
                        <div class="hw-value">@gpu.Name</div>
                        <div class="hw-detail">
                            @(gpu.VramGiB.HasValue ? $"{gpu.VramGiB:F1} GB" : @L["LocalModels_VramUnknown"])
                            @(gpu.IsIntegrated ? @L["LocalModels_IntegratedSuffix"] : "")
                            @(gpu.IsAppleSilicon ? @L["LocalModels_AppleUnifiedSuffix"] : "")
                        </div>
                    }
                }
                else
                {
                    <div class="hw-value">@L["LocalModels_NoGpuDetected"]</div>
                    <div class="hw-detail">@L["LocalModels_CpuFallback"]</div>
                }
            </div>
            <div class="hw-card">
                <div class="hw-icon">💾</div>
                <div class="hw-title">@L["LocalModels_DiskTitle"]</div>
                <div class="hw-value">@(GetDiskGiB(hardwareInfo?.AvailableDiskSpaceBytes) ?? "-") GB</div>
                <div class="hw-detail">@L["LocalModels_DiskAvailable"]</div>
            </div>
        </div>
        <button class="btn btn-secondary btn-sm" @onclick="RefreshHardware">🔄 @L["LocalModels_RefreshHardware"]</button>
        }
    </div>

    <!-- Running Models -->
    <div class="running-section">
        <div class="section-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showRunningModels)">
            <h2>@(_showRunningModels ? "▼" : "▶") ▶️ @L["LocalModels_RunningModelsTitle"]</h2>
            <button class="btn btn-secondary btn-sm" @onclick="RefreshRunningModels" @onclick:stopPropagation>🔄 @L["LocalModels_RefreshModels"]</button>
        </div>
        @if (_showRunningModels)
        {
            @if (runningModels.Count == 0)
            {
                <div class="alert alert-info">@L["LocalModels_NoRunningModels"]</div>
            }
            else
            {
                <div class="running-models-table">
                    <div class="running-table-header">
                        <span class="col-model">@L["LocalModels_Col_Model"]</span>
                        <span class="col-tool">@L["LocalModels_Col_Tool"]</span>
                        <span class="col-port">@L["LocalModels_Col_Port"]</span>
                        <span class="col-mem">@L["LocalModels_Col_MemoryUsage"]</span>
                        <span class="col-expires">@L["LocalModels_Col_Expires"]</span>
                        <span class="col-actions">@L["LocalModels_Col_Actions"]</span>
                    </div>
                    @foreach (var rm in runningModels)
                    {
                        <div class="running-table-row">
                            <span class="col-model">
                                <span class="model-name-text">@rm.DisplayName</span>
                                @if (!string.IsNullOrEmpty(rm.Family))
                                {
                                    <span class="badge badge-light">@rm.Family</span>
                                }
                            </span>
                            <span class="col-tool">
                                <span class="tool-badge @GetToolBadgeClass(rm.ToolId)">@rm.ToolName</span>
                            </span>
                            <span class="col-port">@(rm.Port?.ToString() ?? "-")</span>
                            <span class="col-mem">
                                @if (rm.VramGiB.HasValue && rm.VramGiB.Value > 0)
                                {
                                    <span>VRAM @rm.VramGiB.Value.ToString("F1") GB</span>
                                }
                                else
                                {
                                    <span>~@rm.SizeGiB.ToString("F1") GB</span>
                                }
                                <div class="mem-bar">
                                    <div class="mem-fill" style="width: @(Math.Min(100, (int)((rm.SizeBytes / (double)(hardwareInfo?.Memory.TotalBytes ?? 1)) * 100)))%"></div>
                                </div>
                            </span>
                            <span class="col-expires">
                                @if (rm.ExpiresAt.HasValue)
                                {
                                    <span title="@rm.ExpiresAt.Value.ToString("yyyy-MM-dd HH:mm:ss")">@GetTimeRemaining(rm.ExpiresAt.Value)</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </span>
                            <span class="col-actions">
                                <button class="btn btn-danger btn-sm" @onclick='() => UnloadModel(rm)' disabled="@isLoadingModel">
                                    ⏹ @L["LocalModels_Unload"]
                                </button>
                            </span>
                        </div>
                    }
                </div>
                <div class="memory-summary">
                    @L["LocalModels_TotalRunning", runningModels.Count, runningModels.Sum(m => m.SizeGiB).ToString("F1")]
                </div>
            }
        }
    </div>

    }

    @if (_activeTab == "overview")
    {
    <!-- Local Tools Status -->
    <div class="tools-section">
        <div class="section-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showLocalTools)">
            <h2>@(_showLocalTools ? "▼" : "▶") @L["LocalModels_LocalToolsTitle"]</h2>
        </div>
        @if (_showLocalTools)
        {
        <div class="tools-list">
            @foreach (var tool in localTools)
            {
                <div class="tool-item">
                    <span class="tool-name">@tool.Name</span>
                    @if (tool.IsInstalled)
                    {
                        <span class="badge badge-success">@L["LocalModels_Installed"] @(tool.Version)</span>
                        @if (tool.IsRunning)
                        {
                            <span class="badge badge-info">@L["LocalModels_Running"]</span>
                        }
                        else
                        {
                            <span class="badge badge-warning">@L["LocalModels_NotRunning"]</span>
                        }
                    }
                    else
                    {
                        <span class="badge badge-warning">@L["LocalModels_NotInstalled"]</span>
                        @if (!string.IsNullOrEmpty(tool.InstallGuideUrl))
                        {
                            <a href="@tool.InstallGuideUrl" target="_blank" class="link-small">@L["LocalModels_InstallGuide"]</a>
                        }
                    }
                </div>
            }
        </div>
        }
    </div>

    }

    @if (_activeTab == "overview")
    {


    <!-- Scene Filters -->
    <div class="scenario-section">
        <div class="scenario-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showRecommendations)">
            <h2>@(_showRecommendations ? "▼" : "▶") @L["LocalModels_RecommendationsTitle"]</h2>
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshLibrary" @onclick:stopPropagation
                    disabled="@isRefreshingLibrary" title="@L["LocalModels_RefreshLibrary"]">
                @(isRefreshingLibrary ? "🔄 " + L["LocalModels_Refreshing"] : "🔄 " + L["LocalModels_RefreshLibrary"])
            </button>
        </div>
        <div class="scenario-tags">
            @foreach (var tag in scenarioTags)
            {
                <button class="scenario-tag @(currentScenario == tag.Value ? "active" : "")"
                        @onclick="() => SelectScenario(tag.Value)">
                    @tag.Label
                </button>
            }
        </div>
        <div class="scenario-tags company-tags" style="margin-top:0.5rem;">
            @foreach (var tag in companyTags)
            {
                <button class="scenario-tag company-tag @(currentCompany == tag.Value ? "active" : "")"
                        @onclick="() => SelectCompany(tag.Value)">
                    @tag.Label
                </button>
            }
        </div>
    </div>

    @if (_showRecommendations)
    {
        @if (availableVram.HasValue)
        {
            <div class="hardware-vram-bar" style="margin-bottom:1rem;">
                <span style="font-size:0.85rem;padding:0.35rem 0.75rem;background:#e0ecf4;border-radius:20px;color:#2e8baf;font-weight:500;">
                    @L["LocalModels_VramDisplay", availableVram.Value.ToString("F1")]
                    @if (recommendedTierVramGb.HasValue)
                    {
                        <span style="color:#3d6b45;font-weight:600;"> → @L["LocalModels_RecommendedTier", recommendedTierVramGb.Value]</span>
                    }
                </span>
            </div>
        }

        @if (FilteredModelsByTier.Count == 0)
        {
            <div class="alert alert-warning">@L["LocalModels_NoRecommendations"]</div>
        }
        else
        {
            @foreach (var tier in VramTierValues)
            {
                var models = FilteredModelsByTier.GetValueOrDefault(tier);
                if (models == null || models.Count == 0) continue;

                var isRecommended = recommendedTierVramGb.HasValue && recommendedTierVramGb.Value == tier;

                <div class="tier-group @(isRecommended ? "tier-recommended" : "")">
                    <div class="tier-group-header">
                        <div class="tier-title">
                            <span class="tier-badge">💾 @tier GB</span>
                            @if (isRecommended)
                            {
                                <span class="tier-recommended-badge">✓ @L["LocalModels_RecommendedBadge"]</span>
                            }
                        </div>
                        <span class="tier-count">@L["LocalModels_RecommendedCount", models.Count]</span>
                    </div>
                    <div class="models-grid">
                        @foreach (var model in models)
                        {
                            @RenderModelCard(model)
                        }
                    </div>
                </div>
            }
        }
    }

    }


    @if (_activeTab == "overview")
    {
    <!-- Deploy Status Panel -->
    @if (activeTasks.Count > 0)
    {
        <div class="deploy-section">
            <h2>@L["LocalModels_DeployStatusTitle"]</h2>
            @foreach (var task in activeTasks)
            {
                <div class="deploy-card">
                    <div class="deploy-header">
                        <span class="deploy-model">@task.ModelName</span>
                        <span class="deploy-status @GetTaskStatusClass(task.Status)">@GetTaskStatusLabel(task.Status)</span>
                    </div>
                    <div class="deploy-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: @task.ProgressPercent%"></div>
                        </div>
                        <span class="progress-text">@task.ProgressPercent%</span>
                    </div>
                    <div class="deploy-step">@task.CurrentStep</div>
                    <div class="deploy-logs">
                        @foreach (var log in task.Logs.TakeLast(5))
                        {
                            <div class="log-line">@log</div>
                        }
                    </div>
                    @if (task.Status == "running")
                    {
                        <button class="btn btn-danger btn-sm" @onclick="() => CancelDeploy(task.TaskId)">@L["Common_Cancel"]</button>
                    }
                    @if (task.Status == "completed" && task.AutoConfiguredProvider)
                    {
                        <div class="deploy-success">
                            ✅ @L["LocalModels_AutoAddedSetting"]
                        </div>
                    }
                </div>
            }
        </div>
    }
    }
}

<style>
    .loading-spinner {
        padding: 2rem;
        text-align: center;
        color: #666;
    }

    .hardware-section, .tools-section, .scenario-section, .deploy-section {
        margin-bottom: 2rem;
    }

    .hardware-section h2, .tools-section h2, .scenario-section h2, .deploy-section h2 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
        color: #333;
    }

    .hardware-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .hw-card {
        background: #f5f8fa;
        border: 1px solid #e8eef2;
        border-radius: 10px;
        padding: 1rem;
        text-align: center;
    }

    .hw-icon {
        font-size: 1.8rem;
        margin-bottom: 0.3rem;
    }

    .hw-title {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.3rem;
    }

    .hw-value {
        font-size: 0.95rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.2rem;
        word-break: break-word;
    }

    .hw-detail {
        font-size: 0.8rem;
        color: #888;
    }

    .tools-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .tool-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #f5f8fa;
        border: 1px solid #e8eef2;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
    }

    .tool-name {
        font-weight: 500;
        font-size: 0.9rem;
    }

    .link-small {
        font-size: 0.8rem;
        color: #2e8baf;
        text-decoration: none;
    }

    .link-small:hover {
        text-decoration: underline;
    }

    .scenario-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .scenario-header h2 {
        margin-bottom: 0;
    }

    .scenario-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .scenario-tag {
        padding: 0.4rem 1rem;
        border: 1px solid #d8e2e8;
        border-radius: 20px;
        background: white;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .scenario-tag:hover {
        background: #f5f8fa;
    }

    .scenario-tag.active {
        background: #2e8baf;
        color: white;
        border-color: #2e8baf;
    }

    .models-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .model-card {
        background: white;
        border: 1px solid #e8eef2;
        border-radius: 10px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .model-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .model-name {
        font-weight: 600;
        font-size: 1rem;
        color: #333;
    }

    .model-size {
        font-size: 0.85rem;
        color: #666;
        background: #e8eef2;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }

    .model-desc {
        font-size: 0.85rem;
        color: #555;
        line-height: 1.4;
    }

    .model-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
    }

    .model-requirements {
        display: flex;
        gap: 1rem;
        font-size: 0.8rem;
        color: #666;
    }

    .model-suitability {
        font-size: 0.85rem;
        padding: 0.3rem 0.5rem;
        border-radius: 4px;
        font-weight: 500;
    }

    .suitability-good {
        background: #e0f0e5;
        color: #3d6b45;
    }

    .suitability-ok {
        background: #f5eee0;
        color: #6a5a3a;
    }

    .suitability-slow {
        background: #e0ecf4;
        color: #4a2a30;
    }

    .model-performance {
        font-size: 0.85rem;
    }

    .speed-badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-weight: 500;
        font-size: 0.8rem;
    }

    .speed-fast {
        background: #e0f0e5;
        color: #3d6b45;
    }

    .speed-medium {
        background: #f5eee0;
        color: #6a5a3a;
    }

    .speed-slow {
        background: #ffe5cc;
        color: #804000;
    }

    .speed-very-slow {
        background: #e0ecf4;
        color: #4a2a30;
    }

    /* 显存档位分组 */
    .tier-group {
        margin-bottom: 1.5rem;
        border: 1px solid #e8eef2;
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
    }

    .tier-group.tier-recommended {
        border-color: #6b9e75;
        box-shadow: 0 0 0 1px #6b9e7520;
    }

    .tier-group-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        background: #f5f8fa;
        border-bottom: 1px solid #e8eef2;
    }

    .tier-group.tier-recommended .tier-group-header {
        background: #e0f0e5;
    }

    .tier-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tier-badge {
        font-weight: 700;
        font-size: 1rem;
        color: #1e3a4c;
    }

    .tier-recommended-badge {
        font-size: 0.72rem;
        padding: 0.15rem 0.5rem;
        background: #6b9e75;
        color: #fff;
        border-radius: 12px;
        font-weight: 500;
    }

    .tier-count {
        font-size: 0.8rem;
        color: #5a6a72;
    }

    .tier-group .models-grid {
        padding: 1rem;
        margin-bottom: 0;
    }

    .deploy-card {
        background: #f5f8fa;
        border: 1px solid #e8eef2;
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .deploy-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .deploy-model {
        font-weight: 600;
    }

    .deploy-status {
        font-size: 0.85rem;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
    }

    .status-running {
        background: #e0ecf4;
        color: #4a2a30;
    }

    .status-completed {
        background: #e0f0e5;
        color: #3d6b45;
    }

    .status-failed {
        background: #e0ecf4;
        color: #4a2a30;
    }

    .deploy-progress {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .progress-bar {
        flex: 1;
        height: 8px;
        background: #d8e2e8;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: #2e8baf;
        border-radius: 4px;
        transition: width 0.3s ease;
    }

    .progress-text {
        font-size: 0.85rem;
        color: #666;
        min-width: 2.5rem;
        text-align: right;
    }

    .deploy-step {
        font-size: 0.85rem;
        color: #555;
        margin-bottom: 0.5rem;
    }

    .deploy-logs {
        background: #1e1e1e;
        color: #c8d4dc;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.8rem;
        max-height: 120px;
        overflow-y: auto;
        margin-bottom: 0.5rem;
    }

    .log-line {
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-all;
    }

    .deploy-success {
        margin-top: 0.5rem;
        font-size: 0.9rem;
    }

    .deploy-success a {
        color: #2e8baf;
    }

    .btn-sm {
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
    }

    /* 运行中模型 */
    .running-section {
        margin-bottom: 1.5rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .running-models-table {
        background: white;
        border: 1px solid #e8eef2;
        border-radius: 8px;
        overflow: hidden;
    }

    .running-table-header, .running-table-row {
        display: grid;
        grid-template-columns: 2fr 1fr 0.7fr 1.5fr 1.2fr 1fr;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        align-items: center;
    }

    .running-table-header {
        background: #f5f8fa;
        font-weight: 600;
        font-size: 0.85rem;
        color: #555;
    }

    .running-table-row {
        border-top: 1px solid #e8eef2;
        font-size: 0.9rem;
    }

    .running-table-row:hover {
        background: #f5f8fa;
    }

    .col-model {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .model-name-text {
        font-weight: 500;
    }

    .tool-badge {
        display: inline-block;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .tool-openvino {
        background: #e8f0e8;
        color: #3d7a4d;
    }

    .mem-bar {
        width: 100%;
        height: 6px;
        background: #e8eef2;
        border-radius: 3px;
        margin-top: 0.2rem;
        overflow: hidden;
    }

