        padding: 0.25rem 0.5rem;
        background: #f5eee8;
        border-radius: 6px;
        border: 1px solid #e8dcd0;
        transition: background 0.2s;
    }

    .preset-checkbox:hover {
        background: #e8dcd0;
    }

    .preset-checkbox input[type="checkbox"] {
        margin: 0;
        cursor: pointer;
    }

    /* 已下载模型区域 */
    .downloaded-section {
        margin-bottom: 1.5rem;
    }

    .downloaded-models-table {
        background: white;
        border: 1px solid #e8eef2;
        border-radius: 8px;
        overflow: hidden;
    }

    .downloaded-table-header, .downloaded-table-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.5fr;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        align-items: center;
    }

    .ovms-downloaded-table .downloaded-table-header,
    .ovms-downloaded-table .downloaded-table-row {
        grid-template-columns: 2fr 1fr 1fr 1fr;
    }

    .downloaded-table-header {
        background: #f5f8fa;
        font-weight: 600;
        font-size: 0.85rem;
        color: #555;
    }

    .downloaded-table-row {
        border-top: 1px solid #e8eef2;
        font-size: 0.9rem;
    }

    .downloaded-table-row:hover {
        background: #f5f8fa;
    }

    .col-dl-name {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .digest-text {
        font-size: 0.75rem;
        color: #888;
    }

    .col-dl-actions {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .modal-content {
        background: white;
        border-radius: 10px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        max-width: 90vw;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .modal-small {
        width: 420px;
    }

    .modal-large {
        width: 700px;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #e8eef2;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.1rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #888;
