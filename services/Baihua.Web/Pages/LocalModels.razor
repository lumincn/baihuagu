    // OpenVINO LLM 托管服务（宿主机 openvino_host.py）
    private List<OpenVinoLlmInstanceDto> openVinoLlmInstances = new();
    private string? openVinoLlmError;
    private string openVinoLlmMessage = "";
    private bool openVinoLlmSuccess = true;
    private bool isLoadingOpenVinoLlm;
    private bool isControllingOpenVinoLlm;

    private void ToggleSection(ref bool flag) => flag = !flag;

    private readonly List<(string Value, string Label)> scenarioTags = new()
    {
        ("", "全部"),
        ("chat", "💬 通用对话"),
        ("chinese", "🇨🇳 中文优化"),
        ("tcm", "📝 笔记"),
        ("code", "💻 代码编程"),
        ("reasoning", "🧠 推理思考"),
        ("lightweight", "🪶 轻量快速"),
    };

    private readonly List<(string Value, string Label)> companyTags = new()
    {
        ("", "🏢 全部公司"),
        ("阿里云", "☁️ 阿里云"),
