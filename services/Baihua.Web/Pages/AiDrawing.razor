@page "/ai-drawing"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject Baihua.Web.Services.IApiService ApiService
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<PageTitle>@L["AiDrawing_PageTitle"]</PageTitle>

<h1>🎨 @L["AiDrawing_Title"]</h1>

@if (!comfyAvailable)
{
    <div class="alert alert-warning">
        ⚠️ @L["AiDrawing_ComfyUnavailable"]
        <button class="btn btn-sm btn-primary" @onclick="CheckStatusAsync">🔄 @L["AiDrawing_Recheck"]</button>
    </div>
}

<div class="drawing-layout">
    <!-- 左侧：参数与生成 -->
    <div class="drawing-config">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="mb-3">⚙️ @L["AiDrawing_GenerationParams"]</h5>

                <div class="mb-3">
                    <label class="form-label">@L["AiDrawing_Mode"]</label>
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn @(mode == "image" ? "btn-primary" : "btn-outline-primary")" @onclick="SetModeImage">🖼️ @L["AiDrawing_ImageMode"]</button>
                        <button type="button" class="btn @(mode == "video" ? "btn-primary" : "btn-outline-primary")" @onclick="SetModeVideo">🎬 @L["AiDrawing_VideoMode"]</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["AiDrawing_Prompt"]</label>
                    <textarea class="form-control" rows="3" @bind="prompt" placeholder="@L["AiDrawing_PromptPlaceholder"]"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["AiDrawing_Style"]</label>
                    <select class="form-select" @bind="selectedStyle">
                        @foreach (var s in Styles)
                        {
                            <option value="@s.Name">@L[s.Name]</option>
                        }
                    </select>
                    <div class="form-text">@L["AiDrawing_StyleHint"]</div>
                </div>

                @if (mode == "image")
                {
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">@L["AiDrawing_Width"]</label>
                            <select class="form-select" @bind="width">
                                <option value="512">512</option>
                                <option value="768">768</option>
                                <option value="1024">1024</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">@L["AiDrawing_Height"]</label>
                            <select class="form-select" @bind="height">
                                <option value="512">512</option>
                                <option value="768">768</option>
                                <option value="1024">1024</option>
                            </select>
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">@L["AiDrawing_Steps", steps]</label>
                    <input type="range" class="form-range" min="10" max="40" step="1" @bind="steps" />
                    <div class="d-flex justify-content-between"><small>10</small><small>40</small></div>
                </div>

                <button class="btn btn-primary w-100" @onclick="GenerateAsync" disabled="@(isGenerating || !comfyAvailable)">
                    @(isGenerating ? L["AiDrawing_Generating"] : L["AiDrawing_Generate"])
                </button>

                @if (isGenerating)
                {
                    <div class="progress mt-3" style="height: 8px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                    </div>
                    <div class="text-muted small mt-2">@L["AiDrawing_GenerateHint"]</div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
                }

                @if (!string.IsNullOrEmpty(lastResultUrl))
                {
                    <div class="mt-3 text-center">
                        @if (mode == "image")
                        {
                            <img src="@lastResultUrl" class="drawing-result" alt="result" />
                        }
                        else
                        {
                            <video src="@lastResultUrl" class="drawing-result" controls autoplay muted loop></video>
                        }
                        <div class="text-muted small mt-2">
                            @L["AiDrawing_Duration", lastDurationSeconds]
                            <a class="btn btn-sm btn-outline-secondary ms-2" href="@lastResultUrl" target="_blank">⬇️ @L["AiDrawing_Download"]</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 右侧：历史记录 -->
    <div class="drawing-history">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">🕘 @L["AiDrawing_HistoryTitle"]</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadHistoryAsync">🔄 @L["AiDrawing_Refresh"]</button>
        </div>
        @if (historyItems.Count == 0)
        {
            <div class="text-muted text-center py-5">@L["AiDrawing_NoHistory"]</div>
        }
        else
        {
            <div class="drawing-grid">
                @foreach (var item in historyItems)
                {
                    <div class="card drawing-card">
                        <a href="@item.FullUrl" target="_blank">
                            @if (item.Kind == "image")
                            {
                                <img src="@item.FullUrl" class="card-img-top drawing-thumb" alt="@item.Prompt" loading="lazy"
                                     onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 200 120%22><rect width=%22100%25%22 height=%22100%25%22 fill=%22%23e9ecef%22/><text x=%2250%25%22 y=%2255%25%22 font-size=%2212%22 fill=%22%23999%22 text-anchor=%22middle%22>@L["AiDrawing_ImageLoadFailed"]</text></svg>';" />
                            }
                            else
                            {
                                <video src="@item.FullUrl" class="card-img-top drawing-thumb" muted preload="metadata"
                                       onerror="this.onerror=null;this.outerHTML='<div class=&quot;drawing-thumb drawing-thumb-fallback&quot;>@L["AiDrawing_VideoLoadFailed"]</div>';"></video>
                            }
                        </a>
                        <div class="card-body py-2">
                            <div class="small text-truncate" title="@item.Prompt">@item.Prompt</div>
                            <div class="text-muted small d-flex justify-content-between">
                                <span>@(item.Kind == "image" ? "🖼️" : "🎬") @item.CreatedAt.ToString("MM-dd HH:mm")</span>
                                @if (!item.IsSuccess)
                                {
                                    <span class="text-danger">@L["AiDrawing_Failed"]</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .drawing-layout {
        display: grid;
        grid-template-columns: minmax(300px, 400px) 1fr;
        gap: 1.25rem;
        align-items: start;
    }

    .drawing-result {
        max-width: 100%;
        max-height: 480px;
        border-radius: 8px;
        border: 1px solid #e8eef2;
    }

    .drawing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 0.75rem;
    }

    .drawing-card {
        overflow: hidden;
    }

    .drawing-thumb {
        height: 140px;
        object-fit: cover;
        width: 100%;
        background: #f0f3f6;
    }

    @@media (max-width: 900px) {
        .drawing-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private record StylePreset(string Name, string PromptSuffix);
    private record HistoryItem(int Id, string Kind, string Prompt, string Url, bool IsSuccess, DateTime CreatedAt)
    {
        public string FullUrl => Url; // 已在 ResolveUrl 时拼好完整地址
    }

    private static readonly StylePreset[] Styles =
    [
        new("AiDrawing_StyleDefault", ""),
        new("AiDrawing_StyleRealistic", ", professional photography, realistic, 8k, sharp focus, natural lighting"),
        new("AiDrawing_StyleAnime", ", anime style, vibrant colors, detailed illustration, studio quality"),
        new("AiDrawing_StyleCyberpunk", ", cyberpunk, neon lights, futuristic, cinematic, highly detailed"),
        new("AiDrawing_StyleInkWash", ", chinese ink painting, wash painting style, elegant, minimal"),
        new("AiDrawing_StyleOil", ", oil painting, impressionist, rich textures, artistic"),
        new("AiDrawing_Style3D", ", 3d render, octane render, cinematic lighting, ultra detailed"),
        new("AiDrawing_StylePixel", ", pixel art, retro game style, 8-bit, detailed sprites")
    ];

    private string mode = "image";
    private string prompt = "";
    private string selectedStyle = "AiDrawing_StyleDefault";
    private int width = 512;
    private int height = 512;
    private int steps = 20;
    private bool isGenerating;
    private string? errorMessage;
    private string? lastResultUrl;
    private double lastDurationSeconds;
    private List<HistoryItem> historyItems = [];
    private bool comfyAvailable = true;
    private string backendBase = "";

    protected override async Task OnInitializedAsync()
    {
        backendBase = ApiService.GetBackendBaseUrl().TrimEnd('/');
        await CheckStatusAsync();
        await LoadHistoryAsync();
    }

    private async Task CheckStatusAsync()
    {
        var status = await ApiService.GetComfyStatusAsync();
        comfyAvailable = status.Available;
    }

    private void SetMode(string m)
    {
        mode = m;
        errorMessage = null;
    }

    private void SetModeImage() => SetMode("image");
    private void SetModeVideo() => SetMode("video");

    private string BuildPrompt() =>
        (prompt.Trim() + Styles.First(s => s.Name == selectedStyle).PromptSuffix).Trim();

    private string ResolveUrl(string relative) => backendBase + relative;

    private async Task GenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(prompt))
        {
            errorMessage = L["AiDrawing_PromptRequired"];
            return;
        }

        isGenerating = true;
        errorMessage = null;
        lastResultUrl = null;
        try
        {
            var fullPrompt = BuildPrompt();
            if (mode == "image")
            {
                var result = await ApiService.GenerateComfyImageAsync(fullPrompt, "", width, height, steps);
                lastResultUrl = ResolveUrl(result.Url);
                lastDurationSeconds = result.DurationSeconds;
            }
            else
            {
                var result = await ApiService.GenerateComfyVideoAsync(fullPrompt, "");
                lastResultUrl = ResolveUrl(result.Url);
                lastDurationSeconds = result.DurationSeconds;
            }

            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        var items = await ApiService.GetComfyHistoryAsync(60);
        historyItems = items.Select(i => new HistoryItem(i.Id, i.Kind, i.Prompt, ResolveUrl(i.Url), i.IsSuccess, i.CreatedAt)).ToList();
    }
}
