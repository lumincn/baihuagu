@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<div class="modal-overlay" @onclick="OnCancel">
    <div class="modal-content disclaimer-modal" @onclick:stopPropagation>
        <h4>⚠️ @L["MasterDisclaimer_Title"]</h4>

        <div class="disclaimer-body">
            <p><strong>@L["MasterDisclaimer_Subtitle"]</strong></p>

            <ul>
                <li>@L["MasterDisclaimer_Li1_Pre"]<strong>@L["MasterDisclaimer_Li1_Strong"]</strong>@L["MasterDisclaimer_Li1_Post"]</li>
                <li>@L["MasterDisclaimer_Li2_Pre"]<strong>@L["MasterDisclaimer_Li2_Strong"]</strong>@L["MasterDisclaimer_Li2_Post"]</li>
                <li>@L["MasterDisclaimer_Li3"]</li>
            </ul>

            @if (IsMedicalOrLegal)
            {
                <div class="age-confirm">
                    <label>
                        <input type="checkbox" @bind="confirmedAdult" />
                        @L["MasterDisclaimer_AgeConfirmLabel"]
                    </label>
                </div>
            }
        </div>

        <div class="modal-actions">
            <button class="btn btn-secondary" @onclick="OnCancel">@L["MasterDisclaimer_RejectBtn"]</button>
            <button class="btn btn-primary" @onclick="OnConfirm" disabled="@(!CanConfirm)">
                @L["MasterDisclaimer_AcceptBtn"]
            </button>
        </div>
    </div>
</div>

<style>
    .disclaimer-modal {
        max-width: 480px;
    }
    .disclaimer-body {
        margin: 1rem 0;
        color: var(--master-text-secondary);
        line-height: 1.7;
    }
    .disclaimer-body ul {
        padding-left: 1.5rem;
        margin: 0.75rem 0;
    }
    .disclaimer-body li {
        margin-bottom: 0.5rem;
    }
    .disclaimer-body strong {
        color: var(--master-text);
    }
    .age-confirm {
        margin-top: 1rem;
        padding: 0.75rem;
        border-radius: 6px;
        background: rgba(255,200,100,0.1);
        border: 1px solid rgba(255,200,100,0.3);
    }
    .age-confirm label {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        cursor: pointer;
        font-size: 0.9rem;
    }
    .age-confirm input[type="checkbox"] {
        margin-top: 0.2rem;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }
</style>

@code {
    [Parameter] public bool IsMedicalOrLegal { get; set; }
    [Parameter] public EventCallback OnConfirmCallback { get; set; }
    [Parameter] public EventCallback OnCancelCallback { get; set; }

    private bool confirmedAdult = false;

    private bool CanConfirm => !IsMedicalOrLegal || confirmedAdult;

    private void OnConfirm()
    {
        if (!CanConfirm) return;
        OnConfirmCallback.InvokeAsync();
    }

    private void OnCancel()
    {
        OnCancelCallback.InvokeAsync();
    }
}
