@page "/server-messages"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Baihua.Contracts.ServerMessaging
@using Baihua.Web.Services
@inject ServerMessagingService MsgService
@implements IDisposable

<PageTitle>百花服务器互联</PageTitle>

<div class="server-msg-header">
    <h1 class="h4 mb-0">🛰️ 百花服务器互联</h1>
    <span class="text-secondary small">与其他百花服务器互发消息</span>
</div>

<div class="server-msg-layout">
    <!-- 左：对端列表 -->
    <div class="server-msg-sidebar">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold small">其它百花服务器（@_peers.Count）</span>
            <button class="btn btn-sm btn-primary" @onclick="() => _showAddForm = !_showAddForm">＋ 添加</button>
        </div>

        @if (_showAddForm)
        {
            <div class="server-msg-addform">
                <input class="form-control form-control-sm mb-1" placeholder="名称（如 家庭百花）" @bind="_newName" />
                <input class="form-control form-control-sm mb-1" placeholder="地址（如 http://192.168.3.14/ 或 http://192.168.3.14:30080）" @bind="_newUrl" />
                <input class="form-control form-control-sm mb-1" type="password" placeholder="共享口令（可选，留空用本机配置）" @bind="_newToken" />
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="AddPeerAsync" disabled="@_busy">保存</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showAddForm = false">取消</button>
                </div>
                @if (!string.IsNullOrEmpty(_peerError)) { <div class="text-danger small mt-1">@_peerError</div> }
            </div>
        }

        <div class="server-msg-peerlist">
            @if (_peers.Count == 0)
            {
                <div class="text-secondary small p-3 text-center">尚未登记其它百花服务器。<br />点击「添加」手动登记，<br />或等待局域网自动发现。</div>
            }
            @foreach (var peer in _peers)
            {
                <div class="server-msg-peer @(_selectedPeerId == peer.Id ? "active" : "")" @onclick="() => SelectPeerAsync(peer.Id)">
                    <div class="d-flex justify-content-between">
                        <span class="fw-medium">@peer.Name</span>
                        <span class="small text-secondary">@peer.Source</span>
                    </div>
                    <div class="small text-secondary text-truncate">@peer.BaseUrl</div>
                    <div class="small text-secondary">
                        @if (peer.LastSeenUtc.HasValue && peer.LastSeenUtc.Value > DateTime.UtcNow.AddMinutes(-5))
                        { <span class="text-success">● 在线</span> }
                        else
                        { <span class="text-muted">○ 最近：@(peer.LastSeenUtc?.ToLocalTime().ToString("MM-dd HH:mm") ?? "从未")</span> }
                    </div>
                    <button class="btn btn-sm btn-outline-danger server-msg-del" @onclick="() => DeletePeerAsync(peer.Id)" title="删除">🗑</button>
                </div>
            }
        </div>

        <div class="mt-2 text-muted small">
            💡 两台服务器需都部署本功能；发消息会推送到对方的
            <code>/mg/server-msg/inbox</code>（共享口令鉴权）。
        </div>
    </div>

    <!-- 右：对话 -->
    <div class="server-msg-chat">
        @if (_selectedPeer == null)
        {
            <div class="text-center text-secondary py-5">选择左侧服务器开始聊天</div>
        }
        else
        {
            <div class="server-msg-chat-head">
                <span class="fw-bold">@_selectedPeer.Name</span>
                <span class="text-secondary small ms-2">@_selectedPeer.BaseUrl</span>
            </div>

            <div class="server-msg-thread" id="msg-thread">
                @if (_messages.Count == 0)
                {
                    <div class="text-center text-secondary small py-4">暂无消息，发一条试试吧</div>
                }
                @foreach (var m in _messages)
                {
                    <div class="server-msg-bubble @(m.Direction == "out" ? "out" : "in")">
                        <div class="server-msg-bubble-text">@m.Content</div>
                        <div class="server-msg-bubble-time">
                            @m.SentAtUtc.ToLocalTime().ToString("MM-dd HH:mm") @(m.Direction == "out" ? "· 我" : "")
                        </div>
                    </div>
                }
            </div>

            <div class="server-msg-inputbar">
                <input class="form-control" placeholder="输入消息，回车发送" @bind="_draft" @onkeydown="OnKeyDownAsync" />
                <button class="btn btn-primary ms-2" @onclick="SendAsync" disabled="@_busy">发送</button>
            </div>
            @if (!string.IsNullOrEmpty(_sendError)) { <div class="text-danger small px-3 pb-1">@_sendError</div> }
        }
    </div>
</div>

<style>
    .server-msg-header { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color, #dee2e6); display: flex; align-items: baseline; gap: 0.75rem; }
    .server-msg-layout { display: flex; height: calc(100vh - 130px); min-height: 420px; }
    .server-msg-sidebar { width: 300px; min-width: 260px; border-right: 1px solid var(--border-color, #dee2e6); padding: 0.75rem; display: flex; flex-direction: column; overflow-y: auto; }
    .server-msg-addform { background: var(--surface-alt, #f5f7fa); padding: 0.6rem; border-radius: 8px; margin-bottom: 0.6rem; }
    .server-msg-peerlist { flex: 1; overflow-y: auto; }
    .server-msg-peer { position: relative; padding: 0.55rem 0.65rem; border-radius: 8px; margin-bottom: 0.35rem; cursor: pointer; border: 1px solid transparent; }
    .server-msg-peer:hover { background: rgba(46, 139, 175, 0.08); }
    .server-msg-peer.active { background: rgba(46, 139, 175, 0.15); border-color: rgba(46, 139, 175, 0.4); }
    .server-msg-del { position: absolute; top: 0.35rem; right: 0.4rem; padding: 0 0.35rem; font-size: 0.75rem; }
    .server-msg-chat { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .server-msg-chat-head { padding: 0.6rem 1rem; border-bottom: 1px solid var(--border-color, #dee2e6); }
    .server-msg-thread { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .server-msg-bubble { max-width: 70%; }
    .server-msg-bubble.in { align-self: flex-start; }
    .server-msg-bubble.out { align-self: flex-end; }
    .server-msg-bubble-text { padding: 0.5rem 0.8rem; border-radius: 12px; word-break: break-word; white-space: pre-wrap; }
    .server-msg-bubble.in .server-msg-bubble-text { background: var(--surface-alt, #eef2f6); border-top-left-radius: 2px; }
    .server-msg-bubble.out .server-msg-bubble-text { background: #2e8baf; color: #fff; border-top-right-radius: 2px; }
    .server-msg-bubble-time { font-size: 0.7rem; color: var(--text-muted, #888); margin-top: 2px; }
    .server-msg-bubble.out .server-msg-bubble-time { text-align: right; }
    .server-msg-inputbar { display: flex; padding: 0.6rem 1rem; border-top: 1px solid var(--border-color, #dee2e6); }
</style>

@code {
    private List<ServerPeerDto> _peers = new();
    private ServerPeerDto? _selectedPeer;
    private Guid _selectedPeerId;
    private List<ServerMessageDto> _messages = new();
    private string _draft = "";
    private string _newName = "";
    private string _newUrl = "";
    private string _newToken = "";
    private string _peerError = "";
    private string _sendError = "";
    private bool _busy;
    private bool _showAddForm;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadPeersAsync();
        _timer = new Timer(async _ => await PollAsync(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task PollAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadPeersAsync();
                if (_selectedPeer != null)
                    await LoadMessagesAsync(_selectedPeer.Id);
            });
        }
        catch { }
    }

    private async Task LoadPeersAsync()
    {
        _peers = await MsgService.GetPeersAsync();
        if (_selectedPeerId != Guid.Empty && !_peers.Any(p => p.Id == _selectedPeerId))
        {
            _selectedPeer = null;
            _selectedPeerId = Guid.Empty;
            _messages = new List<ServerMessageDto>();
        }
    }

    private async Task SelectPeerAsync(Guid peerId)
    {
        _selectedPeerId = peerId;
        _selectedPeer = _peers.FirstOrDefault(p => p.Id == peerId);
        await LoadMessagesAsync(peerId);
    }

    private async Task LoadMessagesAsync(Guid peerId)
    {
        _messages = await MsgService.GetMessagesAsync(peerId);
    }

    private async Task AddPeerAsync()
    {
        _busy = true;
        _peerError = "";
        try
        {
            var (ok, error, _) = await MsgService.AddPeerAsync(_newName, _newUrl, _newToken);
            if (ok)
            {
                _showAddForm = false;
                _newName = _newUrl = _newToken = "";
                await LoadPeersAsync();
            }
            else
            {
                _peerError = error ?? "添加失败";
            }
        }
        finally { _busy = false; }
    }

    private async Task DeletePeerAsync(Guid peerId)
    {
        if (_selectedPeerId == peerId) { _selectedPeer = null; _selectedPeerId = Guid.Empty; }
        await MsgService.DeletePeerAsync(peerId);
        await LoadPeersAsync();
    }

    private async Task SendAsync()
    {
        var content = _draft.Trim();
        if (string.IsNullOrEmpty(content) || _selectedPeerId == Guid.Empty) return;
        _busy = true;
        _sendError = "";
        try
        {
            var (ok, error) = await MsgService.SendMessageAsync(_selectedPeerId, content);
            if (ok)
            {
                _draft = "";
                await LoadMessagesAsync(_selectedPeerId);
            }
            else
            {
                _sendError = error ?? "发送失败";
            }
        }
        finally { _busy = false; }
    }

    private async Task OnKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    public void Dispose() => _timer?.Dispose();
}
