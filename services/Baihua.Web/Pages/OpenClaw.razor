@page "/openclaw"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.CapabilityService CapabilityService
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Logging.ILogger<OpenClaw> Logger
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@using Microsoft.JSInterop
@using Baihua.Contracts.OpenClaw

<PageTitle>@L["OpenClaw_PageTitle"]</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-robot"></i> @L["OpenClaw_Title"]</h2>
            <p class="text-muted">@L["OpenClaw_Subtitle"]</p>
        </div>
    </div>

    @if (_canShowLocalConfig)
    {
    <!-- 本地 AI 配置区 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center"
                     style="cursor: pointer;" @onclick="ToggleConfigPanel">
                    <span><i class="bi bi-cpu"></i> @L["OpenClaw_LocalAiConfig"]</span>
                    <i class="bi @(_showConfig ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </div>
                @if (_showConfig)
                {
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(_configError))
                        {
                            <div class="alert alert-danger">@_configError</div>
                        }
                        @if (!string.IsNullOrEmpty(_configSuccess))
                        {
                            <div class="alert alert-success">@_configSuccess</div>
                        }
                        @if (!string.IsNullOrEmpty(_syncMessage))
                        {
                            <div class="alert alert-info">@_syncMessage</div>
                        }

                        <!-- OpenVINO -->
                        @if (_isIntelGpu == false)
                        {
                            <div class="alert alert-warning">⚠️ @L["OpenClaw_OpenVinoNotSupported"]</div>
                        }
                        else
                        {
                        <div class="mb-4 p-3 border rounded">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="openVinoEnabled"
                                       checked="@_openVinoConfig.Enabled" @onchange="OnOpenVinoEnabledChanged">
                                <label class="form-check-label fw-bold" for="openVinoEnabled">@L["OpenClaw_UseOpenVino"]</label>
                                @if (_openVinoDetecting)
                                {
                                    <span class="badge bg-info ms-2"><span class="spinner-border spinner-border-sm" style="width:0.7rem;height:0.7rem;"></span> @L["OpenClaw_Detecting"]</span>
                                }
                                else if (!string.IsNullOrEmpty(_openVinoStatusMessage))
                                {
                                    @if (_openVinoStatusMessage.Contains("成功") || _openVinoStatusMessage.Contains("正在运行"))
                                    {
                                        <span class="badge bg-success ms-2">@L["OpenClaw_Running"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-2">@L["OpenClaw_NotRunning"]</span>
                                    }
                                }
                            </div>
                            @if (_openVinoDetecting)
                            {
                                <div class="alert alert-info py-2 mb-3">
                                    <span class="spinner-border spinner-border-sm me-2"></span>@_openVinoStatusMessage
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(_openVinoStatusMessage))
                            {
                                <div class="alert @(_openVinoStatusMessage.Contains("成功") || _openVinoStatusMessage.Contains("正在运行") ? "alert-success" : "alert-warning") py-2 mb-3">
                                    @_openVinoStatusMessage
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_openVinoCommandLine))
                            {
                                <div class="mb-3">
                                    <label class="form-label">@L["OpenClaw_StartupCommandLabel"]</label>
                                    <code class="d-block p-2 border rounded bg-dark text-light" style="white-space: pre-wrap; word-break: break-all;">@_openVinoCommandLine</code>
                                </div>
                            }
                            @if (_openVinoConfig.Enabled)
                            {
                                <div class="alert alert-light border mb-3">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @L["OpenClaw_OpenVinoDescription1"]<code>pip install openvino-genai</code>@L["OpenClaw_OpenVinoDescription2"]<code>openvino_llm_server.py</code>@L["OpenClaw_OpenVinoDescription3"]
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">@L["OpenClaw_BinaryPathLabel"]</label>
                                        <input type="text" class="form-control" @bind="_openVinoConfig.BinaryPath"
                                               placeholder="@L["OpenClaw_BinaryPathPlaceholder"]" />
                                        <div class="form-text">@L["OpenClaw_BinaryPathHint"]</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@L["OpenClaw_ModelPathLabel"]</label>
                                        <input type="text" class="form-control" @bind="_openVinoConfig.ModelPath"
                                               placeholder="/path/to/openvino_model" />
                                        <div class="form-text">@L["OpenClaw_ModelPathHint"]</div>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">@L["OpenClaw_DeviceLabel"]</label>
                                        <select class="form-select" @bind="_openVinoConfig.Device">
                                            @foreach (var d in _openVinoDevices)
                                            {
                                                <option value="@d">@d</option>
                                            }
                                            @if (!_openVinoDevices.Contains("CPU")) { <option value="CPU">CPU</option> }
                                            @if (!_openVinoDevices.Contains("GPU")) { <option value="GPU">GPU</option> }
                                            @if (!_openVinoDevices.Contains("NPU")) { <option value="NPU">NPU</option> }
                                            @if (!_openVinoDevices.Contains("AUTO")) { <option value="AUTO">AUTO</option> }
                                        </select>
                                        <div class="form-text">@string.Format(L["OpenClaw_DevicesDetected"], string.Join(" / ", _openVinoDevices))</div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@L["OpenClaw_PortLabel"]</label>
                                        <input type="number" class="form-control" @bind="_openVinoConfig.Port" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Base URL</label>
                                        <input type="text" class="form-control" @bind="_openVinoConfig.BaseUrl"
                                               placeholder="http://localhost:8000" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@L["OpenClaw_ContextSizeLabel"]</label>
                                        <input type="number" class="form-control" @bind="_openVinoConfig.ContextSize" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">@L["OpenClaw_ExtraArgsLabel"]</label>
                                    <input type="text" class="form-control" @bind="_openVinoConfig.ExtraArgs"
                                           placeholder="--num-beams 1" />
                                </div>
                                <div class="mb-3 d-flex gap-2">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="ScanOpenVinoModels"
                                            disabled="@_isScanningOpenVino">
                                        @if (_isScanningOpenVino)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-search me-1"></i>
                                        }
                                        @L["OpenClaw_ScanModels"]
                                    </button>
                                    <button class="btn btn-outline-success btn-sm" @onclick='() => SyncModelsAsync("openvino")'
                                            disabled="@(_isSyncingOpenVino || _openVinoModels.Count == 0)">
                                        @if (_isSyncingOpenVino)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up me-1"></i>
                                        }
                                        @L["OpenClaw_SyncToOpenClaw"]
                                    </button>
                                </div>
                                @if (_openVinoModels.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered">
                                            <thead class="table-light">
                                                <tr><th>@L["OpenClaw_Col_ModelId"]</th><th>@L["OpenClaw_Col_Name"]</th><th>@L["OpenClaw_Col_Context"]</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var m in _openVinoModels)
                                                {
                                                    <tr>
                                                        <td><code>@m.Id</code></td>
                                                        <td>@m.Name</td>
                                                        <td>@m.ContextWindow</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else if (_openVinoScanned)
                                {
                                    <div class="alert alert-warning py-2">@L["OpenClaw_NoOpenVinoModels"]</div>
                                }
                            }
                        </div>
                        }

                        <!-- 默认模型设置 -->
                        <!-- 模型配置文件 -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3"><i class="bi bi-layers-fill text-primary me-1"></i>@L["OpenClaw_ModelConfigTitle"]</h6>
                            <div class="row g-3">
                                @foreach (var profile in _modelProfiles)
                                {
                                    <div class="col-md-4">
                                        <div class="card h-100 @(_currentProfile == profile.Id ? "border-primary" : "")"
                                             style="cursor: pointer;" @onclick="() => SelectProfileAsync(profile.Id)">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="card-title mb-0">@profile.Name</h6>
                                                    @if (_currentProfile == profile.Id)
                                                    {
                                                        <span class="badge bg-primary">@L["OpenClaw_CurrentBadge"]</span>
                                                    }
                                                </div>
                                                <p class="card-text small text-muted">@profile.Description</p>
                                                <div class="d-flex gap-2 mt-2">
                                                    <span class="badge bg-light text-dark border">@profile.SizeInfo</span>
                                                    <span class="badge bg-light text-dark border">@profile.SpeedLabel</span>
                                                </div>
                                                <div class="mt-2 small text-primary">@profile.Model</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_profileMessage))
                            {
                                <div class="alert alert-success py-2 mt-3 mb-0">@_profileMessage</div>
                            }
                        </div>

                        <div class="mb-4 p-3 border rounded bg-light">
                            <h6 class="fw-bold mb-3"><i class="bi bi-star-fill text-warning me-1"></i>@L["OpenClaw_DefaultModelTitle"]</h6>
                            <div class="row align-items-end">
                                <div class="col-md-8">
                                    <label class="form-label">@L["OpenClaw_CurrentDefaultModel"]</label>
                                    <select class="form-select" @bind="_selectedDefaultModel">
                                        <option value="">@L["OpenClaw_UseBuiltinDefault"]</option>
                                        @foreach (var m in _availableModels)
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                    <div class="form-text">@L["OpenClaw_DefaultModelHint"]</div>
                                    @if (_availableModels.Count == 0)
                                    {
                                        <div class="alert alert-info py-2 mt-2 mb-0 small">
                                            <i class="bi bi-info-circle me-1"></i>
                                            <strong>@L["OpenClaw_NoModelsStrong"]</strong>@L["OpenClaw_NoModelsHint1"]
                                            <ul class="mb-0 mt-1 ps-4">
                                                <li>@L["OpenClaw_NoModelsHint2"]</li>
                                                <li>@L["OpenClaw_NoModelsHint3"]</li>
                                            </ul>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <button class="btn btn-primary" @onclick="SaveDefaultModelAsync" disabled="@_isSavingDefaultModel">
                                        @if (_isSavingDefaultModel)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        <i class="bi bi-save me-1"></i>@L["OpenClaw_SaveDefaultModel"]
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(_defaultModelMessage))
                            {
                                <div class="alert alert-success py-2 mt-3 mb-0">@_defaultModelMessage</div>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="SaveConfigAsync" disabled="@_isSavingConfig">
                                @if (_isSavingConfig)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <i class="bi bi-save me-1"></i> @L["OpenClaw_SaveConfig"]
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="LoadConfigAsync">
                                <i class="bi bi-arrow-clockwise"></i> @L["OpenClaw_Reset"]
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    }

    <!-- 任务提交区 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-plus-circle"></i> @L["OpenClaw_NewTask"]
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="promptInput" class="form-label">@L["OpenClaw_TaskPromptLabel"]</label>
                        <textarea id="promptInput" class="form-control" rows="4"
                                  @bind="_newPrompt"
                                  @bind:event="oninput"
                                  placeholder="@L["OpenClaw_PromptPlaceholder"]"
                                  disabled="@_isSubmitting"></textarea>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">@L["OpenClaw_CharCount", _newPrompt.Length]</span>
                        <button class="btn btn-primary" @onclick="SubmitTaskAsync" disabled="@(!CanSubmit)">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>@L["OpenClaw_Submitting"]</span>
                            }
                            else
                            {
                                <i class="bi bi-send me-1"></i>
                                <span>@L["OpenClaw_SendTask"]</span>
                            }
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_submitError))
                    {
                        <div class="alert alert-danger mt-3 mb-0">@_submitError</div>
                    }
                </div>
            </div>
        </div>
    </div>


    <!-- 任务列表 -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="bi bi-list-check"></i> @L["OpenClaw_TaskHistory"]</h5>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => RefreshTasksAsync()" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise"></i>
                    }
                    <span class="ms-1">@L["OpenClaw_Refresh"]</span>
                </button>
            </div>

            @if (_tasks == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@L["OpenClaw_Loading"]</span>
                    </div>
                </div>
            }
            else if (_tasks.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> @L["OpenClaw_NoTasks"]
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Prompt</th>
                                <th>@L["OpenClaw_Col_Status"]</th>
                                <th>@L["OpenClaw_Col_CreatedAt"]</th>
                                <th>@L["OpenClaw_Col_CompletedAt"]</th>
                                <th style="width: 180px;">@L["OpenClaw_Col_Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in _tasks)
                            {
                                <tr>
                                    <td><code>@task.TaskId</code></td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;" title="@task.Prompt">
                                            @task.Prompt
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(task.Status)">
                                            @GetStatusLabel(task.Status)
                                        </span>
                                    </td>
                                    <td>@task.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                    <td>
                                        @(task.CompletedAt?.ToLocalTime().ToString("MM-dd HH:mm") ?? "—")
                                    </td>
                                    <td>
                                        @if (task.Status == "running")
                                        {
                                            <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => CancelTaskAsync(task.Id)">
                                                <i class="bi bi-x-circle"></i> @L["OpenClaw_Cancel"]
                                            </button>
                                        }
                                        else if (task.Status == "completed" && !string.IsNullOrEmpty(task.ReportPath))
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ViewReportAsync(task.Id)">
                                                <i class="bi bi-file-earmark-text"></i> @L["OpenClaw_ViewReport"]
                                            </button>
                                        }
                                        else if (task.Status == "failed" && !string.IsNullOrEmpty(task.ErrorMessage))
                                        {
                                            <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => ViewErrorAsync(task.Id)">
                                                <i class="bi bi-bug"></i> @L["OpenClaw_ViewError"]
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" disabled>
                                                <i class="bi bi-file-earmark-text"></i> @L["OpenClaw_ViewReport"]
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTaskAsync(task.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- 报告/错误查看模态框 -->
@if (_showReportModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    @if (_selectedTask?.Status == "failed")
                    {
                        <h5 class="modal-title"><i class="bi bi-bug"></i> @L["OpenClaw_ErrorDetailTitle", _selectedTask!.TaskId]</h5>
                    }
                    else
                    {
                        <h5 class="modal-title"><i class="bi bi-file-earmark-text"></i> @L["OpenClaw_ReportTitle", _selectedTask!.TaskId]</h5>
                    }
                    <button type="button" class="btn-close" @onclick="CloseReportModal"></button>
                </div>
                <div class="modal-body">
                    @if (_reportLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    }
                    else if (_selectedTask?.Status == "failed" && !string.IsNullOrEmpty(_reportContent))
                    {
                        <div class="alert alert-danger">
                            <h6>@L["OpenClaw_TaskFailed"]</h6>
                            <p class="mb-2"><strong>Prompt:</strong> @_selectedTask.Prompt</p>
                            <p class="mb-2"><strong>@L["OpenClaw_FailedAt"]</strong> @_selectedTask.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</p>
                        </div>
                        <div class="error-detail">
                            <h6>@L["OpenClaw_ErrorLog"]</h6>
                            <pre style="background:#1e1e1e;color:#c8d4dc;padding:1rem;border-radius:6px;max-height:500px;overflow:auto;font-size:0.82rem;line-height:1.5;">@_reportContent</pre>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_reportContent))
                    {
                        <div class="markdown-body">
                            <Baihua.Web.Components.MarkdownView Content="@_reportContent" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">@L["OpenClaw_ContentEmpty"]</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseReportModal">@L["OpenClaw_Close"]</button>
                    @if (!string.IsNullOrEmpty(_reportContent))
                    {
                        <button class="btn btn-outline-primary" @onclick="CopyReportAsync">
                            <i class="bi bi-clipboard"></i> @L["OpenClaw_Copy"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<style>
    /* 暗色模式 — OpenClaw 页专属覆盖 */
    [data-bs-theme="dark"] {
        /* 默认模型区域 bg-light 容器 */
        .mb-4.p-3.border.rounded.bg-light {
            background: rgba(255,255,255,0.05) !important;
            border-color: #2d3548 !important;
        }

        /* 模型配置卡片 badge bg-light text-dark border */
        .badge.bg-light.text-dark.border {
            background: rgba(255,255,255,0.08) !important;
            color: #c0c8d0 !important;
            border-color: #3d4558 !important;
        }

        /* 模型列表 table-light 表头 */
        .table-light {
            --bs-table-bg: rgba(255,255,255,0.06);
            --bs-table-color: #c0c8d0;
        }
        .table-light th {
            color: #c0c8d0;
            border-color: #3d4558 !important;
        }
        table.table-bordered,
        .table-bordered th,
        .table-bordered td {
            border-color: #3d4558 !important;
        }

        /* OpenVINO p-3 border rounded 容器 */
        .mb-4.p-3.border.rounded:not(.bg-light) {
            border-color: #2d3548 !important;
        }
    }
</style>

<ConfirmDialog Message="@(pendingTaskConfirm?.Action == "delete" ? L["OpenClaw_ConfirmDeleteTask"] : L["OpenClaw_ConfirmCancelTask"])"
               Visible="@(pendingTaskConfirm != null)"
               OnConfirm="ConfirmTaskAction"
               OnCancel="HideTaskConfirm" />

@code {
    private List<OpenClawTaskDto>? _tasks;
    private string _newPrompt = "";
    private bool _isSubmitting;
    private bool _isLoading;
    private string? _submitError;
    private System.Threading.Timer? _refreshTimer;

    // 报告模态框状态
    private bool _showReportModal;
    private bool _reportLoading;
    private string? _reportContent;
    private OpenClawTaskDto? _selectedTask;

    private bool _canShowLocalConfig = true;
    private bool? _isIntelGpu; // null=未知/加载中（默认不隐藏 OpenVINO）

    // 配置面板状态
    private bool _showConfig;
    private bool _isSavingConfig;
    private bool _isScanningOpenVino;
    private bool _openVinoScanned;
    private bool _isSyncingOpenVino;
    private string? _syncMessage;
    private bool _openVinoDetecting;
    private string? _configError;
    private string? _configSuccess;
    private string? _openVinoStatusMessage;
    private List<string> _openVinoDevices = new();
    private string? _openVinoCommandLine;
    private OpenClawOpenVinoConfigDto _openVinoConfig = new();
    private List<OpenClawLocalModelDto> _openVinoModels = new();

    // 默认模型设置
    private string _selectedDefaultModel = "";
    private List<string> _availableModels = new();
    private bool _isSavingDefaultModel;
    private string? _defaultModelMessage;

    // 模型配置文件
    private List<ModelProfileDto> _modelProfiles = new();
    private string? _currentProfile;
    private string? _profileMessage;

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_newPrompt) && !_isSubmitting && _newPrompt.Length <= 4000;

    protected override void OnInitialized()
    {
        // 先渲染骨架屏，数据在 OnAfterRenderAsync 中后台加载
        _isLoading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 后台并行加载任务列表和配置，不阻塞首屏
        _ = Task.Run(async () =>
        {
            try
            {
                _canShowLocalConfig = await CapabilityService.CanShowAsync("OpenClawLocalConfig");
                try { _isIntelGpu = (await CapabilityService.GetCapabilityAsync()).IsIntelGpu; }
                catch { _isIntelGpu = true; }
                await Task.WhenAll(
                    RefreshTasksAsync(silent: true),
                    LoadConfigAsync()
                );
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "后台加载失败");
            }
            finally
            {
                await InvokeAsync(() =>
                {
                    _isLoading = false;
                    StateHasChanged();
                });
            }
        });

        // 每 5 秒自动刷新
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshTasksAsync(silent: true);
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private void ToggleConfigPanel()
    {
        _showConfig = !_showConfig;
    }

    private async Task LoadConfigAsync()
    {
        var config = await ApiService.GetOpenClawLocalAiConfigAsync();
        _openVinoConfig = config.OpenVino ?? new OpenClawOpenVinoConfigDto();
        _openVinoModels = _openVinoConfig.Enabled && !string.IsNullOrWhiteSpace(_openVinoConfig.ModelPath)
            ? new List<OpenClawLocalModelDto>
            {
                new OpenClawLocalModelDto
                {
                    Id = System.IO.Path.GetFileName(_openVinoConfig.ModelPath.TrimEnd('/', '\\')).Replace(".", "-").ToLowerInvariant(),
                    Name = System.IO.Path.GetFileName(_openVinoConfig.ModelPath.TrimEnd('/', '\\')),
                    ApiType = _openVinoConfig.ApiType,
                    ContextWindow = _openVinoConfig.ContextSize,
                }
            }
            : new List<OpenClawLocalModelDto>();
        _configError = null;
        _configSuccess = null;

        // 加载默认模型
        try
        {
            var defaultModel = await ApiService.GetOpenClawDefaultModelAsync();
            _selectedDefaultModel = defaultModel.CurrentModel ?? "";
            _availableModels = defaultModel.AvailableModels.ToList();
        }
        catch (Exception ex)
        {
            _configError = string.Format(L["OpenClaw_LoadDefaultModelsFailed"], ex.Message);
            _availableModels = new List<string>();
        }

        // 加载模型配置文件
        try
        {
            var profiles = await ApiService.GetModelProfilesAsync();
            _modelProfiles = profiles.Profiles.ToList();
            _currentProfile = profiles.CurrentProfile;
        }
        catch (Exception ex)
        {
            if (string.IsNullOrEmpty(_configError))
                _configError = string.Format(L["OpenClaw_LoadConfigFailed"], ex.Message);
        }

        // 自动检测已启用 provider 的服务状态
        if (_openVinoConfig.Enabled)
            await DetectAndStartAsync("openvino");
    }

    private static bool GetCheckboxValue(ChangeEventArgs e)
    {
        var val = e.Value;
        if (val is bool b) return b;
        if (val is string s) return s.Equals("true", StringComparison.OrdinalIgnoreCase);
        return false;
    }

    private async Task OnOpenVinoEnabledChanged(ChangeEventArgs e)
    {
        _openVinoConfig.Enabled = GetCheckboxValue(e);
        if (!_openVinoConfig.Enabled)
        {
            _openVinoModels.Clear();
            _openVinoScanned = false;
            _openVinoStatusMessage = L["OpenClaw_OpenVinoRemoved"];
            return;
        }
        // 设置默认值
        if (string.IsNullOrWhiteSpace(_openVinoConfig.BaseUrl))
            _openVinoConfig.BaseUrl = "http://localhost:8000";
        if (string.IsNullOrWhiteSpace(_openVinoConfig.ApiType))
            _openVinoConfig.ApiType = "openai-completions";
        if (string.IsNullOrWhiteSpace(_openVinoConfig.Device))
            _openVinoConfig.Device = "CPU";
        if (_openVinoConfig.Port == 0)
            _openVinoConfig.Port = 8000;
        if (_openVinoConfig.ContextSize == 0)
            _openVinoConfig.ContextSize = 4096;
        await DetectAndStartAsync("openvino");
    }

    private async Task DetectAndStartAsync(string provider)
    {
        _openVinoDetecting = true;
        _openVinoStatusMessage = L["OpenClaw_DetectingStatus"];
        await InvokeAsync(StateHasChanged);

        try
        {
            var status = await ApiService.DetectAndStartOpenClawLocalAiAsync(provider);
            _openVinoStatusMessage = status.Message;
            if (status.Devices?.Count > 0)
            {
                _openVinoDevices = status.Devices;
                // 若当前设备不在探测列表中且已有值，保持用户选择；否则取第一个真实设备
                if (string.IsNullOrWhiteSpace(_openVinoConfig.Device) ||
                    (!_openVinoDevices.Contains(_openVinoConfig.Device) && _openVinoConfig.Device == "CPU" && !_openVinoDevices.Contains("CPU")))
                {
                    _openVinoConfig.Device = _openVinoDevices[0];
                }
            }
            _openVinoCommandLine = status.CommandLine;
            if (status.IsRunning)
            {
                await ScanModelsAsync("openvino");
            }
        }
        catch (Exception ex)
        {
            _openVinoStatusMessage = string.Format(L["OpenClaw_DetectFailed"], ex.Message);
        }
        finally
        {
            _openVinoDetecting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ScanOpenVinoModels() => await ScanModelsAsync("openvino");

    private async Task ScanModelsAsync(string provider)
    {
        _isScanningOpenVino = true;
        _openVinoScanned = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            // 先临时保存当前配置以便扫描接口能读到
            var temp = new SaveOpenClawLocalAiConfigRequest
            {
                OpenVino = _openVinoConfig
            };
            await ApiService.SaveOpenClawLocalAiConfigAsync(temp);

            _openVinoModels = await ApiService.ScanOpenClawLocalModelsAsync("openvino");
            _openVinoScanned = true;
        }
        catch (Exception ex)
        {
            _configError = string.Format(L["OpenClaw_ScanFailed"], ex.Message);
        }
        finally
        {
            _isScanningOpenVino = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveConfigAsync()
    {
        _isSavingConfig = true;
        _configError = null;
        _configSuccess = null;
        _defaultModelMessage = null;
        StateHasChanged();

        try
        {
            var request = new SaveOpenClawLocalAiConfigRequest
            {
                OpenVino = _openVinoConfig
            };

            if (_openVinoConfig.Enabled)
            {
                if (string.IsNullOrWhiteSpace(_openVinoConfig.BaseUrl))
                    _openVinoConfig.BaseUrl = "http://localhost:8000";
                if (string.IsNullOrWhiteSpace(_openVinoConfig.ApiType))
                    _openVinoConfig.ApiType = "openai-completions";
                if (string.IsNullOrWhiteSpace(_openVinoConfig.Device))
                    _openVinoConfig.Device = "CPU";
                if (_openVinoConfig.Port == 0)
                    _openVinoConfig.Port = 8000;
                if (_openVinoConfig.ContextSize == 0)
                    _openVinoConfig.ContextSize = 4096;
            }

            var success = await ApiService.SaveOpenClawLocalAiConfigAsync(request);
            if (success)
            {
                _configSuccess = L["OpenClaw_ConfigSaved"];
                // 刷新可用模型列表
                await RefreshAvailableModelsAsync();
            }
            else
            {
                _configError = L["OpenClaw_ConfigSaveFailed"];
            }
        }
        catch (Exception ex)
        {
            _configError = string.Format(L["OpenClaw_SaveFailed"], ex.Message);
        }
        finally
        {
            _isSavingConfig = false;
            StateHasChanged();
        }
    }

    private async Task RefreshAvailableModelsAsync()
    {
        _availableModels.Clear();
        if (_openVinoConfig.Enabled && !string.IsNullOrWhiteSpace(_openVinoConfig.ModelPath))
        {
            var modelName = System.IO.Path.GetFileName(_openVinoConfig.ModelPath.TrimEnd('/', '\\'));
            var modelId = modelName.Replace(".", "-").ToLowerInvariant();
            _availableModels.Add($"openvino/{modelId}");
        }
    }

    private async Task SelectProfileAsync(string profileId)
    {
        _profileMessage = null;
        StateHasChanged();

        try
        {
            var success = await ApiService.SetModelProfileAsync(profileId);
            if (success)
            {
                _currentProfile = profileId;
                var profile = _modelProfiles.FirstOrDefault(p => p.Id == profileId);
                _profileMessage = string.Format(L["OpenClaw_SwitchedProfile"], profile?.Name ?? profileId);
                // 同步更新默认模型下拉框
                _selectedDefaultModel = profile?.Model ?? "";
            }
            else
            {
                _configError = L["OpenClaw_SwitchProfileFailed"];
            }
        }
        catch (Exception ex)
        {
            _configError = string.Format(L["OpenClaw_SwitchProfileFailedDetail"], ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task SaveDefaultModelAsync()
    {
        _isSavingDefaultModel = true;
        _defaultModelMessage = null;
        StateHasChanged();

        try
        {
            var success = await ApiService.SetOpenClawDefaultModelAsync(_selectedDefaultModel);
            if (success)
            {
                _defaultModelMessage = string.IsNullOrWhiteSpace(_selectedDefaultModel)
                    ? L["OpenClaw_RestoredBuiltinDefault"]
                    : string.Format(L["OpenClaw_DefaultModelSet"], _selectedDefaultModel);
                // 检查是否匹配某个 profile
                var matchedProfile = _modelProfiles.FirstOrDefault(p => p.Model == _selectedDefaultModel);
                _currentProfile = matchedProfile?.Id;
            }
            else
            {
                _configError = L["OpenClaw_SetDefaultFailed"];
            }
        }
        catch (Exception ex)
        {
            _configError = string.Format(L["OpenClaw_SetDefaultFailedDetail"], ex.Message);
        }
        finally
        {
            _isSavingDefaultModel = false;
            StateHasChanged();
        }
    }

    private async Task SyncModelsAsync(string provider)
    {
        _isSyncingOpenVino = true;
        _syncMessage = null;
        StateHasChanged();

        try
        {
            var success = await ApiService.SyncLocalModelsToOpenClawAsync(provider);
            if (success)
            {
                _syncMessage = string.Format(L["OpenClaw_Synced"], provider);
                // 刷新可用模型列表
                await RefreshAvailableModelsAsync();
                // 重新加载默认模型选项
                try
                {
                    var defaultModel = await ApiService.GetOpenClawDefaultModelAsync();
                    _availableModels = defaultModel.AvailableModels.ToList();
                }
                catch { }
            }
            else
            {
                _configError = string.Format(L["OpenClaw_SyncFailed"], provider);
            }
        }
        catch (Exception ex)
        {
            _configError = string.Format(L["OpenClaw_SyncFailedDetail"], ex.Message);
        }
        finally
        {
            _isSyncingOpenVino = false;
            StateHasChanged();
        }
    }

    private async Task RefreshTasksAsync(bool silent = false)
    {
        if (!silent)
            _isLoading = true;

        try
        {
            _tasks = await ApiService.GetOpenClawTasksAsync();
        }
        catch (Exception ex)
        {
            if (!silent)
                _submitError = string.Format(L["OpenClaw_RefreshFailed"], ex.Message);
        }
        finally
        {
            if (!silent)
                _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SubmitTaskAsync()
    {
        if (!CanSubmit) return;

        _isSubmitting = true;
        _submitError = null;
        try
        {
            var result = await ApiService.CreateOpenClawTaskAsync(_newPrompt.Trim());
            if (result.Status == "failed" && !string.IsNullOrEmpty(result.ErrorMessage))
            {
                _submitError = result.ErrorMessage;
            }
            else
            {
                _newPrompt = "";
                await RefreshTasksAsync();
            }
        }
        catch (Exception ex)
        {
            _submitError = string.Format(L["OpenClaw_SubmitFailed"], ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private (string Action, int Id)? pendingTaskConfirm;

    private void CancelTaskAsync(int id)
    {
        pendingTaskConfirm = ("cancel", id);
    }

    private void DeleteTaskAsync(int id)
    {
        pendingTaskConfirm = ("delete", id);
    }

    private void HideTaskConfirm()
    {
        pendingTaskConfirm = null;
    }

    private async Task ConfirmTaskAction()
    {
        if (pendingTaskConfirm == null) return;
        var (action, id) = pendingTaskConfirm.Value;
        pendingTaskConfirm = null;

        var success = action == "cancel"
            ? await ApiService.CancelOpenClawTaskAsync(id)
            : await ApiService.DeleteOpenClawTaskAsync(id);
        if (success)
        {
            await RefreshTasksAsync();
        }
    }

    private async Task ViewReportAsync(int id)
    {
        _selectedTask = _tasks?.FirstOrDefault(t => t.Id == id);
        _showReportModal = true;
        _reportLoading = true;
        _reportContent = null;
        StateHasChanged();

        try
        {
            _reportContent = await ApiService.GetOpenClawReportAsync(id);
        }
        catch (Exception ex)
        {
            _reportContent = string.Format(L["OpenClaw_LoadReportFailed"], ex.Message);
        }
        finally
        {
            _reportLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewErrorAsync(int id)
    {
        _selectedTask = _tasks?.FirstOrDefault(t => t.Id == id);
        _showReportModal = true;
        _reportLoading = true;
        _reportContent = null;
        StateHasChanged();

        try
        {
            // 优先使用已存储的错误信息（避免额外 API 调用）
            if (_selectedTask != null && !string.IsNullOrEmpty(_selectedTask.ErrorMessage))
            {
                _reportContent = StripAnsiCodes(_selectedTask.ErrorMessage);
            }
            else
            {
                _reportContent = L["OpenClaw_NoErrorDetail"];
            }
        }
        catch (Exception ex)
        {
            _reportContent = string.Format(L["OpenClaw_LoadErrorFailed"], ex.Message);
        }
        finally
        {
            _reportLoading = false;
            StateHasChanged();
        }
    }

    private static string StripAnsiCodes(string text)
    {
        if (string.IsNullOrEmpty(text)) return text;
        // 移除 ANSI 转义序列 \u001b[...m
        return System.Text.RegularExpressions.Regex.Replace(text, @"\u001b\[[0-9;]*m", "");
    }

    private void CloseReportModal()
    {
        _showReportModal = false;
        _selectedTask = null;
        _reportContent = null;
    }

    private async Task CopyReportAsync()
    {
        if (string.IsNullOrEmpty(_reportContent)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _reportContent);
    }

    private static string GetStatusBadgeClass(string status) => status.ToLowerInvariant() switch
    {
        "completed" => "bg-success",
        "running" => "bg-primary",
        "pending" => "bg-secondary",
        "failed" => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusLabel(string status) => status.ToLowerInvariant() switch
    {
        "completed" => L["OpenClaw_TaskStatus_Completed"],
        "running" => L["OpenClaw_TaskStatus_Running"],
        "pending" => L["OpenClaw_TaskStatus_Pending"],
        "failed" => L["OpenClaw_TaskStatus_Failed"],
        _ => status
    };
