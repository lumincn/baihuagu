@page "/ai-draw"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Baihua.Contracts.Draw
@inject Baihua.Web.Services.IApiService ApiService
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<PageTitle>@L["Draw_Title"]</PageTitle>

<h1>@L["Draw_Title"]</h1>
<p class="text-muted">@L["Draw_Subtitle"]</p>

@if (_status == null)
{
    <div class="alert alert-info">加载中…</div>
}
else if (!_status.ComfyUiOnline)
{
    <div class="alert alert-warning">⚠️ @L["Draw_ComfyOffline"]</div>
}
else
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(_mode == 0 ? "active" : "")" @onclick="() => SwitchMode(0)">@L["Draw_TabImage"]</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(_mode == 1 ? "active" : "")" @onclick="() => SwitchMode(1)">@L["Draw_TabVideo"]</button>
        </li>
    </ul>

    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label small text-muted">@L["Draw_PromptLabel"]</label>
                <textarea class="form-control" rows="3" @bind="_prompt" placeholder="a beautiful landscape, ..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label small text-muted">@L["Draw_NegativePromptLabel"]</label>
                <input class="form-control" @bind="_negativePrompt" />
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-4 col-md-2">
                    <label class="form-label small text-muted">@L["Draw_Width"]</label>
                    <input type="number" class="form-control" @bind="_width" />
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label small text-muted">@L["Draw_Height"]</label>
                    <input type="number" class="form-control" @bind="_height" />
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label small text-muted">@L["Draw_Steps"]</label>
                    <input type="number" class="form-control" @bind="_steps" />
                </div>
                @if (_mode == 1)
                {
                    <div class="col-4 col-md-2">
                        <label class="form-label small text-muted">@L["Draw_Length"]</label>
                        <input type="number" class="form-control" @bind="_length" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small text-muted">@L["Draw_Fps"]</label>
                        <input type="number" class="form-control" @bind="_fps" />
                    </div>
                }
                <div class="col-12 col-md-auto">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="Generate">
                        @(_busy ? "⏳ ..." : @L["Draw_Generate"])
                    </button>
                </div>
            </div>
            @if (_mode == 1)
            {
                <div class="form-text mt-2">@L["Draw_VideoHint"]</div>
            }
        </div>
    </div>

    @if (_busy)
    {
        <div class="alert alert-info">⏳ @L["Draw_Generating"]</div>
    }

    @if (_error != null)
    {
        <div class="alert alert-danger">@L["Draw_GenerateFailed"]：@_error</div>
    }

    @if (_resultFile != null)
    {
        <div class="card">
            <div class="card-header">@L["Draw_Result"]（@_elapsedSeconds 秒）</div>
            <div class="card-body text-center">
                @if (_isVideo)
                {
                    <video controls class="img-fluid" style="max-height: 420px;" src="@_resultUrl"></video>
                }
                else
                {
                    <img class="img-fluid" style="max-height: 420px;" src="@_resultUrl" alt="AI generated" />
                }
                <div class="mt-3">
                    <a class="btn btn-outline-primary" href="@_resultUrl" target="_blank" rel="noopener">@L["Draw_Download"]</a>
                </div>
            </div>
        </div>
    }
}

@code {
    private DrawStatusDto? _status;
    private int _mode; // 0=图 1=视频
    private string _prompt = "";
    private string _negativePrompt = "";
    private int _width = 512;
    private int _height = 512;
    private int _steps = 20;
    private int _length = 97;
    private int _fps = 25;
    private bool _busy;
    private string? _error;
    private string? _resultFile;
    private string? _resultUrl;
    private bool _isVideo;
    private double _elapsedSeconds;

    protected override async Task OnInitializedAsync()
    {
        _status = await ApiService.GetDrawStatusAsync();
    }

    private void SwitchMode(int mode)
    {
        _mode = mode;
        _error = null;
        _resultFile = null;
        _resultUrl = null;
    }

    private async Task Generate()
    {
        if (string.IsNullOrWhiteSpace(_prompt)) return;
        _busy = true;
        _error = null;
        _resultFile = null;
        _resultUrl = null;
        try
        {
            if (_mode == 0)
            {
                var result = await ApiService.GenerateDrawImageAsync(new DrawImageRequest
                {
                    Prompt = _prompt,
                    NegativePrompt = string.IsNullOrWhiteSpace(_negativePrompt) ? null : _negativePrompt,
                    Width = _width,
                    Height = _height,
                    Steps = _steps
                });
                ApplyResult(result, isVideo: false);
            }
            else
            {
                var result = await ApiService.GenerateDrawVideoAsync(new DrawVideoRequest
                {
                    Prompt = _prompt,
                    NegativePrompt = string.IsNullOrWhiteSpace(_negativePrompt) ? null : _negativePrompt,
                    Width = _width,
                    Height = _height,
                    Length = _length,
                    Fps = _fps,
                    Steps = _steps
                });
                ApplyResult(result, isVideo: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyResult(DrawResultDto? result, bool isVideo)
    {
        if (result == null)
        {
            _error = "调用失败（请查看服务日志）";
            return;
        }
        if (!result.Success)
        {
            _error = result.Error ?? "未知错误";
            return;
        }
        _isVideo = isVideo;
        _resultFile = result.FileName;
        _resultUrl = ApiService.GetDrawFileUrl(result.FileName ?? "");
        _elapsedSeconds = result.ElapsedSeconds;
    }
}
