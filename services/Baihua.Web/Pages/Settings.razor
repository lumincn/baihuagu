    private async Task DeleteProvider(AiConfigProvider provider)
    {
        // 原生 confirm 改为站内确认弹窗
        providerToDelete = provider;
    }

    private AiConfigProvider? providerToDelete;

    private void CancelDeleteProvider() => providerToDelete = null;

    private async Task ConfirmDeleteProvider()
    {
        if (providerToDelete == null) return;
        var provider = providerToDelete;
        providerToDelete = null;

        if (await ApiService.DeleteAiConfigProviderAsync(provider.Id))
