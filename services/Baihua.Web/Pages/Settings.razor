@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Baihua.Contracts.LocalModels
@inject Baihua.Web.Services.SettingsService SettingsService
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.AIStatusService AIStatusService
@inject Baihua.Web.Hubs.StatusUpdateService StatusUpdateService
@inject Baihua.Web.Services.CapabilityService CapabilityService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject Microsoft.Extensions.Logging.ILogger<Settings> Logger
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<PageTitle>@L["Settings_PageTitle"]</PageTitle>

<h1>🤖 @L["Settings_Title"]</h1>

<div class="settings-form">
    
    @if (isEditing)
    {
        <!-- 编辑视图 -->
        <div class="ai-edit-form">
            <h4>@(string.IsNullOrEmpty(editingProvider.Id) ? L["Settings_AddProvider"] : L["Settings_EditProvider"])</h4>
            
            @if (string.IsNullOrEmpty(editingProvider.Id))
            {
                <!-- 预设选择 - 仅新建时显示 -->
                <div class="form-group">
                    <label>@L["Settings_SelectPreset"]</label>
                    <select class="form-control" @onchange="OnPresetSelected">
                        <option value="">-- @L["Settings_ManualInput"] --</option>
                        @foreach (var preset in providerPresets)
                        {
                            <option value="@preset.Id">@preset.Name</option>
                        }
                    </select>
                    <small class="form-text">@L["Settings_PresetHint"]</small>
                </div>
            }

            <div class="form-group">
                <label>@L["Settings_ProviderId"]</label>
                <input type="text" class="form-control" @bind="editingProvider.Id" 
                       disabled="@(!string.IsNullOrEmpty(editingProvider.Id))" 
                       placeholder="@L["Settings_ProviderIdPlaceholder"]" />
                <small class="form-text">@L["Settings_ProviderIdHint"]</small>
            </div>

            <div class="form-group">
                <label>@L["Settings_DisplayName"]</label>
                <input type="text" class="form-control" @bind="editingProvider.Name" 
                       placeholder="@L["Settings_DisplayNamePlaceholder"]" />
            </div>

            <div class="form-group">
                <label>@L["Settings_ApiBaseUrl"]</label>
                <input type="text" class="form-control" @bind="editingProvider.BaseUrl" 
                       placeholder="https://api.example.com/v1" />
            </div>

            <div class="form-group">
                <label>@L["Settings_AnthropicUrl"]</label>
                <input type="text" class="form-control" @bind="editingProvider.AnthropicBaseUrl" 
                       placeholder="https://api.anthropic.com" />
                <small class="form-text text-muted">
                    @L["Settings_AnthropicUrlHint"]
                </small>
            </div>

            <div class="form-group">
                <label>@L["Settings_ModelTier"]</label>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(editingProvider.Tier == AiModelTier.Unset ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => editingProvider.Tier = AiModelTier.Unset)">@L["Settings_TierUnset"]</button>
                    <button type="button" class="btn @(editingProvider.Tier == AiModelTier.Tier1_Embedding ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => editingProvider.Tier = AiModelTier.Tier1_Embedding)">@L["Settings_Tier1"]</button>
                    <button type="button" class="btn @(editingProvider.Tier == AiModelTier.Tier2_Local ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => editingProvider.Tier = AiModelTier.Tier2_Local)">@L["Settings_Tier2"]</button>
                    <button type="button" class="btn @(editingProvider.Tier == AiModelTier.Tier3_Cloud ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => editingProvider.Tier = AiModelTier.Tier3_Cloud)">@L["Settings_Tier3"]</button>
                </div>
                <small class="form-text">
                    @L["Settings_TierHint"]
                </small>
            </div>

            <div class="form-group">
                <label>@L["Settings_ApiKey"]</label>
                <input type="password" class="form-control" @bind="editingProvider.ApiKey" 
                       placeholder="sk-..." />
                @if (editingProvider.ExistingKeyMask == "***error***")
                {
                    <div class="text-danger small">⚠ @L["Settings_ApiKeyDecryptError"]</div>
                }
                else if (!string.IsNullOrEmpty(editingProvider.ExistingKeyMask))
                {
                    <small class="form-text">@L["Settings_ApiKeyKeepExisting"]@editingProvider.ExistingKeyMask</small>
                }
                
                <small class="form-text text-muted">
                    @L["Settings_ApiKeyEncryptedHint"]
                </small>
            </div>

            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="editingProvider.IsMain" />
                    <span>@L["Settings_SetAsMainProvider"]</span>
                </label>
            </div>

            <h5>@L["Settings_ModelList"]</h5>
            @if (IsLocalProviderUrl(editingProvider.BaseUrl))
            {
                <div class="mb-2">
                    <button class="btn btn-outline-primary btn-sm" @onclick="AutoFetchModelsAsync" disabled="@isFetchingModels">
                        @if (isFetchingModels)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>@L["Common_Loading"]</span>
                        }
                        else
                        {
                            <span>🔄 @L["Settings_AutoFetchModels"]</span>
                        }
                    </button>
                    @if (isFetchingModels)
                    {
                        <button class="btn btn-outline-danger btn-sm ms-1" @onclick="StopFetchModels">@L["Common_Cancel"]</button>
                    }
                    @if (!string.IsNullOrEmpty(fetchModelsError))
                    {
                        <span class="text-danger ms-2 small">@fetchModelsError</span>
                    }
                </div>
            }
            <div class="models-editor">
                @foreach (var model in editingProvider.Models)
                {
                    <div class="model-edit-row">
                        <input type="text" class="form-control model-name" 
                               @bind="model.Name" placeholder="@L["Settings_ModelNamePlaceholder"]" />
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="model.IsPaid" />
                            <span>@L["Settings_Paid"]</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="model.IsMain" 
                                   @onclick="() => SetMainModel(model)" />
                            <span>@L["Settings_Default"]</span>
                        </label>
                        <button class="btn btn-icon" @onclick="() => RemoveModel(model)">@L["Common_Delete"]</button>
                    </div>
                }
                <button class="btn btn-secondary" @onclick="AddModel">@L["Settings_AddModel"]</button>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveProvider" disabled="@isSaving">
                    @(isSaving ? L["Common_Loading"] : L["Common_Save"])
                </button>
                <button class="btn btn-secondary" @onclick="CancelEdit" disabled="@isSaving">@L["Common_Cancel"]</button>
            </div>

            @if (!string.IsNullOrEmpty(editErrorMessage))
            {
                <div class="alert alert-error">@editErrorMessage</div>
            }
        </div>
    }
    else
    {
        <!-- 本地模型缺失提示 -->
        @if (missingModels.Count > 0)
        {
            <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
                <div style="font-weight: 600; margin-bottom: 0.5rem;">
                    ⚠️ @L["Settings_MissingModelsWarning"]
                </div>
                <div style="margin-bottom: 0.75rem;">
                    @foreach (var group in missingModels.GroupBy(m => m.ProviderName))
                    {
                        <div style="margin-bottom: 0.35rem;">
                            <strong>@group.Key</strong>：
                            <code>@string.Join("</code>, <code>", group.Select(m => m.ModelName))</code>
                        </div>
                    }
                </div>
                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <button class="btn btn-warning btn-sm" @onclick="RemoveMissingModelsAsync" disabled="@isRemovingMissingModels">
                        @if (isRemovingMissingModels)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>@L["Common_Loading"]</span>
                        }
                        else
                        {
                            <span>🗑️ @L["Settings_RemoveMissingModels"]</span>
                        }
                    </button>
                    @if (isRemovingMissingModels)
                    {
                        <button class="btn btn-outline-danger btn-sm ms-1" @onclick="StopRemoveMissingModels">@L["Common_Cancel"]</button>
                    }
                    <button class="btn btn-primary btn-sm" @onclick="GoToLocalModels">
                        @L["Settings_GoToDownloadModels"]
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="DismissMissingModelsWarning">
                        @L["Settings_Dismiss"]
                    </button>
                </div>
            </div>
        }

        <!-- 列表视图 -->
        @if (aiProviders.Count == 0)
        {
            <div class="alert alert-warning">
                @L["Settings_NoProviders"]
            </div>
        }
        else
        {
            <div class="ai-providers-list">
                @foreach (var provider in aiProviders)
                {
                    <div class="ai-provider-card">
                        <div class="provider-header">
                            <div class="provider-title">
                                <span class="provider-name">@provider.Name</span>
                                @if (provider.IsMain)
                                {
                                    <span class="badge badge-primary">@L["Settings_MainBadge"]</span>
                                }
                                @switch (provider.Tier)
                                {
                                    case AiModelTier.Tier1_Embedding:
                                        <span class="badge" style="background:#e8d5f2;color:#6b2c91;">@L["Settings_Tier1"]</span>
                                        break;
                                    case AiModelTier.Tier2_Local:
                                        <span class="badge" style="background:#e0f0e5;color:#3d6b45;">@L["Settings_Tier2"]</span>
                                        break;
                                    case AiModelTier.Tier3_Cloud:
                                        <span class="badge" style="background:#e0ecf4;color:#4a2a30;">@L["Settings_Tier3"]</span>
                                        break;
                                }
                            </div>
                            <div class="provider-actions">
                                <button class="btn btn-icon" @onclick="() => EditProvider(provider)" title="@L["Settings_Edit"]">
                                    @L["Settings_Edit"]
                                </button>
                                <button class="btn btn-icon btn-danger" @onclick="() => DeleteProvider(provider)" title="@L["Common_Delete"]">
                                    @L["Common_Delete"]
                                </button>
                            </div>
                        </div>
                        
                        <div class="provider-info">
                            <code class="provider-id">@provider.Id</code>
                            <span class="provider-url">@provider.BaseUrl</span>
                        </div>

                        <div class="api-key-status">
                            @if (provider.KeyMask == "***error***")
                            {
                                <span class="badge badge-danger" title="@L["Settings_ApiKeyDecryptErrorHint"]">⚠ @L["Settings_ApiKeyDecryptError"]</span>
                            }
                            else if (provider.HasApiKey)
                            {
                                <span class="badge badge-success" title="@L["Settings_ApiKeyEncrypted"]">
                                    @L["Settings_ApiKeyConfigured"]@(provider.KeyMask ?? "***")
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-warning">@L["Settings_ApiKeyNotConfigured"]</span>
                            }
                        </div>

                        <div class="provider-models">
                            @foreach (var model in provider.Models)
                            {
                                <div class="model-item">
                                    <span class="model-name">@(model.Name.Split('/').LastOrDefault() ?? model.Name)</span>
                                    @if (model.IsMain)
                                    {
                                        <span class="badge badge-secondary">@L["Settings_DefaultModel"]</span>
                                    }
                                    @if (model.IsPaid)
                                    {
                                        <span class="badge badge-paid">@L["Settings_PaidModel"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-free">@L["Settings_FreeModel"]</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="list-actions">
            <button class="btn btn-primary" @onclick="AddNewProvider">@L["Settings_AddProviderBtn"]</button>
            <button class="btn btn-secondary" @onclick="ReloadProviders">@L["Common_Refresh"]</button>
        </div>

        <p class="config-note">
            @L["Settings_ApiKeyEncryptedNote"]
        </p>
    }

    <!-- 全局生成详细度（所有 AI 内容生成默认应用，编程任务除外） -->
    <div class="embedding-config-section" style="margin-top: 2rem; padding-top: 1.5rem; border-color: var(--master-border, #2d3548);">
        <h2>📐 @L["Settings_GlobalDetailTitle"]</h2>
        <p style="color: var(--master-text-muted, #91a0b0);font-size:0.9rem;margin-bottom:1rem;">
            @L["Settings_GlobalDetailDescription"]
        </p>
        <div class="form-group">
            <label>@L["Settings_GlobalDetailLabel"]</label>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn @(_globalDetailLevel == "concise" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetGlobalDetailLevel("concise")'>@L["Settings_DetailConcise"]</button>
                <button type="button" class="btn @(_globalDetailLevel == "balanced" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetGlobalDetailLevel("balanced")'>@L["Settings_DetailBalanced"]</button>
                <button type="button" class="btn @(_globalDetailLevel == "comprehensive" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetGlobalDetailLevel("comprehensive")'>@L["Settings_DetailComprehensive"]</button>
            </div>
            <div class="form-text text-muted">
                @(_globalDetailLevel == "concise" ? L["Settings_DetailCountConcise"] : _globalDetailLevel == "comprehensive" ? L["Settings_DetailCountComprehensive"] : L["Settings_DetailCountBalanced"])
            </div>
        </div>
    </div>

    <!-- Embedding 配置（一级·固本模型） -->
    <div class="embedding-config-section" style="margin-top: 2rem; padding-top: 1.5rem; border-color: var(--master-border, #2d3548);">
        <h2>🔍 @L["Settings_EmbeddingConfig"]</h2>
        <p style="color: var(--master-text-muted, #91a0b0);font-size:0.9rem;margin-bottom:1rem;">
            @L["Settings_EmbeddingDescription"]
        </p>
        <div class="form-group">
            <label>@L["Settings_Provider"]</label>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn @(embeddingConfig.ProviderId == "ollama" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SelectEmbeddingProvider("ollama"))">@L["Settings_EmbeddingOllama"]</button>
                <button type="button" class="btn @(embeddingConfig.ProviderId == "openai" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SelectEmbeddingProvider("openai"))">@L["Settings_EmbeddingOpenai"]</button>
                <button type="button" class="btn @(embeddingConfig.ProviderId == "siliconflow" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SelectEmbeddingProvider("siliconflow"))">@L["Settings_EmbeddingSiliconflow"]</button>
                @if (_isIntelGpu != false)
                {
                    <button type="button" class="btn @(embeddingConfig.ProviderId == "openvino" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SelectEmbeddingProvider("openvino"))">@L["Settings_EmbeddingOpenVino"]</button>
                }
                <button type="button" class="btn @(embeddingConfig.ProviderId == "custom" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SelectEmbeddingProvider("custom"))">@L["Settings_EmbeddingCustom"]</button>
            </div>
        </div>
        <div class="form-group">
            <label>@L["Settings_ModelName"]</label>
            <input type="text" class="form-control" @bind="embeddingConfig.Model" placeholder="nomic-embed-text" />
            <small class="form-text">@L["Settings_EmbeddingModelHint"]</small>
        </div>
        <div class="form-group">
            <label>@L["Settings_ApiBaseUrl"]</label>
            <input type="text" class="form-control" @bind="embeddingConfig.BaseUrl" placeholder="http://localhost:11434/v1" />
        </div>
        <div class="form-group">
            <label>@L["Settings_ApiKeyOptional"]</label>
            <input type="password" class="form-control" @bind="embeddingConfig.ApiKey" placeholder="sk-..." />
            @if (!string.IsNullOrEmpty(embeddingConfig.KeyMask))
            {
                <small class="form-text">@L["Settings_ApiKeyConfigured"]@embeddingConfig.KeyMask</small>
            }
        </div>
        <div class="form-group checkbox-group">
            <label class="checkbox-label">
                <input type="checkbox" @bind="embeddingConfig.IsEnabled" />
                <span>@L["Settings_EnableEmbedding"]</span>
            </label>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveEmbeddingConfig" disabled="@isSavingEmbedding">
                @(isSavingEmbedding ? L["Common_Loading"] : L["Settings_SaveEmbedding"])
            </button>
        </div>
        @if (!string.IsNullOrEmpty(embeddingConfigMessage))
        {
            <div class="alert @(embeddingConfigSuccess ? "alert-success" : "alert-error")" style="margin-top: 0.75rem;">
                @embeddingConfigMessage
            </div>
        }
    </div>

    @if (_canShowLocalModelSettings)
    {
    <!-- 本地模型设置 -->
    <div class="local-model-settings" style="margin-top: 2rem; padding-top: 1.5rem; border-color: var(--master-border, #2d3548);">
        <h2>🖥️ @L["Settings_LocalModelSettings"]</h2>
        <div class="form-group">
            <label>@L["Settings_DownloadDir"]</label>
            <input type="text" class="form-control" @bind="localModelDownloadDir"
                   placeholder="@L["Settings_DownloadDirPlaceholder"]" />
            <small class="form-text">
                @L["Settings_DownloadDirDefault"]@platformDefaultDownloadDir
                @if (!string.IsNullOrEmpty(localModelDownloadDir))
                {
                    <span> | @L["Settings_DownloadDirCurrent"]@localModelDownloadDir</span>
                }
            </small>
        </div>
        <div class="form-group">
            <label>@L["Settings_DownloadSource"]</label>
            <div class="btn-group btn-group-sm flex-wrap" role="group">
                <button type="button" class="btn @(preferredDownloadSource == "auto" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => preferredDownloadSource = "auto")">@L["Settings_SourceAuto"]</button>
                <button type="button" class="btn @(preferredDownloadSource == "ollama" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => preferredDownloadSource = "ollama")">Ollama</button>
                <button type="button" class="btn @(preferredDownloadSource == "lmstudio" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => preferredDownloadSource = "lmstudio")">LM Studio</button>
                <button type="button" class="btn @(preferredDownloadSource == "huggingface" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => preferredDownloadSource = "huggingface")">@L["Settings_SourceHuggingface"]</button>
                <button type="button" class="btn @(preferredDownloadSource == "hf-mirror" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => preferredDownloadSource = "hf-mirror")">@L["Settings_SourceHfMirror"]</button>
                <button type="button" class="btn @(preferredDownloadSource == "modelscope" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => preferredDownloadSource = "modelscope")">@L["Settings_SourceModelscope"]</button>
            </div>
        </div>
        <div class="form-group checkbox-group">
            <label class="checkbox-label">
                <input type="checkbox" @bind="useChinaMirror" />
                <span>@L["Settings_UseChinaMirror"]</span>
            </label>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SaveLocalModelConfig" disabled="@isSavingLocalConfig">
                @(isSavingLocalConfig ? L["Common_Loading"] : L["Settings_SaveLocalConfig"])
            </button>
        </div>
        @if (!string.IsNullOrEmpty(localModelConfigMessage))
        {
            <div class="alert @(localModelConfigSuccess ? "alert-success" : "alert-error")" style="margin-top: 0.75rem;">
                @localModelConfigMessage
            </div>
        }
    </div>
    }

</div>

<style>
    /* AI 提供商列表 */
    .ai-providers-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .ai-provider-card {
        background: #f5f8fa;
        border: 1px solid #e8eef2;
        border-radius: 8px;
        padding: 1rem;
    }

    .provider-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .provider-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .provider-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
    }

    .provider-actions {
        display: flex;
        gap: 0.5rem;
    }

    .provider-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
    }

    .provider-id {
        color: #666;
        background: #e8eef2;
        padding: 0.1rem 0.4rem;
        border-radius: 3px;
    }

    .provider-url {
        color: #888;
    }

    .api-key-status {
        margin-bottom: 0.75rem;
    }

    .provider-models {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .model-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.5rem;
        background: white;
        border-radius: 4px;
        border: 1px solid #d8e2e8;
    }

    .model-name {
        flex: 1;
        font-family: monospace;
        font-size: 0.9rem;
        color: #555;
    }

    /* 编辑表单 */
    .ai-edit-form {
        background: #f5f8fa;
        border: 1px solid #e8eef2;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .ai-edit-form h4 {
        margin-top: 0;
        margin-bottom: 1rem;
    }

    .ai-edit-form h5 {
        margin: 1.5rem 0 0.75rem 0;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.35rem;
        font-weight: 500;
        color: #333;
    }

    .form-control {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #c8d4dc;
        border-radius: 4px;
        font-size: 0.95rem;
    }

    .form-control:focus {
        outline: none;
        border-color: #80bdff;
        box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
    }

    .form-text {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.85rem;
        color: #5a6a72;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
        font-weight: normal;
    }

    .models-editor {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .model-edit-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background: white;
        border: 1px solid #d8e2e8;
        border-radius: 4px;
    }

    .model-edit-row .model-name {
        flex: 1;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #d8e2e8;
    }

    .list-actions {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    /* 按钮 */
    .btn {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

