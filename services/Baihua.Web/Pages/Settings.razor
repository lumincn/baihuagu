        public bool IsMain { get; set; }
    }

    // Embedding 配置
    private EmbeddingConfigDto embeddingConfig = new();
    private bool isSavingEmbedding = false;
    private string embeddingConfigMessage = "";
    private bool embeddingConfigSuccess = false;

    private async Task LoadEmbeddingConfigAsync()
    {
        try
        {
            embeddingConfig = await ApiService.GetEmbeddingConfigAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载 Embedding 配置失败");
        }
    }

    /// <summary>
    /// 切换 Embedding 提供商时联动预填默认 Model/BaseUrl
    /// （从 custom 切出总是预填；非 custom 之间切换时若用户已自定义则保留输入）
    /// </summary>
    private void SelectEmbeddingProvider(string provider)
    {
        var prev = embeddingConfig.ProviderId;
        embeddingConfig.ProviderId = provider;

        if (provider == "custom")
        {
            // custom 保留当前值，用户自行填写
            return;
        }

        // 从 custom 切出 → 总是预填新默认值（custom 无预设，旧值不应残留）
        if (prev == "custom")
        {
            ApplyEmbeddingDefaults(provider);
            return;
        }

        // 非 custom 之间切换：仅当用户没自定义过才预填（避免覆盖已输入内容）
        var userCustomized = !string.IsNullOrEmpty(embeddingConfig.Model) && !string.IsNullOrEmpty(embeddingConfig.BaseUrl)
                             && !IsEmbeddingDefault(prev, embeddingConfig.Model, embeddingConfig.BaseUrl);
        if (userCustomized)
            return;

        ApplyEmbeddingDefaults(provider);
    }

    private void ApplyEmbeddingDefaults(string provider)
    {
        switch (provider)
        {
            case "ollama":
                embeddingConfig.Model = "nomic-embed-text";
                embeddingConfig.BaseUrl = "http://localhost:11434/v1";
                embeddingConfig.Dimensions = null;
                break;
            case "openai":
                embeddingConfig.Model = "text-embedding-3-small";
                embeddingConfig.BaseUrl = "https://api.openai.com/v1";
                embeddingConfig.Dimensions = null;
                break;
            case "siliconflow":
                embeddingConfig.Model = "BAAI/bge-large-zh-v1.5";
                embeddingConfig.BaseUrl = "https://api.siliconflow.cn/v1";
                embeddingConfig.Dimensions = null;
                break;
            case "openvino":
                // OpenVINO Model Server (OVMS) 寄存的 bge-small-zh-v1.5 嵌入模型（OpenAI 兼容 /v3/embeddings）
                embeddingConfig.Model = "bge-small-zh";
                embeddingConfig.BaseUrl = "http://127.0.0.1:8000/v3";
                embeddingConfig.Dimensions = 512;
                break;
        }
    }

    /// <summary>判断 Model/BaseUrl 是否为某提供商的默认值（用于检测用户自定义）</summary>
    private static bool IsEmbeddingDefault(string provider, string model, string baseUrl)
    {
        return provider switch
        {
            "ollama" => model == "nomic-embed-text" && baseUrl == "http://localhost:11434/v1",
            "openai" => model == "text-embedding-3-small" && baseUrl == "https://api.openai.com/v1",
            "siliconflow" => model == "BAAI/bge-large-zh-v1.5" && baseUrl == "https://api.siliconflow.cn/v1",
            "openvino" => model == "bge-small-zh" && baseUrl == "http://127.0.0.1:8000/v3",
            _ => false,
        };
    }

    private async Task SaveEmbeddingConfig()
    {
        isSavingEmbedding = true;
        embeddingConfigMessage = "";
        try
        {
            var request = new SaveEmbeddingConfigRequest
            {
                ProviderId = embeddingConfig.ProviderId,
                Model = embeddingConfig.Model,
                BaseUrl = embeddingConfig.BaseUrl,
                ApiKey = string.IsNullOrWhiteSpace(embeddingConfig.ApiKey) ? null : embeddingConfig.ApiKey,
                IsEnabled = embeddingConfig.IsEnabled,
                Dimensions = embeddingConfig.Dimensions
            };
            var result = await ApiService.SaveEmbeddingConfigAsync(request);
            embeddingConfigSuccess = result.Success;
            embeddingConfigMessage = result.Success ? L["Settings_EmbeddingSavedSuccess"] : string.Format(L["Settings_SaveFailedWithMessage"], result.Message);
            if (result.Success)
            {
                // 重新加载以更新 KeyMask
                await LoadEmbeddingConfigAsync();
            }
        }
        catch (Exception ex)
        {
            embeddingConfigSuccess = false;
            embeddingConfigMessage = string.Format(L["Settings_SaveFailedWithMessage"], ex.Message);
        }
        finally
        {
            isSavingEmbedding = false;
        }
    }

    // 本地模型配置
    private string localModelDownloadDir = "";
    private string platformDefaultDownloadDir = "";
    private string preferredDownloadSource = "auto";
    private bool useChinaMirror = true;
    private bool isSavingLocalConfig = false;
    private string localModelConfigMessage = "";
    private bool localModelConfigSuccess = false;

    private async Task LoadLocalModelConfigAsync()
    {
        try
        {
            var config = await ApiService.GetDownloadConfigAsync();
            if (config != null)
            {
                localModelDownloadDir = config.DownloadDirectory ?? "";
                platformDefaultDownloadDir = config.PlatformDefaultDirectory ?? "";
                preferredDownloadSource = config.PreferredSource ?? "auto";
                useChinaMirror = config.UseChinaMirror;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载本地模型配置失败");
        }
    }

    private async Task SaveLocalModelConfig()
    {
        isSavingLocalConfig = true;
        localModelConfigMessage = "";
        try
        {
            var config = new DownloadDirectoryConfigDto
            {
                DownloadDirectory = localModelDownloadDir,
                PreferredSource = preferredDownloadSource,
                UseChinaMirror = useChinaMirror
            };

            var success = await ApiService.SaveDownloadConfigAsync(config);
            localModelConfigSuccess = success;
            localModelConfigMessage = success ? L["Settings_LocalConfigSavedSuccess"] : L["Settings_SaveFailed"];
        }
        catch (Exception ex)
        {
            localModelConfigSuccess = false;
            localModelConfigMessage = string.Format(L["Settings_SaveFailedWithMessage"], ex.Message);
        }
        finally
        {
            isSavingLocalConfig = false;
        }
    }
}
