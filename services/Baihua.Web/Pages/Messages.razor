@page "/messages"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Web
@using Baihua.Web.Services
@using Markdig
@using Baihua.Contracts.LocalModels
@using Microsoft.JSInterop
@inject Baihua.Web.Services.IApiService ApiService
@inject CapabilityService CapabilityService
@inject GlobalStateService GlobalStateService
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@inject ILogger<Messages> Logger
@implements IDisposable

<PageTitle>@L["Messages_PageTitle"]</PageTitle>

<h1>@L["Messages_Title"]</h1>

<div class="ai-info-bar">
    @if (aiStatus?.IsConfigured ?? false)
    {
        <span class="ai-info-badge">
            <span class="ai-info-provider">🏢 @aiStatus?.ProviderName</span>
            <span class="ai-info-sep">·</span>
            <span class="ai-info-model">🤖 @GetShortModelName(aiStatus?.Model)</span>
        </span>
    }
    else
    {
        <span class="ai-info-badge ai-not-ready">@L["Messages_AiNotConfigured"]</span>
    }
    @if (messages.Count > 0)
    {
        <div style="margin-left: auto; display: flex; gap: 0.5rem;">
            <button class="btn btn-sm btn-outline-secondary" @onclick="ExportChatAsync">
                @L["Messages_ExportChat"]
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearChatHistoryAsync">
                @L["Messages_ClearChat"]
            </button>
        </div>
    }
</div>

<div class="chat-container">
    <div class="chat-messages">
        @foreach (var message in messages)
        {
            <StreamingMessage Content="@message.Content"
                              IsUser="@message.IsUser"
                              IsCompleted="@message.IsCompleted"
                              Time="@message.Time"
                              ToolCalls="@(message.ToolCalls.Select(t => t.DisplayName).ToList())"
                              ShowActions="true"
                              Regenerate="() => RegenerateAsync(message)"
                              HighlightOnComplete="true"
                              AddCopyButtons="true"
                              @key="message" />
        }

        @if (isThinking)
        {
            <div class="message ai">
                <div class="message-avatar">🤖</div>
                <div class="message-content">
                    <div class="typing-indicator">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="chat-controls">
        <div class="model-selector-bar">
            <div class="mode-row">
                <label>@L["Messages_Mode"]</label>
                <div class="mode-btn-groups">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(chatMode == "remote" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => OnChatModeChangedSync("remote"))" disabled="@isThinking">@L["Messages_ModeRemote"]</button>
                    </div>
                    <span class="mode-group-sep"></span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(chatMode == "gguf" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => OnChatModeChangedSync("gguf"))" disabled="@isThinking">🦙 GGUF</button>
                        <button type="button" class="btn @(chatMode == "onnx" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => OnChatModeChangedSync("onnx"))" disabled="@isThinking">📦 ONNX</button>
                    </div>
                    <span class="mode-group-sep"></span>
                    <div class="local-tools-group">
                        <span class="mode-group-label">🔧 @L["Messages_LocalTools"]</span>
                        @if (runningLocalModels.Count > 0)
                        {
                            <select class="form-select form-select-sm" value="@selectedRunningModel" @onchange="OnRunningModelChanged" disabled="@isThinking" style="font-size: 0.85rem; max-width: 22rem; width: auto;">
                                <option value="">@L["Messages_SelectRunningModel"]</option>
                                @foreach (var rm in runningLocalModels)
                                {
                                    <option value="@rm.ModelName">@rm.ToolName · @GetShortModelName(rm.DisplayName)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span class="form-text" style="font-size: 0.75rem;">
                                @L["Messages_NoRunningTools"] <a href="local-models" class="link-small">@L["Messages_GoToDeployPage"]</a>
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="content-row">
            @if (chatMode == "remote")
            {
                <div class="selector-group">
                    <label>@L["Messages_Provider"]</label>
                    <select class="form-select" value="@selectedProviderId" @onchange="OnProviderChanged" disabled="@isThinking">
                        @foreach (var provider in providers)
                        {
                            <option value="@provider.Id">@provider.Name @(provider.IsMain ? L["Messages_MainProvider"] : "")</option>
                        }
                    </select>
                </div>
                <div class="selector-group">
                    <label>@L["Messages_Model"]</label>
                    <select class="form-select" @bind="selectedModel" disabled="@isThinking">
                        @if (availableModels.Count == 0)
                        {
                            <option value="">@L["Messages_NoModelsAvailable"]</option>
                        }
                        @foreach (var model in availableModels)
                        {
                            <option value="@model.Name">@GetShortModelName(model.Name) @(model.IsMain ? L["Messages_DefaultModel"] : "")</option>
                        }
                    </select>
                    @if (availableModels.Count == 0 && IsLocalProvider(selectedProviderId))
                    {
                        <a href="settings" class="link-small" style="margin-top: 0.25rem; display: inline-block;">
                            @L["Messages_GoToSettings"]
                        </a>
                    }
                </div>
            }
            else if (chatMode == "gguf" || chatMode == "onnx")
            {
                <div class="selector-group path-group">
                    <label>@L["Messages_ModelPath"]</label>
                    <div style="display: flex; gap: 0.5rem; flex: 1;">
                        <input type="text"
                               class="form-control"
                               @bind="localModelPath"
                               placeholder="@(chatMode == "gguf" ? "/path/to/model.gguf" : "/path/to/onnx/model")"
                               disabled="@isThinking"
                               style="flex: 1; font-size: 0.85rem;" />
                        <button @onclick="ScanLocalModels" class="btn btn-secondary" disabled="@isThinking" style="white-space: nowrap; font-size: 0.85rem;">
                            @L["Messages_Scan"]
                        </button>
                    </div>
                    <div class="form-text engine-info">
                        @if (chatMode == "gguf")
                        {
                            <span>🦙 @L["Messages_GgufEngineInfo"]</span>
                        }
                        else
                        {
                            <span>📦 @L["Messages_OnnxEngineInfo"]</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="selector-group" style="flex: 1;">
                    <label>@L["Messages_RunningLocalModels"]</label>
                    @if (SelectedRunningModelInfo != null)
                    {
                        <span class="form-control" style="flex: 1; font-size: 0.85rem; background: #f5f5f5;">
                            @SelectedRunningModelInfo.ToolName · @SelectedRunningModelInfo.DisplayName
                        </span>
                    }
                    else
                    {
                        <span class="form-text">@L["Messages_NoRunningTools"]</span>
                    }
                </div>
            }
            @if (chatMode == "remote")
            {
                <div class="selector-group" style="align-items: center;">
                    <label>@L["Messages_KnowledgeBase"]</label>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" @bind="useVaultSearch" id="vaultSearchSwitch" disabled="@isThinking">
                        <label class="form-check-label" for="vaultSearchSwitch" style="font-size: 0.85rem;">
                            @(useVaultSearch ? L["Messages_Searching"] : L["Messages_Closed"])
                        </label>
                    </div>
                </div>
            }
            </div>
            <div class="system-prompt-row" style="margin-top: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                    <button type="button" class="btn btn-link btn-sm" @onclick="() => showSystemPrompt = !showSystemPrompt" disabled="@isThinking" style="padding: 0; font-size: 0.85rem; font-weight: 600; text-decoration: none;">
                        <span>@(showSystemPrompt ? "▼" : "▶")</span> @L["Messages_SystemPrompt"]
                    </button>
                    @if (showSystemPrompt && !string.IsNullOrWhiteSpace(systemPrompt))
                    {
                        <span class="badge bg-light text-secondary" style="font-size: 0.7rem;">@(systemPrompt.Length) 字</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => systemPrompt = string.Empty" disabled="@isThinking" style="font-size: 0.72rem; padding: 0.1rem 0.5rem;">清空</button>
                    }
                </div>
                @if (showSystemPrompt)
                {
                    <textarea class="form-control" @bind="systemPrompt" @bind:event="oninput"
                              placeholder="@L["Messages_SystemPromptPlaceholder"]"
                              rows="3" disabled="@isThinking"
                              style="width: 100%; font-size: 0.9rem; line-height: 1.6; resize: none; border-radius: 8px; border: 1px solid #ced4da; padding: 0.6rem 0.75rem; background: #fafafa;"></textarea>
                }
            </div>
        </div>
        @if (localModels.Any())
        {
            <div class="local-model-list">
                @foreach (var model in localModels)
                {
                    <div class="local-model-item @(localModelPath == model.Path ? "active" : "")" @onclick="() => SelectLocalModel(model)">
                        <span class="local-model-type">@model.Type.ToUpper()</span>
                        <span class="local-model-name">@model.Name</span>
                        <span class="local-model-size">@FormatBytes(model.Size)</span>
                    </div>
                }
            </div>
        }
        <div class="chat-input">
            <textarea @bind="inputMessage"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="@L["Messages_InputPlaceholder"]"
                      class="form-control chat-textarea"
                      rows="1"
                      disabled="@isThinking"></textarea>
            @if (isThinking)
            {
                <button @onclick="StopChat" class="btn btn-danger">
                    @L["Messages_Stop"]
                </button>
            }
            else
            {
                <button @onclick="SendMessage" class="btn btn-primary" disabled="@(!CanSend)">
                    @L["Messages_Send"]
                </button>
            }
        </div>
    </div>
</div>

