</style>

@code {
    private string inputMessage = "";
    private bool isThinking = false;
    private List<ChatMessage> messages = new();
    private AIStatusSummary? aiStatus;
    private CancellationTokenSource? _chatCts;
    private string chatSessionId = Guid.NewGuid().ToString("N");

    private List<AiConfigProvider> providers = new();
    private string selectedProviderId = "";
    private string selectedModel = "";

    private string chatMode = "remote";
    private string localModelPath = "";
    private List<LocalModelInfo> localModels = new();
    private bool _canShowLocalModels = true;
    private List<RunningModelDto> runningLocalModels = new();
    private string selectedRunningModel = "";
    private RunningModelDto? SelectedRunningModelInfo =>
        runningLocalModels.FirstOrDefault(m => m.ModelName == selectedRunningModel);
    private bool IsLocalToolMode =>
        chatMode != "remote" && chatMode != "gguf" && chatMode != "onnx";
    private string systemPrompt = "";
    private bool showSystemPrompt = false;

    private List<AiConfigModel> availableModels => providers
        .FirstOrDefault(p => p.Id == selectedProviderId)?.Models ?? new List<AiConfigModel>();

    private bool CanSend => chatMode == "remote"
        ? !isThinking && !string.IsNullOrWhiteSpace(inputMessage) && providers.Any()
        : !isThinking && !string.IsNullOrWhiteSpace(inputMessage) && !string.IsNullOrWhiteSpace(localModelPath);

    protected override void OnInitialized()
    {
        aiStatus = GlobalStateService.GetAIStatus();
        GlobalStateService.StateChanged += OnGlobalStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canShowLocalModels = await CapabilityService.CanShowAsync("MessagesLocalModelSelector");
            await LoadProvidersAsync();
            await LoadRunningLocalModelsAsync();
            await LoadChatHistoryAsync();
        }
        // 复制按钮改由 StreamingMessage 组件在自身渲染后按消息粒度添加，不再全页扫描
    }

    private async Task LoadProvidersAsync()
    {
        providers = await ApiService.GetAiConfigProvidersAsync();

        // 默认选中主提供商；无主提供商则选第一个
        // 若「任务分类模型配置」为通用对话指派了模型，则优先使用该指派（每类一个模型配置）
        string? chatCategoryProviderId = null;
        string? chatCategoryModel = null;
        try
        {
            var categoryConfig = await ApiService.GetAiCategoryConfigAsync();
            var chatResolved = categoryConfig?.Resolved?.FirstOrDefault(r =>
                r.Category.Equals("chat", StringComparison.OrdinalIgnoreCase));
            if (chatResolved != null && !string.IsNullOrEmpty(chatResolved.ModelName))
            {
                chatCategoryProviderId = chatResolved.ProviderId;
                chatCategoryModel = chatResolved.ModelName;
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "读取通用对话分类指派失败，使用主提供方默认");
        }

        var defaultProvider = providers.FirstOrDefault(p =>
                                  p.Id == chatCategoryProviderId)
                              ?? providers.FirstOrDefault(p => p.IsMain)
                              ?? providers.FirstOrDefault();
        if (defaultProvider != null)
        {
            selectedProviderId = defaultProvider.Id;
            string? defaultModel;
            if (defaultProvider.Id == chatCategoryProviderId && !string.IsNullOrEmpty(chatCategoryModel))
            {
                defaultModel = chatCategoryModel;
            }
            else
            {
                defaultModel = defaultProvider.Models.FirstOrDefault(m => m.IsMain)?.Name
                               ?? defaultProvider.Models.FirstOrDefault()?.Name;
            }
            selectedModel = defaultModel ?? "";
        }

        StateHasChanged();
    }

    private void OnGlobalStateChanged(object? sender, EventArgs e)
    {
        aiStatus = GlobalStateService.GetAIStatus();
        InvokeAsync(StateHasChanged);
    }

    private async Task SaveChatHistoryAsync()
    {
        try
        {
            var history = messages.Select(m => new
            {
                m.IsUser,
                m.Content,
                m.Time,
                ToolCalls = m.ToolCalls.Select(t => new { t.Name, t.DisplayName }).ToList()
            }).ToList();
            var json = System.Text.Json.JsonSerializer.Serialize(new { sessionId = chatSessionId, messages = history });
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "chat_history", json);

            await SaveChatPrefsAsync();
        }
        catch { }
    }

    private async Task SaveChatPrefsAsync()
    {
        try
        {
            var prefs = new
            {
                chatMode,
                selectedProviderId,
                selectedModel,
                localModelPath,
                selectedRunningModel,
                systemPrompt
            };
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "chat_prefs",
                System.Text.Json.JsonSerializer.Serialize(prefs));
        }
        catch { }
    }

    private async Task LoadChatHistoryAsync()
    {
        try
        {
            // 恢复上次的模式选择（无记忆则保持默认 remote）
            var prefsJson = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "chat_prefs");
            if (!string.IsNullOrWhiteSpace(prefsJson))
            {
                using var prefsDoc = System.Text.Json.JsonDocument.Parse(prefsJson);
                var prefs = prefsDoc.RootElement;
                if (prefs.TryGetProperty("systemPrompt", out var spProp))
                    systemPrompt = spProp.GetString() ?? "";
                if (prefs.TryGetProperty("chatMode", out var modeProp))
                {
                    var savedMode = modeProp.GetString() ?? "";
                    if (savedMode == "remote")
                    {
                        chatMode = "remote";
                        if (prefs.TryGetProperty("selectedProviderId", out var pidProp))
                            selectedProviderId = pidProp.GetString() ?? selectedProviderId;
                        if (prefs.TryGetProperty("selectedModel", out var mProp))
                            selectedModel = mProp.GetString() ?? selectedModel;
                    }
                    else if (savedMode == "gguf" || savedMode == "onnx")
                    {
                        chatMode = savedMode;
                        if (prefs.TryGetProperty("localModelPath", out var lpProp))
                            localModelPath = lpProp.GetString() ?? "";
                    }
                    else
                    {
                        // 本地工具模式：仅当该工具仍在运行时恢复，否则回退远程
                        if (prefs.TryGetProperty("selectedRunningModel", out var rmProp))
                            selectedRunningModel = rmProp.GetString() ?? "";
                        var info = runningLocalModels.FirstOrDefault(m => m.ModelName == selectedRunningModel);
                        if (info != null)
                        {
                            SelectRunningModel(info);
                        }
                        else
                        {
                            chatMode = "remote";
                            selectedRunningModel = "";
                            localModelPath = "";
                        }
                    }
                    StateHasChanged();
                }
            }

            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "chat_history");
            if (!string.IsNullOrWhiteSpace(json))
            {
                using var doc = System.Text.Json.JsonDocument.Parse(json);
                var root = doc.RootElement;
                if (root.TryGetProperty("sessionId", out var sidProp))
                    chatSessionId = sidProp.GetString() ?? Guid.NewGuid().ToString("N");
                if (root.TryGetProperty("messages", out var msgsProp))
                {
                    var history = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessage>>(msgsProp.GetRawText());
                    if (history != null && history.Count > 0)
                    {
                        messages = history;
                        StateHasChanged();
                        await Task.Yield();
                        try { await JSRuntime.InvokeVoidAsync("hljs.highlightAll"); } catch { }
                    }
                }
            }
        }
        catch { }
    }

    private async Task ClearChatHistoryAsync()
    {
        messages.Clear();
        chatSessionId = Guid.NewGuid().ToString("N");
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "chat_history");
        }
        catch { }
        StateHasChanged();
    }

    private async Task ExportChatAsync()
    {
        if (messages.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine(L["Messages_ExportTitle"]);
        sb.AppendLine(string.Format(L["Messages_ExportTimeFormat"], DateTime.Now));
        sb.AppendLine();
        foreach (var msg in messages)
        {
            var role = msg.IsUser ? L["Messages_ExportUser"] : L["Messages_ExportAI"];
            sb.AppendLine($"## {role} ({msg.Time:HH:mm:ss})");
            sb.AppendLine();
            sb.AppendLine(msg.Content);
            if (msg.ToolCalls.Any())
            {
                sb.AppendLine();
                sb.AppendLine(string.Format(L["Messages_ExportToolCalls"], string.Join(", ", msg.ToolCalls.Select(t => t.DisplayName))));
            }
            sb.AppendLine();
            sb.AppendLine("---");
            sb.AppendLine();
        }

        var markdown = sb.ToString();
        var bytes = System.Text.Encoding.UTF8.GetBytes(markdown);
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"chat-export-{DateTime.Now:yyyyMMdd-HHmmss}.md";

        try
        {
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, $"data:text/markdown;base64,{base64}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"导出失败: {ex.Message}");
        }
    }

    private async Task RegenerateAsync(ChatMessage aiMessage)
    {
        var index = messages.IndexOf(aiMessage);
        if (index <= 0) return;

        // 找到对应的用户消息（AI 消息前一条应该是用户消息）
        var userMessage = messages[index - 1];
        if (!userMessage.IsUser) return;

        // 删除该 AI 消息及之后的所有消息
        while (messages.Count > index)
        {
            messages.RemoveAt(index);
        }

        isThinking = true;
        aiMessage.Content = "";
        aiMessage.ToolCalls.Clear();
        aiMessage.Time = DateTime.Now;
        messages.Add(aiMessage);
        StateHasChanged();

        await SendStreamCoreAsync(userMessage.Content, aiMessage);
    }

    /// <summary>
    /// 核心流式发送逻辑
    /// </summary>
    private async Task SendStreamCoreAsync(string content, ChatMessage aiMessage)
    {
        // 构建历史消息（后端 ChatMemoryService 负责截断和记忆管理）
        var history = messages.Take(messages.Count - 1)
            .Select(m => (m.IsUser, m.Content))
            .ToList();

        _chatCts = new CancellationTokenSource();
        aiMessage.IsCompleted = false;   // 重新生成时复位完成标记（触发子组件完成瞬间高亮）
        try
        {
            if (chatMode == "remote")
            {
                if (useVaultSearch)
                {
                    await foreach (var delta in ApiService.StreamChatWithVaultAsync(content, selectedModel, history, _chatCts.Token))
                    {
                        if (_chatCts.IsCancellationRequested) break;
                        aiMessage.Content += delta;
                        StateHasChanged();
                        await Task.Yield();
                    }
                }
                else
                {
                    await foreach (var evt in ApiService.StreamChatWithEventsAsync(content, selectedProviderId, selectedModel, history, chatSessionId, _chatCts.Token))
                    {
                        if (_chatCts.IsCancellationRequested) break;
                        if (evt.Type == "delta" && !string.IsNullOrEmpty(evt.Content))
                        {
                            aiMessage.Content += evt.Content;
                        }
                        else if (evt.Type == "tool_call")
                        {
                            var displayName = evt.ToolName switch
                            {
                                "search_vault" => L["Messages_ToolSearchVault"],
                                "create_note" => L["Messages_ToolCreateNote"],
                                "get_system_status" => L["Messages_ToolGetSystemStatus"],
                                "get_current_date" => L["Messages_ToolGetCurrentDate"],
                                "list_vaults" => L["Messages_ToolListVaults"],
                                _ => string.Format(L["Messages_ToolCallUnknown"], evt.ToolName)
                            };
                            aiMessage.ToolCalls.Add(new ToolCallInfo { Name = evt.ToolName ?? "", DisplayName = displayName });
                        }
                        StateHasChanged();
                        await Task.Yield();
                    }
                }
            }
            else
            {
                await foreach (var delta in ApiService.StreamLocalChatAsync(content, localModelPath, chatMode, history, systemPrompt, _chatCts.Token))
                {
                    if (_chatCts.IsCancellationRequested) break;
                    aiMessage.Content += delta;
                    StateHasChanged();
                    await Task.Yield();
                }
            }

            if (_chatCts.IsCancellationRequested)
            {
                aiMessage.Content = string.IsNullOrEmpty(aiMessage.Content)
                    ? L["Messages_Stopped"]
                    : aiMessage.Content + "\n\n" + L["Messages_Stopped"];
            }
        }
        catch (OperationCanceledException)
        {
            aiMessage.Content = string.IsNullOrEmpty(aiMessage.Content)
                ? L["Messages_Stopped"]
                : aiMessage.Content + "\n\n" + L["Messages_Stopped"];
        }
        catch (Exception ex)
        {
            aiMessage.Content = string.Format(L["Messages_RequestFailed"], ex.Message);
        }
        finally
        {
            isThinking = false;
            aiMessage.IsCompleted = true;
            _chatCts?.Dispose();
            _chatCts = null;
            StateHasChanged();
            await Task.Yield();
            // 代码高亮改由 StreamingMessage 在完成瞬间对最后一条消息执行 hljs.highlightElement，
            // 不再对全量消息列表 highlightAll
            await SaveChatHistoryAsync();
        }
    }

    private string GetShortModelName(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return L["Messages_DefaultModelName"];
        var parts = fullName.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? parts[^1] : fullName;
    }

    private bool IsLocalProvider(string providerId)
    {
        var provider = providers.FirstOrDefault(p => p.Id == providerId);
        if (provider == null) return false;
        var lower = provider.BaseUrl.ToLowerInvariant();
        return lower.Contains("localhost:11434") || lower.Contains("127.0.0.1:11434") ||
               lower.Contains("localhost:1234") || lower.Contains("127.0.0.1:1234");
    }

    private void OnProviderChanged(ChangeEventArgs e)
    {
        selectedProviderId = e.Value?.ToString() ?? "";
        var provider = providers.FirstOrDefault(p => p.Id == selectedProviderId);
        if (provider != null)
        {
            var defaultModel = provider.Models.FirstOrDefault(m => m.IsMain)
                               ?? provider.Models.FirstOrDefault();
            selectedModel = defaultModel?.Name ?? "";
        }
        else
        {
            selectedModel = "";
        }
        _ = SaveChatPrefsAsync();
    }

    private void OnChatModeChangedSync(string mode)
    {
        chatMode = mode;
        // 切到本地文件模式时，清掉运行中模型（openvino://）残留的路径
        if ((mode == "gguf" || mode == "onnx") && localModelPath.StartsWith("openvino://"))
        {
            localModelPath = "";
            selectedRunningModel = "";
        }
        _ = SaveChatPrefsAsync();
    }

    private async Task LoadRunningLocalModelsAsync()
    {
        try
        {
            runningLocalModels = await ApiService.GetRunningModelsAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"获取运行中本地模型失败: {ex.Message}");
        }
    }

    private void OnRunningModelChanged(ChangeEventArgs e)
    {
        var name = e.Value?.ToString() ?? "";
        var model = runningLocalModels.FirstOrDefault(m => m.ModelName == name);
        if (model != null)
        {
            SelectRunningModel(model);
            _ = SaveChatPrefsAsync();
        }
    }

    private void SelectRunningModel(RunningModelDto model)
    {
        selectedRunningModel = model.ModelName;
        if (model.ToolId.Equals("openvino", StringComparison.OrdinalIgnoreCase))
        {
            localModelPath = $"openvino://{model.ModelName}";
            chatMode = "openvino";
        }
        else if (model.ToolId.Equals("ollama", StringComparison.OrdinalIgnoreCase))
        {
            localModelPath = model.ModelName;
            chatMode = "ollama";
        }
        else
        {
            // llama.cpp / LM Studio 等：尝试用模型名
            localModelPath = model.ModelName;
            chatMode = model.ToolId.ToLowerInvariant();
        }
    }

    private async Task ScanLocalModels()
    {
        localModels = await ApiService.ScanLocalModelsAsync();
        if (!localModels.Any())
        {
            // 如果没有扫描到，尝试扫描用户输入的路径所在目录
            if (!string.IsNullOrWhiteSpace(localModelPath))
            {
                var dir = Path.GetDirectoryName(localModelPath);
                if (!string.IsNullOrWhiteSpace(dir) && Directory.Exists(dir))
                {
                    localModels = await ApiService.ScanLocalModelsAsync(dir);
                }
            }
        }
    }

    private void SelectLocalModel(LocalModelInfo model)
    {
        localModelPath = model.Path;
        chatMode = model.Type.ToLower();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes}B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1}KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1}MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1}GB";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private bool useVaultSearch = false;

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputMessage))
            return;

        messages.Add(new ChatMessage { IsUser = true, Content = inputMessage, Time = DateTime.Now });
        var userMessage = inputMessage;
        inputMessage = "";
        isThinking = true;

        var aiMessage = new ChatMessage { IsUser = false, Content = "", Time = DateTime.Now };
        messages.Add(aiMessage);
        StateHasChanged();

        await SendStreamCoreAsync(userMessage, aiMessage);
    }

    private void StopChat()
    {
        try
        {
            _chatCts?.Cancel();
        }
        catch { }
    }

    public class ChatMessage
    {
        public bool IsUser { get; set; }
        public string Content { get; set; } = "";
        public DateTime Time { get; set; }
        public List<ToolCallInfo> ToolCalls { get; set; } = new();
        /// <summary>流式完成标记：驱动 StreamingMessage 在完成瞬间做单条高亮（仅内存态，不入库）。</summary>
        [System.Text.Json.Serialization.JsonIgnore]
        public bool IsCompleted { get; set; }
    }

    public class ToolCallInfo
    {
        public string Name { get; set; } = "";
        public string DisplayName { get; set; } = "";
    }

    public void Dispose()
    {
        GlobalStateService.StateChanged -= OnGlobalStateChanged;
        try
        {
            _chatCts?.Cancel();
            _chatCts?.Dispose();
        }
        catch { }
    }
}
