@page "/dsh"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@inject DshBridgeService DshSvc
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@implements IDisposable

<PageTitle>@L["Dsh_PageTitle"]</PageTitle>

<div class="container-fluid dsh-app" style="height: calc(100vh - 120px); display: flex; flex-direction: column;">

    <div class="row mb-3 dsh-header align-items-center">
        <div class="col-auto">
            <h4 class="mb-0"><i class="bi bi-robot"></i> @L["Dsh_Title"]</h4>
        </div>
        <div class="col-auto">
            @if (_checkingStatus)
            {
                <span class="badge bg-secondary">@L["Dsh_Checking"]</span>
            }
            else if (_statusOk == true)
            {
                <span class="badge bg-success">DSH @L["Dsh_Online"]</span>
            }
            else
            {
                <span class="badge bg-danger">DSH @L["Dsh_Offline"]</span>
            }
        </div>
        <div class="col">
            <div class="input-group input-group-sm">
                <span class="input-group-text">@L["Dsh_Cwd"]</span>
                <input class="form-control form-control-sm" placeholder="C:\path\to\workspace" @bind="_cwd" />
            </div>
        </div>
        <div class="col-auto">
            <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshStatus">@L["Dsh_Refresh"]</button>
            <button class="btn btn-sm @(_showOps ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleOps" title="百花服务运维（启停/编译/更新）">
                🧰 运维
            </button>
        </div>
    </div>

    @if (_showOps)
    {
        <div class="card mb-3 dsh-ops-card">
            <div class="card-header py-2 d-flex align-items-center justify-content-between">
                <span class="fw-semibold">🧰 百花服务运维</span>
                <span class="d-flex align-items-center gap-2">
                    @if (_bhRunningOps.Count > 0)
                    {
                        <span class="badge bg-warning text-dark">⏳ @_bhRunningOps.Count 个操作进行中</span>
                    }
                    @if (_bhSummary != null)
                    {
                        <span class="badge @(_bhSummary.Ready == _bhSummary.Total ? "bg-success" : "bg-danger")">就绪 @_bhSummary.Ready/@_bhSummary.Total</span>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadBhOpsAsync" disabled="@_bhBusy">🔄 刷新</button>
                </span>
            </div>
            <div class="card-body py-2">
                @if (_bhError != null)
                {
                    <div class="alert alert-warning py-1 small mb-2">@_bhError</div>
                }
                @if (_bhMessage != null)
                {
                    <div class="alert alert-success py-1 small mb-2">@_bhMessage</div>
                }

                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button class="btn btn-sm btn-primary" @onclick="BhBuildAllAsync" disabled="@_bhBusy">🛠 编译（全部）</button>
                    <button class="btn btn-sm btn-warning" @onclick="BhUpdateAsync" disabled="@_bhBusy">⬆️ 一键更新</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="BhDeployAsync" disabled="@_bhBusy">📦 部署</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="RestartDshAsync" disabled="@_bhBusy" title="重启 DSH（DeepSeek Harness）进程，约 10-30 秒后恢复，期间桥接不可用">♻️ 重启 DSH</button>
                    <button class="btn btn-sm btn-outline-success" @onclick="GitCommitPushAsync" disabled="@_bhBusy" title="提交并推送百花仓库（git add -A + commit + push）">⬆️ 提交推送</button>
                </div>

                @if (_bhServices.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 dsh-ops-table">
                            <thead>
                                <tr>
                                    <th>服务</th>
                                    <th>状态</th>
                                    <th>镜像</th>
                                    <th>重启</th>
                                    <th class="text-end">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var svc in _bhServices)
                                {
                                    var online = svc.Ready > 0;
                                    var canStop = svc.Replicas > 0;
                                    <tr>
                                        <td class="fw-semibold">@svc.Name</td>
                                        <td>
                                            <span class="badge @(online ? "bg-success" : "bg-secondary")">@(online ? "● 运行中" : "○ 已停止")</span>
                                            <small class="text-muted ms-1">@svc.Ready/@svc.Replicas · @svc.Phase</small>
                                        </td>
                                        <td><small class="text-muted">@svc.Image</small></td>
                                        <td><small class="text-muted">@svc.Restarts</small></td>
                                        <td class="text-end">
                                            @if (!online)
                                            {
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => BhStartAsync(svc)" disabled="@_bhBusy">▶ 启动</button>
                                            }
                                            @if (canStop)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => BhStopAsync(svc)" disabled="@_bhBusy">⏹ 停止</button>
                                            }
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => BhRestartAsync(svc)" disabled="@_bhBusy">🔄 重启</button>
                                            <button class="btn btn-sm btn-primary" @onclick="() => BhBuildRestartAsync(svc)" disabled="@_bhBusy" title="编译成功后自动滚动重启（适合经常改代码的场景）">🛠 编译并重启</button>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => BhBuildAsync(svc)" disabled="@_bhBusy">🛠 编译</button>
                                            <button class="btn btn-sm btn-outline-info" @onclick="() => ShowLogsAsync(svc.Name)" disabled="@_bhBusy">📋 日志</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!_bhLoading)
                {
                    <div class="text-muted small py-2">暂无服务数据（bh 未启用或不可达？）</div>
                }

                @if (_bhRunningOps.Count > 0)
                {
                    <div class="mt-2 small">
                        <div class="text-muted fw-semibold mb-1">⏳ 进行中</div>
                        @foreach (var op in _bhRunningOps)
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-warning text-dark">运行中</span>
                                <code>@op.Action @op.Service</code>
                                <span class="text-muted">@op.Id</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(op.Tail))
                            {
                                <pre class="dsh-ops-tail">@op.Tail</pre>
                            }
                        }
                    </div>
                }

                @if (_bhRecentOps.Count > 0)
                {
                    <div class="mt-2 small">
                        <div class="text-muted fw-semibold mb-1">✅ 最近完成</div>
                        @foreach (var op in _bhRecentOps)
                        {
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @(op.ExitCode == 0 ? "bg-success" : "bg-danger")">
                                    @(op.ExitCode == 0 ? "成功" : "失败")
                                </span>
                                <code>@op.Action @op.Service</code>
                                <span class="text-muted">@op.Id</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(op.Tail))
                            {
                                <pre class="dsh-ops-tail">@op.Tail</pre>
                            }
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(_logsText))
                {
                    <div class="mt-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted fw-semibold">📋 @_logsService 最近日志</small>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => { _logsText = null; _logsService = null; StateHasChanged(); }">✕</button>
                        </div>
                        <pre class="dsh-ops-logs">@_logsText</pre>
                    </div>
                }
            </div>
        </div>
    }

    @if (!_statusOk && !_checkingStatus)
    {
        <div class="alert alert-warning">
            @L["Dsh_OfflineHint"]
            <pre class="mb-1 mt-1"><code>npx @("@deepseek-ai/dsh") web</code>  <span class="text-muted">@L["Dsh_PortHint"]</span></pre>
            <small class="text-muted">@L["Dsh_PluginHint"]</small>
        </div>
    }

    <div class="row flex-grow-1 g-0 dsh-body" style="min-height: 0;">
        <!-- 左侧：会话列表 -->
        <div class="col-md-3 dsh-sidebar border-end">
            <div class="d-flex justify-content-between align-items-center p-2 border-bottom">
                <strong>@L["Dsh_Sessions"]</strong>
                <button class="btn btn-sm btn-primary" @onclick="NewSession" disabled="@_running">
                    <i class="bi bi-plus-lg"></i> @L["Dsh_New"]
                </button>
            </div>
            <div class="dsh-session-list overflow-auto" style="max-height: calc(100vh - 240px);">
                @if (_sessionLoading)
                {
                    <div class="p-3 text-center text-muted"><span class="spinner-border spinner-border-sm"></span></div>
                }
                else if (_sessions.Count == 0)
                {
                    <div class="p-3 text-muted small">@L["Dsh_NoSessions"]</div>
                }
                else
                {
                    @foreach (var s in _sessions)
                    {
                        var isActive = s.Id == _sessionId;
                        <div class="dsh-session-item @(isActive ? "active" : "") p-2 border-bottom"
                             @onclick="() => OpenSession(s.Id)" style="cursor:pointer">
                            <div class="text-truncate small fw-semibold">
                                <i class="bi bi-chat-square-text me-1"></i>@(s.Title ?? s.Id)
                            </div>
                            <small class="text-muted">
                                @DateTimeOffset.FromUnixTimeMilliseconds(s.UpdatedAt).ToLocalTime().ToString("MM-dd HH:mm")
                                @if (s.MessageCount > 0)
                                {
                                    <span class="badge bg-light text-dark ms-1">@s.MessageCount</span>
                                }
                            </small>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- 中间：对话流 + 输入 -->
        <div class="col d-flex flex-column" style="min-height: 0;">
            <div class="dsh-messages flex-grow-1 overflow-auto p-3" id="dsh-messages" @ref="_messagesRef">
                @if (_messages.Count == 0 && !_running)
                {
                    <div class="text-center text-muted mt-5">
                        <i class="bi bi-chat-dots" style="font-size: 2rem;"></i>
                        <p class="mt-2">@L["Dsh_EmptyHint"]</p>
                    </div>
                }
                @foreach (var m in _messages)
                {
                    <StreamingMessage
                        Content="@m.Content"
                        IsUser="@m.IsUser"
                        IsCompleted="@m.Completed"
                        Time="@m.Time"
                        Avatar="@(m.IsUser ? "🧑" : "🐋")"
                        RoleCss="ai"
                        ToolCalls="@(m.ToolCalls?.Count > 0 ? m.ToolCalls : null)"
                        HighlightOnComplete="true" />
                }
                @if (_running)
                {
                    <div class="dsh-running-indicator text-muted small mt-2">
                        <span class="spinner-border spinner-border-sm me-1"></span>@L["Dsh_Running"]
                    </div>
                }
            </div>

            <!-- 工具调用时间线 -->
            @if (_toolTimeline.Count > 0)
            {
                <div class="dsh-tools border-top bg-light p-2 overflow-auto" style="max-height: 22vh;">
                    <small class="text-muted fw-semibold"><i class="bi bi-tools me-1"></i>@L["Dsh_Tools"]</small>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var t in _toolTimeline)
                        {
                            <span class="badge @(t.IsError ? "bg-danger" : "bg-info text-dark") me-1">@t.Name</span>
                        }
                    </div>
                </div>
            }

            <!-- 输入区 -->
            <div class="dsh-input p-2 border-top d-flex align-items-end gap-2">
                <textarea class="form-control" rows="2" @bind="_input" @bind:event="oninput" placeholder="@L["Dsh_InputPlaceholder"]"
                          disabled="@_running" @onkeydown="OnInputKeyDown" style="resize:none"></textarea>
                <button class="btn btn-primary" @onclick="SendAsync" disabled="@(_running || string.IsNullOrWhiteSpace(_input) || _statusOk != true)">
                    @(_running ? L["Dsh_Working"] : L["Dsh_Send"])
                </button>
                @if (!string.IsNullOrEmpty(_sessionId))
                {
                    <button class="btn btn-outline-danger" @onclick="StopAsync" disabled="@(!_running)">
                        <i class="bi bi-stop-circle"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .dsh-ops-card { font-size: 0.9rem; }
    .dsh-ops-tail { max-height: 120px; overflow: auto; font-size: 0.72rem; background: rgba(0,0,0,0.03); padding: 4px 8px; border-radius: 6px; white-space: pre-wrap; margin-bottom: 4px; }
    .dsh-ops-logs { max-height: 240px; overflow: auto; font-size: 0.75rem; background: rgba(0,0,0,0.04); padding: 8px; border-radius: 6px; white-space: pre-wrap; }
    [data-bs-theme="dark"] .dsh-ops-tail, [data-bs-theme="dark"] .dsh-ops-logs { background: rgba(255,255,255,0.06); }
</style>

@code {
    private bool _checkingStatus;
    private bool _statusOk;
    private bool _sessionLoading;
    private string _cwd = "";
    private string _input = "";
    private string? _sessionId;
    private bool _running;

    // 会话数据
    private List<DshSessionMetaDto> _sessions = new();
    private readonly List<UiMessage> _messages = new();
    private readonly List<ToolBadge> _toolTimeline = new();
    private ElementReference _messagesRef;

    private readonly System.Threading.CancellationTokenSource _pageCts = new();
    // 当前事件流任务（长连接）的取消源，用于“停止”
    private System.Threading.CancellationTokenSource? _streamCts;

    // 百花服务运维（bh）
    private bool _showOps;
    private bool _bhBusy;
    private bool _bhLoading;
    private string? _bhError;
    private string? _bhMessage;
    private List<BhServiceDto> _bhServices = new();
    private BhSummaryDto? _bhSummary;
    private List<BhOpDto> _bhRunningOps = new();
    private List<BhOpDto> _bhRecentOps = new();
    private string? _logsService;
    private string? _logsText;
    private System.Threading.Timer? _opsTimer;

    private sealed record UiMessage(string? Text, bool IsUser, DateTime Time, bool Completed, IReadOnlyList<string>? ToolCalls)
    {
        public string Content => Text ?? "";
    }
    private sealed record ToolBadge(string Name, bool IsError);

    protected override async Task OnInitializedAsync()
    {
        _cwd = DshSvc.TryGetDefaultCwd();
        await RefreshStatus();
        await LoadSessionsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_messages.Count > 0)
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", _messagesRef);
        }
    }

    private async Task RefreshStatus()
    {
        _checkingStatus = true;
        StateHasChanged();
        _statusOk = await DshSvc.GetStatusAsync() is { Ok: true };
        _checkingStatus = false;
        StateHasChanged();
    }

    // ===== 百花服务运维（bh）=====

    private void ToggleOps()
    {
        _showOps = !_showOps;
        if (_showOps)
        {
            _ = LoadBhOpsAsync();
            // 打开后每 10s 自动刷新一次（编译/重启进行中状态实时变化）
            _opsTimer ??= new System.Threading.Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        if (_showOps && _statusOk && !_bhBusy)
                            await LoadBhOpsAsync();
                    });
                }
                catch { /* noop */ }
            }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
        }
        else
        {
            _opsTimer?.Dispose();
            _opsTimer = null;
            StateHasChanged();
        }
    }

    private async Task LoadBhOpsAsync()
    {
        if (!_statusOk) return;
        _bhBusy = true;
        _bhError = null;
        _bhMessage = null;
        _bhLoading = true;
        StateHasChanged();
        try
        {
            var r = await DshSvc.GetBhStatusAsync();
            if (r is { Ok: true, Status: not null })
            {
                _bhServices = (r.Status.Services ?? new List<BhServiceDto>()).ToList();
                _bhSummary = r.Status.Summary;
                _bhRunningOps = (r.RunningOps ?? new List<BhOpDto>()).ToList();
                _bhRecentOps = (r.RecentOps ?? new List<BhOpDto>()).ToList();
            }
            else
            {
                _bhServices = new List<BhServiceDto>();
                _bhSummary = null;
                _bhRunningOps = new List<BhOpDto>();
                _bhRecentOps = new List<BhOpDto>();
                _bhError = r?.Error ?? "获取百花服务状态失败（桥插件未配置 bhCommand？）";
            }
        }
        finally
        {
            _bhLoading = false;
            _bhBusy = false;
            StateHasChanged();
        }
    }

    private Task BhStartAsync(BhServiceDto svc) => RunBhActionAsync("start", svc.Name, false);
    private Task BhStopAsync(BhServiceDto svc) => RunBhActionAsync("stop", svc.Name, true);
    private Task BhRestartAsync(BhServiceDto svc) => RunBhActionAsync("restart", svc.Name, true);
    private Task BhBuildAsync(BhServiceDto svc) => RunBhActionAsync("build", svc.Name, true);
    private Task BhBuildRestartAsync(BhServiceDto svc) => RunBhActionAsync("build-restart", svc.Name, true);
    private Task BhBuildAllAsync() => RunBhActionAsync("build", "", true);
    private Task BhUpdateAsync() => RunBhActionAsync("update", "", true);
    private Task BhDeployAsync() => RunBhActionAsync("deploy", "", true);

    private async Task RunBhActionAsync(string action, string service, bool confirm)
    {        if (_bhBusy) return;
        if (confirm)
        {
            var label = action switch
            {
                "stop" => $"确认停止 {service}？",
                "restart" => $"确认重启 {service}？",
                "build" => string.IsNullOrEmpty(service) ? "确认编译全部镜像（耗时数分钟）？" : $"确认编译 {service} 镜像？",
                "build-restart" => $"确认编译并重启 {service}？（编译成功后会自动滚动重启）",
                "update" => "确认一键更新（git pull + 编译 + 重新部署，耗时较长）？",
                "deploy" => "确认执行部署？",
                _ => $"确认执行 {action}？"
            };
            var ok = await JSRuntime.InvokeAsync<bool>("confirm", label);
            if (!ok) return;
        }
        _bhBusy = true;
        _bhError = null;
        _bhMessage = null;
        StateHasChanged();
        try
        {
            var r = await DshSvc.RunBhActionAsync(action, service);
            if (r is { Ok: true })
            {
                _bhMessage = !string.IsNullOrEmpty(r.OpId)
                    ? $"已开始 {action}{(string.IsNullOrEmpty(service) ? "" : " " + service)}（opId={r.OpId}），可在下方查看进度"
                    : $"{action} {service} 完成：{r.Stdout}";
            }
            else
            {
                _bhError = r?.Error ?? r?.Stderr ?? "操作失败";
            }
            await LoadBhOpsAsync();
        }
        finally
        {
            _bhBusy = false;
            StateHasChanged();
        }
    }

    private async Task RestartDshAsync()
    {
        if (_bhBusy) return;
        var ok = await JSRuntime.InvokeAsync<bool>("confirm", "确认重启 DSH（DeepSeek Harness）？\n\n将终止当前 DSH 进程并重新拉起，约 10-30 秒后恢复；重启期间本页桥接不可用。");
        if (!ok) return;
        _bhBusy = true;
        _bhError = null;
        _bhMessage = null;
        StateHasChanged();
        try
        {
            var r = await DshSvc.RestartDshAsync();
            if (r is { Ok: true })
            {
                _bhMessage = r.Stdout ?? r.Message ?? "已受理重启，DSH 正在后台重启（约 10-30 秒），期间桥接不可用";
            }
            else
            {
                _bhError = r?.Error ?? r?.Stderr ?? "重启请求失败";
            }
        }
        finally
        {
            _bhBusy = false;
            StateHasChanged();
        }
    }

    private async Task GitCommitPushAsync()
    {
        if (_bhBusy) return;
        var message = await JSRuntime.InvokeAsync<string>("prompt", "提交信息（git commit -m）：");
        if (message == null) return;
        message = message.Trim();
        if (string.IsNullOrWhiteSpace(message))
        {
            _bhError = "提交信息不能为空";
            StateHasChanged();
            return;
        }
        var ok = await JSRuntime.InvokeAsync<bool>("confirm", $"确认提交并推送「{message}」？\n\n将执行 git add -A + commit + push（后台执行，可在下方查看进度）。");
        if (!ok) return;
        _bhBusy = true;
        _bhError = null;
        _bhMessage = null;
        StateHasChanged();
        try
        {
            var r = await DshSvc.GitCommitPushAsync(message);
            if (r is { Ok: true })
            {
                _bhMessage = !string.IsNullOrEmpty(r.OpId)
                    ? $"已开始提交并推送（opId={r.OpId}），可在下方查看进度"
                    : r.Message ?? r.Stdout ?? "已受理提交推送";
            }
            else
            {
                _bhError = r?.Error ?? r?.Stderr ?? "提交推送请求失败";
            }
            await LoadBhOpsAsync();
        }
        finally
        {
            _bhBusy = false;
            StateHasChanged();
        }
    }

    private async Task ShowLogsAsync(string service)
    {
        if (_bhBusy) return;
        _bhBusy = true;
        _bhError = null;
        StateHasChanged();
        try
        {
            var logs = await DshSvc.GetBhLogsAsync(service, 80);
            _logsService = service;
            _logsText = logs ?? "获取日志失败（桥不可达？）";
        }
        finally
        {
            _bhBusy = false;
            StateHasChanged();
        }
    }

    private async Task LoadSessionsAsync()
    {
        _sessionLoading = true;
        StateHasChanged();
        _sessions = (await DshSvc.GetSessionsAsync()).ToList();
        _sessionLoading = false;
        StateHasChanged();
    }

    /// <summary>文本框按键：Enter（不含 Shift）发送；Shift+Enter 走默认行为换行。</summary>
    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    /// <summary>新建会话：重设本地状态，延后到首次发送时经 WS 建立。</summary>
    private async Task NewSession()
    {
        if (_running) return;
        await StopStreamAsync();
        _sessionId = null;
        _messages.Clear();
        _toolTimeline.Clear();
        _input = "";
        StateHasChanged();
    }

    /// <summary>打开历史会话：订阅 WS + 拉取历史。</summary>
    private async Task OpenSession(string id)
    {
        if (_running) return;
        await StopStreamAsync();
        _sessionId = id;
        _messages.Clear();
        _toolTimeline.Clear();
        StateHasChanged();

        StartStream(id);

        var history = await DshSvc.GetHistoryAsync(id);
        if (history?.Events is { } evts)
        {
            RenderHistory(evts);
        }
        StateHasChanged();
    }

    /// <summary>把历史事件转成可渲染消息。</summary>
    private void RenderHistory(IReadOnlyList<DshStreamFrame> events)
    {
        _messages.Clear();
        _toolTimeline.Clear();
        foreach (var e in events)
        {
            if (e.Type == "user/message")
            {
                var text = e.Data?.TryGetProperty("text", out var t) == true ? t.GetString() : "";
                if (!string.IsNullOrWhiteSpace(text))
                    _messages.Add(new UiMessage(text, true, DateTimeOffset.FromUnixTimeMilliseconds(e.Time).LocalDateTime, true, null));
            }
            else if (e.Type == "assistant/message")
            {
                var text = e.Data?.TryGetProperty("text", out var t) == true ? t.GetString() : "";
                var tools = e.Data?.TryGetProperty("toolCalls", out var tc) == true
                    ? tc.EnumerateArray().Select(x => x.TryGetProperty("name", out var n) ? n.GetString() ?? "" : "").Where(s => s.Length > 0).ToList()
                    : new List<string>();
                if (!string.IsNullOrWhiteSpace(text) || tools.Count > 0)
                    _messages.Add(new UiMessage(text, false, DateTimeOffset.FromUnixTimeMilliseconds(e.Time).LocalDateTime, true, tools));
            }
        }
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (string.IsNullOrEmpty(text) || _running || _statusOk != true) return;
        _running = true;
        _input = "";
        StateHasChanged();

        try
        {
            // 新建会话：先经 WS 建立拿到 sessionId
            if (string.IsNullOrEmpty(_sessionId))
            {
                await EstablishNewSessionAsync();
            }

            if (string.IsNullOrEmpty(_sessionId)) throw new InvalidOperationException("无法建立会话");

            // 记录用户消息
            _messages.Add(new UiMessage(text, true, DateTime.Now, true, null));
            StateHasChanged();

            // 提交任务（非阻塞：插件后台执行，过程经 WS 推送）
            var result = await DshSvc.SendMessageAsync(text, _cwd, _sessionId);
            if (!result.Ok)
            {
                _messages.Add(new UiMessage($"⚠️ {result.Error}", false, DateTime.Now, true, null));
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new UiMessage($"⚠️ {ex.Message}", false, DateTime.Now, true, null));
        }
        finally
        {
            _running = false;
            StateHasChanged();
        }
    }

    /// <summary>启动（或新建）当前会话的事件流订阅。若 <paramref name="sessionId"/> 为空则由插件新建。</summary>
    private void StartStream(string? sessionId, TaskCompletionSource<string?>? sessionTcs = null)
    {
        awaitStopIfNeeded();
        _streamCts = new System.Threading.CancellationTokenSource();
        var ct = _streamCts.Token;
        var tcs = sessionTcs;
        _ = Task.Run(async () =>
        {
            try
            {
                await DshSvc.StreamEventsAsync(sessionId, _cwd, frame => InvokeStreamFrameAsync(frame, tcs), ct);
            }
            catch (OperationCanceledException) { /* 用户停止 */ }
            catch (Exception) { /* 流异常结束，UI 通过 closed/error 帧处理 */ }
        });
    }

    /// <summary>新建一个会话：启动无 sessionId 的流，等插件返回 sessionId。</summary>
    private async Task EstablishNewSessionAsync()
    {
        var tcs = new TaskCompletionSource<string?>(System.Threading.Tasks.TaskCreationOptions.RunContinuationsAsynchronously);
        StartStream(null, tcs);
        var sid = await tcs.Task.WaitAsync(TimeSpan.FromSeconds(30));
        if (!string.IsNullOrEmpty(sid)) _sessionId = sid;
        StateHasChanged();
    }

    private void awaitStopIfNeeded()
    {
        _ = StopStreamAsync();
    }

    private async Task InvokeStreamFrameAsync(DshStreamFrame frame, TaskCompletionSource<string?>? sessionTcs = null)
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (frame.Kind == "session")
                {
                    if (!string.IsNullOrEmpty(frame.SessionId)) _sessionId = frame.SessionId;
                    sessionTcs?.TrySetResult(frame.SessionId);
                    StateHasChanged();
                }
                else if (frame.Kind == "connected")
                {
                    if (_sessionId is null) _sessionId = frame.SessionId;
                    StateHasChanged();
                }
                else if (frame.Kind == "closed" || frame.Kind == "error")
                {
                    if (_running)
                    {
                        _running = false;
                        if (_messages.Count > 0 && !_messages[^1].IsUser && !_messages[^1].Completed)
                            _messages[^1] = _messages[^1] with { Completed = true };
                    }
                    StateHasChanged();
                }
                else if (frame.Type is { } type)
                {
                    HandleSessionEvent(frame);
                    if (type == "turn/end" && _running) _running = false;
                    StateHasChanged();
                }
            });
        }
        catch (Exception)
        {
            // UI 线程已销毁等场景，忽略
        }
    }

    private void HandleSessionEvent(DshStreamFrame frame)
    {
        switch (frame.Type)
        {
            case "assistant/chunk":
            {
                var chunkType = frame.Data?.TryGetProperty("chunkType", out var ct) == true ? ct.GetString() : "";
                if (chunkType == "text-delta")
                {
                    var delta = frame.Data?.TryGetProperty("text", out var t) == true ? t.GetString() ?? "" : "";
                    if (_messages.Count == 0 || _messages[^1].IsUser)
                        _messages.Add(new UiMessage("", false, DateTime.Now, false, null));
                    var last = _messages[^1];
                    _messages[^1] = last with { Text = last.Text + delta };
                }
                break;
            }
            case "assistant/message":
            {
                var text = frame.Data?.TryGetProperty("text", out var t) == true ? t.GetString() ?? "" : "";
                var tools = frame.Data?.TryGetProperty("toolCalls", out var tc) == true
                    ? tc.EnumerateArray().Select(x => x.TryGetProperty("name", out var n) ? n.GetString() ?? "" : "").Where(s => s.Length > 0).ToList()
                    : new List<string>();
                // 替换最后一条正在流式的消息，或追加
                if (_messages.Count > 0 && !_messages[^1].IsUser && !_messages[^1].Completed)
                {
                    _messages[^1] = new UiMessage(text, false, _messages[^1].Time, true, tools);
                }
                else if (!string.IsNullOrWhiteSpace(text) || tools.Count > 0)
                {
                    _messages.Add(new UiMessage(text, false, DateTime.Now, true, tools));
                }
                break;
            }
            case "user/message":
            {
                var text = frame.Data?.TryGetProperty("text", out var t) == true ? t.GetString() ?? "" : "";
                if (!string.IsNullOrWhiteSpace(text) && (_messages.Count == 0 || _messages[^1].IsUser == false))
                    _messages.Add(new UiMessage(text, true, DateTime.Now, true, null));
                break;
            }
            case "tool/call":
            {
                var name = frame.Data?.TryGetProperty("name", out var n) == true ? n.GetString() ?? "" : "";
                if (!string.IsNullOrWhiteSpace(name))
                    _toolTimeline.Insert(0, new ToolBadge(name, false));
                break;
            }
            case "tool/result":
            {
                var isErr = frame.Data?.TryGetProperty("isError", out var er) == true && er.GetBoolean();
                if (isErr)
                {
                    var name = _toolTimeline.FirstOrDefault()?.Name ?? "tool";
                    _toolTimeline.Insert(0, new ToolBadge(name, true));
                }
                break;
            }
            case "turn/end":
            {
                // 回合结束：完结最后一条未完成消息
                if (_messages.Count > 0 && !_messages[^1].IsUser && !_messages[^1].Completed)
                    _messages[^1] = _messages[^1] with { Completed = true };
                _running = false;
                break;
            }
        }
    }

    private async Task StopAsync()
    {
        await StopStreamAsync();
        _running = false;
        if (_messages.Count > 0 && !_messages[^1].IsUser && !_messages[^1].Completed)
            _messages[^1] = _messages[^1] with { Completed = true };
        StateHasChanged();
    }

    /// <summary>取消当前事件流（后台 StreamEventsAsync 会 abort socket）。</summary>
    private async Task StopStreamAsync()
    {
        try
        {
            _streamCts?.Cancel();
            _streamCts?.Dispose();
        }
        catch { }
        _streamCts = null;
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        try { _streamCts?.Cancel(); } catch { }
        _pageCts.Cancel();
        _pageCts.Dispose();
        _opsTimer?.Dispose();
    }
}
