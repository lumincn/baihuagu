@page "/hardware-benchmark"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Baihua.Contracts.LocalModels
@using Microsoft.Extensions.Localization
@inject Baihua.Web.Services.IApiService ApiService
@inject Microsoft.Extensions.Logging.ILogger<HardwareBenchmark> Logger
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@implements IDisposable

<PageTitle>@L["HardwareBenchmark_PageTitle"]</PageTitle>

<h1>🖥️ @L["HardwareBenchmark_Title"]</h1>

<p class="text-muted">
    @L["HardwareBenchmark_Description"]
</p>

@if (isLoading)
{
    <div class="loading-spinner">@L["HardwareBenchmark_Detecting"]</div>
}
else
{
    <!-- 当前机器概览 -->
    <div class="section current-machine">
        <h2>📋 @L["HardwareBenchmark_MachineConfig"]</h2>
        <div class="machine-cards">
            <div class="machine-card @(GetMachineTierClass())">
                <div class="card-header">
                    <span class="platform-icon">💻</span>
                    <span class="platform-name">@L["HardwareBenchmark_CurrentMachineLabel"]</span>
                    <span class="tier-badge">@GetMachineTierLabel()</span>
                </div>
                <div class="spec-grid">
                    <div class="spec-item">
                        <span class="spec-label">CPU</span>
                        <span class="spec-value">@(DisplayCpuName(hardwareInfo?.Cpu.Name) ?? L["HardwareBenchmark_Unknown"])</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@L["HardwareBenchmark_CoreCount"]</span>
                        <span class="spec-value">@(hardwareInfo?.Cpu.LogicalProcessorCount ?? 0) @L["HardwareBenchmark_CoreUnit"]</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@L["HardwareBenchmark_Memory"]</span>
                        <span class="spec-value">@(hardwareInfo?.Memory.TotalGiB.ToString("F1") ?? "-") GB</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@L["HardwareBenchmark_Gpu"]</span>
                        <span class="spec-value">@(GetGpuSummary())</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@L["HardwareBenchmark_System"]</span>
                        <span class="spec-value">@(hardwareInfo?.OsPlatform ?? "-") @(hardwareInfo?.IsWsl == true ? "(WSL)" : "")</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">@L["HardwareBenchmark_DiskAvailable"]</span>
                        <span class="spec-value">@GetDiskGiB(hardwareInfo?.AvailableDiskSpaceBytes) GB</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- AI 算力对比表 -->
    <div class="section comparison-section">
        <h2>⚡ @L["HardwareBenchmark_ComparisonTitle"]</h2>
        <p class="section-desc">@L["HardwareBenchmark_ComparisonDesc"]</p>

        <div class="table-wrapper">
            <table class="comparison-table">
                <thead>
                    <tr>
                        <th class="col-rank">@L["HardwareBenchmark_Col_Rank"]</th>
                        <th class="col-platform">@L["HardwareBenchmark_Col_Platform"]</th>
                        <th class="col-gpu">@L["HardwareBenchmark_Col_Gpu"]</th>
                        <th class="col-memory">@L["HardwareBenchmark_Col_Memory"]</th>
                        <th class="col-tops">@L["HardwareBenchmark_Col_Int8"]</th>
                        <th class="col-tops">@L["HardwareBenchmark_Col_Int4"]</th>
                        <th class="col-bandwidth">@L["HardwareBenchmark_Col_Bandwidth"]</th>
                        <th class="col-speed">@L["HardwareBenchmark_Col_Speed"]</th>
                        <th class="col-power">@L["HardwareBenchmark_Col_Power"]</th>
                        <th class="col-price">@L["HardwareBenchmark_Col_Price"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in sortedPlatforms)
                    {
                        <tr class="@(item.IsCurrentMachine ? "current-row" : "")">
                            <td class="col-rank">
                                @if (item.Rank == 1)
                                {
                                    <span>🥇</span>
                                }
                                else if (item.Rank == 2)
                                {
                                    <span>🥈</span>
                                }
                                else if (item.Rank == 3)
                                {
                                    <span>🥉</span>
                                }
                                else
                                {
                                    <span>@item.Rank</span>
                                }
                            </td>
                            <td class="col-platform">
                                <div class="platform-cell">
                                    <span class="platform-badge @item.BadgeClass">@item.VendorEmoji @item.Vendor</span>
                                    <span class="platform-model">@item.ModelName</span>
                                </div>
                            </td>
                            <td class="col-gpu">@((MarkupString)item.GpuInfo)</td>
                            <td class="col-memory">@((MarkupString)item.MemoryInfo)</td>
                            <td class="col-tops">
                                @if (!string.IsNullOrEmpty(item.TflopsInt8Info))
                                {
                                    <span class="tops-value">@item.TflopsInt8Info</span>
                                }
                                else
                                {
                                    <span class="sub-text">-</span>
                                }
                            </td>
                            <td class="col-tops">
                                @if (!string.IsNullOrEmpty(item.TflopsInt4Info))
                                {
                                    <span class="tops-value">@item.TflopsInt4Info</span>
                                }
                                else
                                {
                                    <span class="sub-text">-</span>
                                }
                            </td>
                            <td class="col-bandwidth">@item.BandwidthInfo</td>
                            <td class="col-speed">
                                <span class="speed-value @(GetSpeedClass(item.EstimatedTokensPerSecond))">@item.SpeedInfo</span>
                            </td>
                            <td class="col-power">@item.PowerInfo</td>
                            <td class="col-price">@item.PriceInfo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="data-source-note">
            <h5>@L["HardwareBenchmark_DataSourceTitle"]</h5>
            <ul>
                <li><strong>@L["HardwareBenchmark_DataGpuSpecLabel"]</strong>@L["HardwareBenchmark_DataGpuSpecValue"]</li>
                <li><strong>@L["HardwareBenchmark_DataBandwidthLabel"]</strong>@L["HardwareBenchmark_DataBandwidthValue"]</li>
                <li><strong>@L["HardwareBenchmark_DataEstimateLabel"]</strong>@L["HardwareBenchmark_DataEstimateValue1"]<code>@L["HardwareBenchmark_DataEstimateFormula"]</code>@L["HardwareBenchmark_DataEstimateValue2"]<strong>0.13</strong>@L["HardwareBenchmark_DataEstimateValue3"]<strong>0.16</strong>@L["HardwareBenchmark_DataEstimateValue4"]<strong>0.08</strong>
                </li>
                <li><strong>@L["HardwareBenchmark_DataBaselineLabel"]</strong>@L["HardwareBenchmark_DataBaselineValue"]</li>
                <li><strong>@L["HardwareBenchmark_DataLimitLabel"]</strong>@L["HardwareBenchmark_DataLimitValue"]</li>
            </ul>
        </div>
    </div>

    <!-- 性能等级说明 -->
    <div class="section tier-explanation">
        <h2>📊 @L["HardwareBenchmark_TierTitle"]</h2>
        <div class="tier-cards">
            <div class="tier-card tier-cpu">
                <div class="tier-title">🐢 @L["HardwareBenchmark_TierCpuTitle"]</div>
                <div class="tier-range">@L["HardwareBenchmark_TierCpuRange"]</div>
                <div class="tier-desc">@L["HardwareBenchmark_TierCpuDesc"]</div>
            </div>
            <div class="tier-card tier-entry">
                <div class="tier-title">🐇 @L["HardwareBenchmark_TierEntryTitle"]</div>
                <div class="tier-range">@L["HardwareBenchmark_TierEntryRange"]</div>
                <div class="tier-desc">@L["HardwareBenchmark_TierEntryDesc"]</div>
            </div>
            <div class="tier-card tier-mid">
                <div class="tier-title">🦌 @L["HardwareBenchmark_TierMidTitle"]</div>
                <div class="tier-range">@L["HardwareBenchmark_TierMidRange"]</div>
                <div class="tier-desc">@L["HardwareBenchmark_TierMidDesc"]</div>
            </div>
            <div class="tier-card tier-high">
                <div class="tier-title">🐆 @L["HardwareBenchmark_TierHighTitle"]</div>
                <div class="tier-range">@L["HardwareBenchmark_TierHighRange"]</div>
                <div class="tier-desc">@L["HardwareBenchmark_TierHighDesc"]</div>
            </div>
            <div class="tier-card tier-pro">
                <div class="tier-title">🚀 @L["HardwareBenchmark_TierProTitle"]</div>
                <div class="tier-range">@L["HardwareBenchmark_TierProRange"]</div>
                <div class="tier-desc">@L["HardwareBenchmark_TierProDesc"]</div>
            </div>
        </div>
    </div>

    <!-- 适用场景建议 -->
    <div class="section scenario-section">
        <h2>🎯 @L["HardwareBenchmark_ScenarioTitle"]</h2>
        @if (recommendations.Count == 0)
        {
            <div class="alert alert-info">@L["HardwareBenchmark_Analyzing"]</div>
        }
        else
        {
            <div class="recommendation-list">
                @foreach (var rec in recommendations)
                {
                    <div class="recommendation-item @rec.LevelClass">
                        <div class="rec-icon">@rec.Icon</div>
                        <div class="rec-content">
                            <div class="rec-title">@rec.Title</div>
                            <div class="rec-desc">@rec.Description</div>
                        </div>
                        <div class="rec-badge @rec.LevelClass">@rec.LevelText</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="section refresh-section">
        <button class="btn btn-secondary" @onclick="RefreshHardware" disabled="@isLoading">
            @(isLoading ? L["HardwareBenchmark_Refreshing"] : L["HardwareBenchmark_Refresh"])
        </button>
        <span class="text-muted" style="margin-left: 1rem; font-size: 0.85rem;">
            @L["HardwareBenchmark_DataDisclaimer"]
        </span>
    </div>
}

@code {
    private bool isLoading = true;
    private HardwareInfoDto? hardwareInfo;
    private List<RecommendationItem> recommendations = new();
    private List<PlatformComparisonItem> sortedPlatforms = new();

    /// <summary>CPU 名称为 Unknown 时降级显示（Windows 上报 Unknown X64 CPU 不友好）</summary>
    private string? DisplayCpuName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return null;
        var n = name.Trim();
        if (n.StartsWith("Unknown", StringComparison.OrdinalIgnoreCase))
            return L["HardwareBenchmark_UnknownCpu"];
        return n;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadHardwareInfoAsync();
    }

    private async Task LoadHardwareInfoAsync()
    {
        isLoading = true;
        try
        {
            hardwareInfo = await ApiService.GetHardwareInfoAsync();
            BuildSortedPlatforms();
            GenerateRecommendations();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "获取硬件信息失败");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshHardware()
    {
        await LoadHardwareInfoAsync();
    }

    /// <summary>
    /// 构建本机 + 参考平台的合并列表，按估算速度排序
    /// </summary>
    private void BuildSortedPlatforms()
    {
        var platforms = new List<PlatformComparisonItem>();

        // ---- 本机 ----
        var currentGpu = hardwareInfo?.Gpus?.FirstOrDefault();
        double currentSpeed = 0;
        if (currentGpu?.EstimatedTokensPerSecond.HasValue == true)
            currentSpeed = currentGpu.EstimatedTokensPerSecond.Value;
        else if (hardwareInfo?.EstimatedCpuTokensPerSecond.HasValue == true)
            currentSpeed = hardwareInfo.EstimatedCpuTokensPerSecond.Value;

        var currentComputeUnits = currentGpu?.ComputeUnits.HasValue == true
            ? $"{currentGpu.ComputeUnits} {(currentGpu.Vendor == "NVIDIA" ? "CUDA" : currentGpu.Vendor == "AMD" ? "CU" : currentGpu.Vendor == "Intel" ? "Xe" : L["HardwareBenchmark_CoreUnit"])}"
            : (currentGpu != null ? L["HardwareBenchmark_Unknown"] : "-");

        platforms.Add(new PlatformComparisonItem
        {
            IsCurrentMachine = true,
            Vendor = L["HardwareBenchmark_LocalMachine"],
            VendorEmoji = "💻",
            BadgeClass = "current",
            ModelName = L["HardwareBenchmark_CurrentMachine"],
            GpuInfo = currentGpu != null
                ? $"{currentGpu.Name}<br><span class=\"sub-text\">{currentComputeUnits}</span>"
                : $"{L["HardwareBenchmark_NoDiscreteGpu"]}<br><span class=\"sub-text\">{L["HardwareBenchmark_CpuInferenceHint"]}</span>",
            MemoryInfo = currentGpu?.VramGiB.HasValue == true
                ? $"{currentGpu.VramGiB:F0} GB<br><span class=\"sub-text\">{(currentGpu.IsIntegrated ? L["HardwareBenchmark_SharedMemory"] : L["HardwareBenchmark_DedicatedVram"])}</span>"
                : $"{hardwareInfo?.Memory.TotalGiB:F0} GB<br><span class=\"sub-text\">{L["HardwareBenchmark_SystemMemory"]}</span>",
            TflopsInt8Info = currentGpu?.EstimatedTflopsInt8.HasValue == true
                ? $"~{currentGpu.EstimatedTflopsInt8:F0} TFLOPS"
                : (currentGpu != null ? L["HardwareBenchmark_Unknown"] : "< 2"),
            TflopsInt4Info = currentGpu?.EstimatedTflopsInt4.HasValue == true
                ? $"~{currentGpu.EstimatedTflopsInt4:F0} TFLOPS"
                : (currentGpu != null ? L["HardwareBenchmark_Unknown"] : "< 4"),
            BandwidthInfo = currentGpu?.MemoryBandwidthGBps.HasValue == true
                ? $"~{currentGpu.MemoryBandwidthGBps:F0} GB/s"
                : (hardwareInfo?.EstimatedCpuTokensPerSecond.HasValue == true ? "~50 GB/s (DDR)" : L["HardwareBenchmark_Unknown"]),
            SpeedInfo = currentSpeed > 0 ? $"~{currentSpeed:F0} tok/s" : L["HardwareBenchmark_Unknown"],
            EstimatedTokensPerSecond = currentSpeed,
            PowerInfo = "-",
            PriceInfo = "-",
        });

        // ---- 参考平台 ----
        platforms.AddRange(GetReferencePlatforms());

        // 按速度降序排序并分配排名
        sortedPlatforms = platforms
            .OrderByDescending(p => p.EstimatedTokensPerSecond)
            .Select((p, idx) => { p.Rank = idx + 1; return p; })
            .ToList();
    }

    private List<PlatformComparisonItem> GetReferencePlatforms()
