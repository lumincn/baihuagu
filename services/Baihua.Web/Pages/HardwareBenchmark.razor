                Vendor = "Apple", VendorEmoji = "⚪", BadgeClass = "apple", ModelName = "MacBook Pro M3",
                GpuInfo = $"10 {cores} GPU + 16 {cores} NPU<br><span class=\"sub-text\">Apple Silicon</span>",
                MemoryInfo = $"{L["HardwareBenchmark_UpTo"]} 24 GB<br><span class=\"sub-text\">{umem}</span>",
                TflopsInt8Info = "~8 TFLOPS", TflopsInt4Info = "~16 TFLOPS", BandwidthInfo = "~102 GB/s",
                SpeedInfo = "~10 tok/s", EstimatedTokensPerSecond = 10,
                PowerInfo = "~30W", PriceInfo = "~¥12,000+",
            },
        };
    }

    private string GetGpuSummary()
    {
        if (hardwareInfo?.Gpus == null || hardwareInfo.Gpus.Count == 0)
            return L["HardwareBenchmark_NoDiscreteGpu"];
        var gpu = hardwareInfo.Gpus[0];
        var parts = new List<string> { gpu.Name };
        if (gpu.ComputeUnits.HasValue)
            parts.Add($"({gpu.ComputeUnits} {(gpu.Vendor == "NVIDIA" ? "CUDA" : gpu.Vendor == "AMD" ? "CU" : gpu.Vendor == "Intel" ? "Xe" : L["HardwareBenchmark_CoreUnit"])})");
        if (gpu.EstimatedTokensPerSecond.HasValue)
            parts.Add($"~{gpu.EstimatedTokensPerSecond:F0} tok/s");
        return string.Join(" ", parts);
    }

    private string GetDiskGiB(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0) return "-";
        return Math.Round(bytes.Value / (1024.0 * 1024 * 1024), 0).ToString("F0");
    }

    private string GetMachineTierClass()
    {
        var tier = GetHardwareTier();
        return tier switch
        {
            HardwareTier.CpuOnly => "tier-cpu-only",
            HardwareTier.LowEndGpu => "tier-low-end",
            HardwareTier.MidRangeGpu => "tier-mid-range",
            HardwareTier.HighEndGpu => "tier-high-end",
            HardwareTier.TopTierGpu => "tier-top-tier",
            _ => "tier-unknown"
        };
    }

    private string GetMachineTierLabel()
    {
        var tier = GetHardwareTier();
        return tier switch
        {
            HardwareTier.CpuOnly => L["HardwareBenchmark_TierCpuTitle"],
            HardwareTier.LowEndGpu => L["HardwareBenchmark_TierEntryTitle"],
            HardwareTier.MidRangeGpu => L["HardwareBenchmark_TierMidTitle"],
            HardwareTier.HighEndGpu => L["HardwareBenchmark_TierHighTitle"],
            HardwareTier.TopTierGpu => L["HardwareBenchmark_TierTopLabel"],
            _ => L["HardwareBenchmark_Unknown"]
        };
    }

    private HardwareTier GetHardwareTier()
    {
        if (hardwareInfo?.Gpus == null || hardwareInfo.Gpus.Count == 0)
            return HardwareTier.CpuOnly;

        // 优先看是否有独立显卡
        var dedicatedGpu = hardwareInfo.Gpus.FirstOrDefault(g => !g.IsIntegrated && !g.IsAppleSilicon);
        if (dedicatedGpu != null && dedicatedGpu.VramGiB.HasValue)
        {
            var vram = dedicatedGpu.VramGiB.Value;
            if (vram >= 16) return HardwareTier.TopTierGpu;
            if (vram >= 8) return HardwareTier.HighEndGpu;
            if (vram >= 4) return HardwareTier.MidRangeGpu;
            return HardwareTier.LowEndGpu;
        }

        // Apple Silicon
        var appleGpu = hardwareInfo.Gpus.FirstOrDefault(g => g.IsAppleSilicon);
        if (appleGpu != null && appleGpu.VramGiB.HasValue)
        {
            var vram = appleGpu.VramGiB.Value;
            if (vram >= 16) return HardwareTier.TopTierGpu;
            if (vram >= 8) return HardwareTier.HighEndGpu;
            if (vram >= 4) return HardwareTier.MidRangeGpu;
            return HardwareTier.LowEndGpu;
        }

        // 集成显卡
        var igpu = hardwareInfo.Gpus.FirstOrDefault(g => g.IsIntegrated);
        if (igpu != null)
        {
            if (hardwareInfo.Memory.TotalGiB >= 16) return HardwareTier.LowEndGpu;
            return HardwareTier.CpuOnly;
        }

        // 无任何 GPU 信息，按内存判断
        if (hardwareInfo.Memory.TotalGiB >= 32) return HardwareTier.LowEndGpu;
        return HardwareTier.CpuOnly;
    }

    private string GetSpeedClass(double? speed)
    {
        if (!speed.HasValue) return "";
        return speed.Value switch
        {
            >= 100 => "speed-excellent",
            >= 50 => "speed-good",
            >= 20 => "speed-mid",
            >= 5 => "speed-low",
            _ => "speed-poor",
        };
    }

    private void GenerateRecommendations()
    {
        recommendations = new List<RecommendationItem>();
        var tier = GetHardwareTier();
        var totalMem = hardwareInfo?.Memory.TotalGiB ?? 0;
        var currentSpeed = hardwareInfo?.Gpus?.FirstOrDefault()?.EstimatedTokensPerSecond
            ?? hardwareInfo?.EstimatedCpuTokensPerSecond ?? 0;

        // 本地模型推理
        if (tier == HardwareTier.CpuOnly)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🧠", Title = L["HardwareBenchmark_CapLocalInferTitle"],
                Description = string.Format(L["HardwareBenchmark_CapLocalInferCpu"], currentSpeed),
                LevelClass = "level-bad", LevelText = L["HardwareBenchmark_LevelLimited"]
            });
        }
        else if (tier == HardwareTier.LowEndGpu)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🧠", Title = L["HardwareBenchmark_CapLocalInferTitle"],
                Description = string.Format(L["HardwareBenchmark_CapLocalInferLowEnd"], currentSpeed),
                LevelClass = "level-ok", LevelText = L["HardwareBenchmark_LevelAvailable"]
            });
        }
        else if (tier == HardwareTier.MidRangeGpu)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🧠", Title = L["HardwareBenchmark_CapLocalInferTitle"],
                Description = string.Format(L["HardwareBenchmark_CapLocalInferMid"], currentSpeed),
                LevelClass = "level-good", LevelText = L["HardwareBenchmark_LevelGood"]
            });
        }
        else if (tier == HardwareTier.HighEndGpu)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🧠", Title = L["HardwareBenchmark_CapLocalInferTitle"],
                Description = string.Format(L["HardwareBenchmark_CapLocalInferHigh"], currentSpeed),
                LevelClass = "level-good", LevelText = L["HardwareBenchmark_LevelExcellent"]
            });
        }
        else
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🧠", Title = L["HardwareBenchmark_CapLocalInferTitle"],
                Description = string.Format(L["HardwareBenchmark_CapLocalInferTop"], currentSpeed),
                LevelClass = "level-excellent", LevelText = L["HardwareBenchmark_LevelTop"]
            });
        }

        // 多模态/图像生成
        if (tier == HardwareTier.CpuOnly)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🎨", Title = L["HardwareBenchmark_CapImageTitle"],
                Description = L["HardwareBenchmark_CapImageCpu"],
                LevelClass = "level-bad", LevelText = L["HardwareBenchmark_LevelNotSupported"]
            });
        }
        else if (tier <= HardwareTier.LowEndGpu)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🎨", Title = L["HardwareBenchmark_CapImageTitle"],
                Description = L["HardwareBenchmark_CapImageLowEnd"],
                LevelClass = "level-ok", LevelText = L["HardwareBenchmark_LevelLimited"]
            });
        }
        else
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "🎨", Title = L["HardwareBenchmark_CapImageTitle"],
                Description = L["HardwareBenchmark_CapImageMid"],
                LevelClass = tier >= HardwareTier.HighEndGpu ? "level-good" : "level-ok",
                LevelText = tier >= HardwareTier.HighEndGpu ? L["HardwareBenchmark_LevelGood"] : L["HardwareBenchmark_LevelAvailable"]
            });
        }

        // 知识库构建
        if (totalMem < 8)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "📚", Title = L["HardwareBenchmark_CapEmbedTitle"],
                Description = L["HardwareBenchmark_CapEmbedLow"],
                LevelClass = "level-ok", LevelText = L["HardwareBenchmark_LevelLimited"]
            });
        }
        else if (totalMem < 16)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "📚", Title = L["HardwareBenchmark_CapEmbedTitle"],
                Description = L["HardwareBenchmark_CapEmbedMid"],
                LevelClass = "level-good", LevelText = L["HardwareBenchmark_LevelGood"]
            });
        }
        else
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "📚", Title = L["HardwareBenchmark_CapEmbedTitle"],
                Description = L["HardwareBenchmark_CapEmbedHigh"],
                LevelClass = "level-excellent", LevelText = L["HardwareBenchmark_LevelExcellent"]
            });
        }

        // RAG / 长上下文
        if (tier == HardwareTier.CpuOnly || totalMem < 16)
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "💬", Title = L["HardwareBenchmark_CapRagTitle"],
                Description = L["HardwareBenchmark_CapRagLow"],
                LevelClass = tier == HardwareTier.CpuOnly ? "level-bad" : "level-ok",
                LevelText = tier == HardwareTier.CpuOnly ? L["HardwareBenchmark_LevelLimited"] : L["HardwareBenchmark_LevelAvailable"]
            });
        }
        else
        {
            recommendations.Add(new RecommendationItem
            {
                Icon = "💬", Title = L["HardwareBenchmark_CapRagTitle"],
                Description = L["HardwareBenchmark_CapRagHigh"],
                LevelClass = tier >= HardwareTier.HighEndGpu ? "level-good" : "level-ok",
                LevelText = tier >= HardwareTier.HighEndGpu ? L["HardwareBenchmark_LevelExcellent"] : L["HardwareBenchmark_LevelGood"]
            });
        }
    }

    public void Dispose()
    {
    }

    private class PlatformComparisonItem
    {
        public bool IsCurrentMachine { get; set; }
        public int Rank { get; set; }
        public string Vendor { get; set; } = "";
        public string VendorEmoji { get; set; } = "";
        public string BadgeClass { get; set; } = "";
        public string ModelName { get; set; } = "";
        public string GpuInfo { get; set; } = "";
        public string MemoryInfo { get; set; } = "";
        public string TflopsInt8Info { get; set; } = "";
        public string TflopsInt4Info { get; set; } = "";
        public string BandwidthInfo { get; set; } = "";
        public string SpeedInfo { get; set; } = "";
        public double EstimatedTokensPerSecond { get; set; }
        public string PowerInfo { get; set; } = "";
        public string PriceInfo { get; set; } = "";
    }

    private class RecommendationItem
    {
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string LevelClass { get; set; } = "";
        public string LevelText { get; set; } = "";
    }
}

