    }

    .scene-btn {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 8px 4px;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: rgba(180, 200, 215, 0.6);
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.75rem;
    }

    .scene-btn:hover {
        background: rgba(46, 139, 175, 0.2);
