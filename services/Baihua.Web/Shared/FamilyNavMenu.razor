@using Baihua.Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject AuthService AuthService
@inject CapabilityService CapabilityService
@inject GlobalStateService GlobalStateService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@implements IDisposable

<!-- 场景选择器 -->
<div class="scene-selector">
    <button class="scene-btn @(_activeScene == 0 ? "active" : "")" @onclick="() => _activeScene = 0">
        <span class="scene-icon">📚</span>
        <span class="scene-label">@L["Nav_KnowledgeBase"]</span>
    </button>
    <button class="scene-btn @(_activeScene == 1 ? "active" : "")" @onclick="() => _activeScene = 1">
        <span class="scene-icon">👨‍👩‍👧</span>
        <span class="scene-label">@L["Nav_Family"]</span>
    </button>
    <button class="scene-btn @(_activeScene == 2 ? "active" : "")" @onclick="() => _activeScene = 2">
        <span class="scene-icon">🤖</span>
        <span class="scene-label">@L["Nav_AiLab"]</span>
    </button>
</div>

<!-- 📚 知识库 -->
@if (_activeScene == 0)
{
    <div class="nav-group">
        <NavLink href="" Match="NavLinkMatch.All">
            <span class="nav-icon bi bi-house-door"></span>
            <span>@L["Nav_Home"]</span>
        </NavLink>
        <NavLink href="browse">
            <span class="nav-icon bi bi-folder2-open"></span>
            <span>@L["Nav_BrowseKnowledge"]</span>
        </NavLink>
        <NavLink href="search">
            <span class="nav-icon bi bi-search"></span>
            <span>@L["Nav_Search"]</span>
        </NavLink>
        <NavLink href="cards">
            <span class="nav-icon bi bi-layers"></span>
            <span>@L["Nav_MemoryCards"]</span>
        </NavLink>
        <NavLink href="vaults">
            <span class="nav-icon bi bi-folder2-open"></span>
            <span>@L["Nav_ManageVaults"]</span>
        </NavLink>
    </div>
}

<!-- 👨‍👩‍👧 家庭 -->
@if (_activeScene == 1)
{
    <div class="nav-group">
        <NavLink href="tasks">
            <span class="nav-icon bi bi-list-check"></span>
            <span>@L["Nav_Tasks"]</span>
        </NavLink>
        <NavLink href="openclaw">
            <span class="nav-icon bi bi-robot"></span>
            <span>OpenClaw</span>
        </NavLink>
        <NavLink href="daily-card">
            <span class="nav-icon bi bi-journal-bookmark"></span>
            <span>@L["Nav_DailyCard"]</span>
        </NavLink>
        <NavLink href="achievements">
            <span class="nav-icon bi bi-trophy"></span>
            <span>@L["Nav_Achievements"]</span>
        </NavLink>
        <NavLink href="leaderboard">
            <span class="nav-icon bi bi-joystick"></span>
            <span>@L["Nav_Leaderboard"]</span>
        </NavLink>
        <NavLink href="dashboard">
            <span class="nav-icon bi bi-bar-chart-line"></span>
            <span>@L["Nav_ParentDashboard"]</span>
        </NavLink>
    </div>
}

<!-- 🤖 AI 实验室 -->
@if (_activeScene == 2)
{
    <div class="nav-group">
        <div class="nav-group-label">@L["Nav_ChatLabel"]</div>
        <NavLink href="messages">
            <span class="nav-icon bi bi-chat-dots"></span>
            <span>@L["Nav_AiChat"]</span>
        </NavLink>
        <NavLink href="master-chat">
            <span class="nav-icon bi bi-mortarboard"></span>
            <span>@L["Nav_VirtualMaster"]</span>
        </NavLink>
    </div>

    <div class="nav-group">
        <div class="nav-group-label">@L["Nav_ResearchLabel"]</div>
            @if (_canShowLocalModels)
            {
                <NavLink href="local-models">
                    <span class="nav-icon bi bi-cpu"></span>
                    <span>@L["Nav_LocalModels"]</span>
                </NavLink>
                <NavLink href="image-recognition">
                    <span class="nav-icon bi bi-eye"></span>
                    <span>@L["Nav_ImageRecognition"]</span>
                </NavLink>
            }
            @if (_canShowModelBenchmark)
            {
                <NavLink href="model-benchmark">
                    <span class="nav-icon bi bi-speedometer2"></span>
                    <span>@L["Nav_ModelBenchmark"]</span>
                </NavLink>
            }
            <NavLink href="ai-metrics">
                <span class="nav-icon bi bi-graph-up-arrow"></span>
                <span>@L["Nav_AiMetrics"]</span>
            </NavLink>
            <NavLink href="hardware-benchmark">
                <span class="nav-icon bi bi-motherboard"></span>
                <span>@L["Nav_HardwareBenchmark"]</span>
            </NavLink>
        </div>

    <div class="nav-group">
        <div class="nav-group-label">@L["Nav_ConfigLabel"]</div>
        <NavLink href="settings">
            <span class="nav-icon bi bi-gear"></span>
            <span>@L["Nav_AiSettings"]</span>
        </NavLink>
        <NavLink href="prompt-templates">
            <span class="nav-icon bi bi-chat-square-text"></span>
            <span>@L["Nav_PromptTemplates"]</span>
        </NavLink>
    </div>
}

<hr class="nav-divider" />

@code {
    private int _activeScene = 0;
    private bool _canShowLocalModels = true;
    private bool _canShowModelBenchmark = true;

    protected override async Task OnInitializedAsync()
    {

        // 根据当前路由推断场景
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        // 能力检测
        try
        {
            _canShowLocalModels = await CapabilityService.CanShowAsync("LocalModelsPage");
            _canShowModelBenchmark = await CapabilityService.CanShowAsync("ModelBenchmark");
        }
        catch
        {
            _canShowLocalModels = true;
            _canShowModelBenchmark = true;
        }

        // 订阅事件
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(e.Location);
        // URL 推断场景
        var inferred = relativePath switch
        {
            string p when p.StartsWith("tasks") || p.StartsWith("openclaw") || p.StartsWith("achievements") || p.StartsWith("leaderboard") || p.StartsWith("dashboard") || p.StartsWith("daily-card") => 1,
            string p when p.StartsWith("messages") || p.StartsWith("master-chat") || p.StartsWith("master-stage") || p.StartsWith("generate") || p.StartsWith("local-models") || p.StartsWith("image-recognition") || p.StartsWith("model-benchmark") || p.StartsWith("ai-metrics") || p.StartsWith("hardware-benchmark") || p.StartsWith("settings") || p.StartsWith("prompt-templates") => 2,
            string p when p.StartsWith("log-settings") || p.StartsWith("browse") || p.StartsWith("search") || p.StartsWith("cards") || p.StartsWith("vaults") || p == "" => 0,
            _ => 0
        };
        if (inferred != _activeScene)
        {
            _activeScene = inferred;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

<style>
    .scene-selector {
        display: flex;
        gap: 4px;
        padding: 0 0.5rem;
        margin-bottom: 1rem;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 4px;
    }

    .scene-btn {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 8px 4px;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: rgba(180, 200, 215, 0.6);
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.75rem;
    }

    .scene-btn:hover {
        background: rgba(46, 139, 175, 0.2);
        color: rgba(220, 235, 245, 0.95);
    }

    .scene-btn.active {
        background: rgba(46, 139, 175, 0.35);
        color: #fff;
        font-weight: 600;
    }

    .scene-icon {
        font-size: 1.2rem;
        line-height: 1;
    }

    .scene-label {
        font-size: 0.7rem;
        letter-spacing: 0.02em;
    }

    .nav-divider {
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        margin: 1rem 0.5rem;
        opacity: 0.5;
    }
</style>
