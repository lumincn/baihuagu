    }

    .scene-icon {
        font-size: 1.2rem;
        line-height: 1;
    }

    .scene-label {
        font-size: 0.7rem;
        letter-spacing: 0.02em;
    }

    .mode-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 10px;
        cursor: pointer;
        user-select: none;
        border-radius: 8px;
        transition: background 0.2s;
    }
    .mode-switch:hover {
