<!-- 闁荤姴娴傞崣鈧柍璇茬墦瀹曟岸宕堕妸銉ョ哎 -->
<div class="nav-group">
    <div class="nav-group-label">@L["Language"]</div>
    <div class="language-switch">
        @foreach (var (code, name) in CultureService.SupportedCultures)
        {
            <button class="lang-btn @(CultureService.GetCurrentCulture() == code ? "active" : "")"
                    @onclick="() => CultureService.SwitchToAsync(code)"
                    disabled="@(CultureService.GetCurrentCulture() == code)">
                @name
            </button>
        }
    </div>
</div>

@code {
    private int _activeScene = 0;
    private bool _isProfessional = false;
    private bool _canShowLocalModels = true;
    private bool _canShowModelBenchmark = true;

    protected override async Task OnInitializedAsync()
    {
        UserTypeService.UserTypeChanged += OnUserTypeChanged;

        // 闂佸搫绉烽～澶婄暤娴ｅ浜归柟鎯у暱椤ゅ懘鎮规笟顖氱仯闁轰線浜堕獮鎺楀Ω閿旂晫鍔烽梺闈╁閸庛倕鈻?
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        // 闂佺厧鐤囧Λ鍕叏韫囨拹娑㈠焵椤掆偓闇?
        try
        {
            _canShowLocalModels = await CapabilityService.CanShowAsync("LocalModelsPage");
            _canShowModelBenchmark = await CapabilityService.CanShowAsync("ModelBenchmark");
        }
        catch
        {
            _canShowLocalModels = true;
            _canShowModelBenchmark = true;
        }

        // 闁荤姳闄嶉崹钘壩ｉ崟顒傤洸閻庯絺鏅滈?
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await UserTypeService.InitializeAsync();
        _isProfessional = UserTypeService.IsProfessional;
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(e.Location);
        // URL 闂佽浜介崝宥夊蓟閸ヮ剙鎹堕柣鎴炆戦悵?
        var inferred = relativePath switch
        {
            string p when p.StartsWith("tasks") || p.StartsWith("openclaw") || p.StartsWith("achievements") || p.StartsWith("leaderboard") || p.StartsWith("dashboard") || p.StartsWith("daily-card") => 1,
            string p when p.StartsWith("messages") || p.StartsWith("master-chat") || p.StartsWith("master-stage") || p.StartsWith("generate") || p.StartsWith("local-models") || p.StartsWith("model-benchmark") || p.StartsWith("ai-metrics") || p.StartsWith("hardware-benchmark") || p.StartsWith("settings") || p.StartsWith("prompt-templates") => 2,
            string p when p.StartsWith("log-settings") || p.StartsWith("browse") || p.StartsWith("search") || p.StartsWith("cards") || p.StartsWith("vaults") || p == "" => 0,
            _ => 0
        };
        if (inferred != _activeScene)
        {
            _activeScene = inferred;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnUserTypeChanged(object? sender, EventArgs e)
    {
        _isProfessional = UserTypeService.IsProfessional;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleUserType()
    {
        var newType = _isProfessional ? UserType.Beginner : UserType.Professional;
        await UserTypeService.SetUserTypeAsync(newType);
        _isProfessional = UserTypeService.IsProfessional;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        UserTypeService.UserTypeChanged -= OnUserTypeChanged;
    }
}

<style>
    .scene-selector {
        display: flex;
        gap: 4px;
        padding: 0 0.5rem;
        margin-bottom: 1rem;
        background: rgba(255, 255, 255, 0.06);
