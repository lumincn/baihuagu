@using Baihua.Contracts.LocalModels
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.CapabilityService CapabilityService
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@inject Microsoft.Extensions.Logging.ILogger<OpenVinoTab> Logger
@inject NavigationManager NavigationManager

@* OpenVINO 模型区（从 LocalModels.razor 抽取，行为零变化）。
   父页面负责：Tab 导航、概览区、运行中模型（含卸载）、部署任务轮询；
   本组件负责：OpenVINO 目录/下载任务/已下载模型/LLM 托管服务 + 三个弹窗 + 下载轮询。 *@

@if (_openVinoAvailable == false)
{
    <div class="alert alert-warning" role="alert">
        ⚠️ @L["LocalModels_OpenVinoNotSupported"]
    </div>
}
else
{

<!-- OpenVINO 模型（Intel Arc GPU） -->
<div class="section-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showOpenVino)">
    <h2>@(_showOpenVino ? "▼" : "▶") 🧠 @L["LocalModels_OpenVinoTitle"]</h2>
</div>
@if (_showOpenVino)
{

    <!-- 模型目录（已下载 + 可下载合并） -->
    <div class="mt-3 mb-2">

        @if (openVinoCatalog.Count == 0)
        {
            <div class="text-muted small">@L["LocalModels_CatalogEmpty"]</div>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>@L["LocalModels_Col_Model"]</th><th>@L["LocalModels_Col_Params"]</th><th>@L["LocalModels_Col_Size"]</th><th>@L["LocalModels_Col_Usage"]</th><th>@L["LocalModels_Col_Status"]</th><th class="text-end">@L["LocalModels_Col_Actions"]</th></tr></thead>
                <tbody>
                    @foreach (var c in openVinoCatalog.Where(c => !c.IsOmsHosted))
                    {
                        <tr class="@(c.Installed ? "table-active" : "")">
                            <td>@c.Name @(c.IsVision ? "👁" : c.IsTts ? "🔊" : c.IsMedical ? "⚕️" : "")</td>
                            <td>@c.ParameterSize @c.Quantization</td>
                            <td class="small text-muted">
                                @if (c.Installed && c.SizeBytes > 0)
                                {
                                    @FormatSize(c.SizeBytes)
                                }
                                else
                                {
                                    @(c.SizeGiB.ToString("F1") + "GB")
                                }
                                @if (c.MinVramGiB.HasValue)
                                {
                                    <span class="ms-1" title="@L["LocalModels_MinVramHint"]">· 需 @c.MinVramGiB.Value.ToString("F0")GB 显存</span>
                                }
                            </td>
                            <td class="small text-muted">@c.Description</td>
                            <td>
                                @if (c.Installed && c.IsRunning)
                                {
                                    <span class="badge bg-success">@string.Format(L["LocalModels_RunningWithPort"], c.Port)</span>
                                    @if (c.IsOmsHosted)
                                    {
                                        <span class="badge" style="background:#2e7d32;color:#fff;">✅ @L["LocalModels_OmsHostedBadge"]</span>
                                    }
                                }
                                else if (c.Installed)
                                {
                                    <span class="badge bg-secondary">@L["LocalModels_DownloadedBadge"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">@L["LocalModels_NotDownloadedBadge"]</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (c.Installed)
                                {
                                    @if (c.IsRunning)
                                    {
                                        @if (c.IsOmsHosted)
                                        {
                                            @* OVMS 常驻托管：注册即运行，不支持从此页停止/启动子进程 *@
                                            <span class="text-muted small">@L["LocalModels_OmsHostedHint"]</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => StopModelAsync(c.Port!.Value)'>@L["LocalModels_StopBtn"]</button>
                                        }
                                    }
                                    else
                                    {
                                        @if (c.IsTts)
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick='() => RunModelAsync(c.Path!)'>@L["LocalModels_RunBtn"]</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick='() => RegisterOmsAsync(c)'>@L["LocalModels_RegisterOmsBtn"]</button>
                                        }
                                    }
                                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => AskDeleteOpenVino(c)'>@L["LocalModels_DeleteBtn"]</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-primary" @onclick='() => StartDownloadAsync(c.Id)'>@L["LocalModels_DownloadBtn"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (!string.IsNullOrEmpty(openVinoMessage))
    {
        <div class="text-warning small mt-2">@openVinoMessage</div>
    }
}
<!-- OpenVINO Downloaded Models -->
<div class="downloaded-section">
    <div class="section-header" style="cursor:pointer;" @onclick="() => ToggleSection(ref _showDownloadedModels)">
        <h2>@(_showDownloadedModels ? "▼" : "▶") 🧿 @L["LocalModels_DownloadedOpenVino"] <span class="text-muted small fw-normal">@L["LocalModels_DownloadedHint"]</span></h2>
        @if (_showDownloadedModels)
        {
            <button class="btn btn-secondary btn-sm" @onclick="RefreshDownloadedModels" @onclick:stopPropagation disabled="@isLoadingDownloaded">
                @(isLoadingDownloaded ? "🔄 " + L["LocalModels_Refreshing"] : "🔄 " + L["LocalModels_RefreshModels"])
            </button>
        }
    </div>
    @if (_showDownloadedModels)
    {
    @if (downloadedModels.Count == 0)
    {
        <div class="alert alert-info">@L["LocalModels_NoDownloadedModels"]</div>
    }
    else
    {
        <div class="downloaded-models-table ovms-downloaded-table">
            <div class="downloaded-table-header">
                <span class="col-dl-name">@L["LocalModels_DlName"]</span>
                <span class="col-dl-params">@L["LocalModels_DlParams"]</span>
                <span class="col-dl-usage">@L["LocalModels_DlUsage"]</span>
                <span class="col-dl-size">@L["LocalModels_DlSize"]</span>
            </div>
            @foreach (var dm in downloadedModels.Where(m => m.ToolId == "openvino"))
            {
                <div class="downloaded-table-row">
                    <span class="col-dl-name">
                        <span class="model-name-text">@dm.Name</span>
                        @if (!string.IsNullOrEmpty(dm.Digest))
                        {
                            <span class="digest-text" title="@dm.Digest">@dm.Digest[..Math.Min(12, dm.Digest.Length)]...</span>
                        }
                    </span>
                    <span class="col-dl-params">
                        @(string.IsNullOrEmpty(dm.Quantization) ? dm.ParameterSize : $"{dm.ParameterSize} {dm.Quantization}")
                    </span>
                    <span class="col-dl-usage">@dm.Usage</span>
                    <span class="col-dl-size">@dm.SizeGiB GB</span>
                </div>
            }
        </div>
        <div class="memory-summary">
            @L["LocalModels_ModelCount", downloadedModels.Count, downloadedModels.Sum(m => m.SizeGiB).ToString("F1")]
        </div>
    }
    @if (!string.IsNullOrEmpty(downloadedModelMessage))
    {
        <div class="load-message @(downloadedModelSuccess ? "text-success" : "text-error")" style="margin-top:0.5rem;">
            @downloadedModelMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(loadModelMessage))
    {
        <div class="load-message @(loadModelSuccess ? "text-success" : "text-error")" style="margin-top:0.5rem;">
            @loadModelMessage
        </div>
    }
    }
</div>


@if (openVinoToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDeleteOpenVino">
        <div class="modal-content modal-small" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>⚠️ @L["LocalModels_DeleteModelTitle"]</h3>
                <button class="modal-close" @onclick="CancelDeleteOpenVino">×</button>
            </div>
            <div class="modal-body">
                <p>@L["LocalModels_DeleteOpenVinoText", openVinoToDelete.Name]</p>
                <p class="text-error">@L["LocalModels_DeleteOpenVinoIrreversible"]</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelDeleteOpenVino">@L["Common_Cancel"]</button>
                <button class="btn btn-danger" @onclick="ConfirmDeleteOpenVino">@L["LocalModels_DeleteConfirmBtn"]</button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirm Dialog（已下载模型） -->
@if (showDeleteConfirm && modelToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDeleteModel">
        <div class="modal-content modal-small" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>⚠️ @L["LocalModels_DeleteConfirmTitle"]</h3>
                <button class="modal-close" @onclick="CancelDeleteModel">×</button>
            </div>
            <div class="modal-body">
                <p>@L["LocalModels_DeleteConfirmText", modelToDelete.Name]</p>
                <p>@L["LocalModels_DeleteSize", modelToDelete.SizeGiB]</p>
                <p class="text-error">@L["LocalModels_DeleteIrreversible"]</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelDeleteModel">@L["Common_Cancel"]</button>
                <button class="btn btn-danger" @onclick="ConfirmDeleteModel" disabled="@isLoadingModel">
                    @(isLoadingModel ? L["LocalModels_Deleting"] : L["LocalModels_DeleteConfirmBtn"])
                </button>
            </div>
        </div>
    </div>
}


}

@code {
    /// <summary>模型变更后通知父页面刷新（运行中模型列表等）</summary>
    [Parameter] public EventCallback ModelsChanged { get; set; }

    // 区域折叠状态
    private bool? _openVinoAvailable; // null=未知/加载中（默认不隐藏）
    private bool _showOpenVino = true;
    private bool _showDownloadedModels = true;

    // OpenVINO 模型区
    private List<OpenVinoCatalogItemDto> openVinoCatalog = new();
    private string? openVinoMessage;


    // OpenVINO 已下载模型删除确认
    private OpenVinoCatalogItemDto? openVinoToDelete;


    // 加载模型（已下载模型区）
    private string loadToolId = "";
    private string loadModelName = "";
    private int loadKeepAliveMinutes = 5;
    private bool isLoadingModel = false;
    private string loadModelMessage = "";
    private bool loadModelSuccess = false;

    // 已下载模型管理
    private List<DownloadedModelDto> downloadedModels = new();
    private bool isLoadingDownloaded = false;
    private string downloadedModelMessage = "";
    private bool downloadedModelSuccess = false;

    // 删除确认
    private bool showDeleteConfirm = false;
    private DownloadedModelDto? modelToDelete = null;


    private void ToggleSection(ref bool flag) => flag = !flag;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // 首次渲染后并行加载（懒加载：切到 OpenVINO Tab 才加载，与父页分块加载策略一致）
        await Task.WhenAll(
            SafeLoadAsync(LoadOpenVinoAvailableAsync),
            SafeLoadAsync(LoadOpenVinoAsync),
            SafeLoadAsync(RefreshDownloadedModels));

    }

    private async Task LoadOpenVinoAvailableAsync()
    {
        try
        {
            _openVinoAvailable = (await CapabilityService.GetCapabilityAsync()).OpenVinoAvailable;
        }
        catch
        {
            _openVinoAvailable = true; // 能力查询失败时默认不隐藏
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SafeLoadAsync(Func<Task> fn)
    {
        try
        {
            await fn();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "OpenVINO 分块加载失败");
        }
    }

    private async Task LoadOpenVinoAsync()
    {
        try
        {
            openVinoCatalog = await ApiService.GetOpenVinoCatalogAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = string.Format(L["LocalModels_OpenVinoLoadFailed"], ex.Message);
        }
        // 数据到达后主动刷新 UI（首次加载可能晚于其他区块的 StateHasChanged，
        // 否则目录会一直停留在“目录为空”，直到用户点击任意折叠头才意外出现列表）
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartDownloadAsync(string modelId)
    {
        openVinoMessage = null;
        try
        {
            await ApiService.StartOpenVinoDownloadAsync(modelId);
            NavigationManager.NavigateTo("/tasks");
        }
        catch (Exception ex)
        {
            openVinoMessage = string.Format(L["LocalModels_StartDownloadFailed"], ex.Message);
        }
    }

    private async Task RunModelAsync(string path)
    {
        openVinoMessage = null;
        try
        {
            var r = await ApiService.RunOpenVinoModelAsync(path);
            openVinoMessage = r.Success
                ? string.Format(L["LocalModels_StartedWithEndpoint"], r.Port, r.Endpoint)
                : string.Format(L["LocalModels_RunFailed"], r.Error);
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = string.Format(L["LocalModels_RunFailed"], ex.Message);
        }
    }

    private async Task RegisterOmsAsync(OpenVinoCatalogItemDto c)
    {
        openVinoMessage = null;
        try
        {
            var r = await ApiService.RegisterOmsModelAsync(c.Path!);
            if (r.Success)
                openVinoMessage = r.Warning != null
                    ? $"已注册 {c.Name}（{r.Warning}）"
                    : (r.AlreadyRegistered ? $"{c.Name} 已在 OVMS 注册" : $"已注册 {c.Name} 到 OVMS");
            else
                openVinoMessage = $"注册失败：{r.Error}";
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = $"注册失败：{ex.Message}";
        }
    }

    private async Task StopModelAsync(int port)
    {
        try
        {
            await ApiService.StopOpenVinoModelAsync(port);
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = string.Format(L["LocalModels_StopFailed"], ex.Message);
        }
    }

    private async Task DeleteModelAsync(string path)
    {
        try
        {
            await ApiService.DeleteOpenVinoModelAsync(path);
            await LoadOpenVinoAsync();
        }
        catch (Exception ex)
        {
            openVinoMessage = string.Format(L["LocalModels_DeleteFailed"], ex.Message);
        }
    }

    private void AskDeleteOpenVino(OpenVinoCatalogItemDto m) => openVinoToDelete = m;

    private void CancelDeleteOpenVino() => openVinoToDelete = null;

    private async Task ConfirmDeleteOpenVino()
    {
        if (openVinoToDelete == null) return;
        var path = openVinoToDelete.Path;
        openVinoToDelete = null;
        if (string.IsNullOrWhiteSpace(path)) return;
        await DeleteModelAsync(path);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1L << 30) return $"{bytes / 1024d / 1024d / 1024d:F2}GB";
        if (bytes >= 1L << 20) return $"{bytes / 1024d / 1024d:F1}MB";
        return $"{bytes / 1024d:F0}KB";
    }

    private async Task RefreshDownloadedModels()
    {
        isLoadingDownloaded = true;
        downloadedModelMessage = "";
        try
        {
            downloadedModels = await ApiService.GetDownloadedModelsAsync();
        }
        catch (Exception ex)
        {
            downloadedModelMessage = string.Format(L["LocalModels_RefreshDownloadedFailed"], ex.Message);
            downloadedModelSuccess = false;
        }
        finally
        {
            isLoadingDownloaded = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDownloadedModel(DownloadedModelDto model)
    {
        loadToolId = model.ToolId;
        loadModelName = model.Name;
        loadKeepAliveMinutes = 5;
        await LoadSelectedModel();
    }

    private void DeleteModel(DownloadedModelDto model)
    {
        modelToDelete = model;
        showDeleteConfirm = true;
        downloadedModelMessage = "";
    }

    private void CancelDeleteModel()
    {
        showDeleteConfirm = false;
        modelToDelete = null;
    }

    private async Task ConfirmDeleteModel()
    {
        if (modelToDelete == null) return;
        isLoadingModel = true;
        downloadedModelMessage = "";
        try
        {
            var success = await ApiService.DeleteModelAsync(new DeleteModelRequest
            {
                ToolId = modelToDelete.ToolId,
                ModelName = modelToDelete.Name
            });

            if (success)
            {
                downloadedModelMessage = string.Format(L["LocalModels_DeletedOk"], modelToDelete.Name);
                downloadedModelSuccess = true;
                showDeleteConfirm = false;
                modelToDelete = null;
                await RefreshDownloadedModels();
                if (ModelsChanged.HasDelegate)
                    await ModelsChanged.InvokeAsync();
            }
            else
            {
                downloadedModelMessage = L["LocalModels_DeleteFailedToolDown"];
                downloadedModelSuccess = false;
            }
        }
        catch (Exception ex)
        {
            downloadedModelMessage = string.Format(L["LocalModels_DeleteException"], ex.Message);
            downloadedModelSuccess = false;
        }
        finally
        {
            isLoadingModel = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task LoadSelectedModel()
    {
        isLoadingModel = true;
        loadModelMessage = "";
        try
        {
            var success = await ApiService.LoadModelAsync(new LoadModelRequest
            {
                ToolId = loadToolId,
                ModelName = loadModelName,
                KeepAliveMinutes = loadKeepAliveMinutes
            });

            if (success)
            {
                loadModelMessage = string.Format(L["LocalModels_LoadedOk"], loadModelName);
                loadModelSuccess = true;
                await Task.Delay(500);
                if (ModelsChanged.HasDelegate)
                    await ModelsChanged.InvokeAsync();
            }
            else
            {
                loadModelMessage = string.Format(L["LocalModels_LoadFailedToolDown"], loadModelName);
                loadModelSuccess = false;
            }
        }
        catch (Exception ex)
        {
            loadModelMessage = string.Format(L["LocalModels_LoadException"], ex.Message);
            loadModelSuccess = false;
        }
        finally
        {
            isLoadingModel = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetToolBadgeClass(string toolId)
    {
        return toolId switch
        {
            "openvino" => "tool-openvino",
            _ => ""
        };
    }


}
