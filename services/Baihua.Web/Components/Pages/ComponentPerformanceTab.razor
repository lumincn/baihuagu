@using Baihua.Web.Services
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<!-- 摘要卡片 -->
@if (summary != null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <div class="h3 mb-0">@summary.TotalComponents</div>
                    <small>@L["CompPerf_TotalComponents"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <div class="h3 mb-0">@summary.TotalRenders</div>
                    <small>@L["CompPerf_TotalRenders"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <div class="h3 mb-0">@summary.AverageRenderTimeMs.ToString("F1")</div>
                    <small>@L["CompPerf_AvgTimeMs"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <div class="h3 mb-0">@summary.MaxRenderTimeMs.ToString("F0")</div>
                    <small>@L["CompPerf_MaxTimeMs"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card @(summary.SlowComponentCount > 0 ? "bg-danger text-white" : "bg-success text-white")">
                <div class="card-body text-center">
                    <div class="h3 mb-0">@summary.SlowComponentCount</div>
                    <small>@L["CompPerf_SlowComponentCount"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card @(summary.SlowRenders > 0 ? "bg-danger text-white" : "bg-success text-white")">
                <div class="card-body text-center">
                    <div class="h3 mb-0">@summary.SlowRenders</div>
                    <small>@L["CompPerf_SlowRenderCount"]</small>
                </div>
            </div>
        </div>
    </div>
}

<!-- 阈值设置 -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">⚙ @L["CompPerf_Settings"]</h5>
    </div>
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4">
                <label class="form-label">@L["CompPerf_SlowThresholdMs"]</label>
                <div class="input-group">
                    <input type="number" class="form-control" @bind="slowThreshold" min="10" max="5000" />
                    <button class="btn btn-outline-primary" @onclick="UpdateThreshold">@L["CompPerf_Apply"]</button>
                </div>
            </div>
            <div class="col-md-8">
                <div class="form-text mt-2">
                    @L["CompPerf_ThresholdHint"] <strong>@ComponentPerformanceService.SlowThresholdMs ms</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 慢组件列表 -->
@if (slowComponents?.Any() == true)
{
    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">@L["CompPerf_SlowComponentsTop"] @(slowComponents.Count)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@L["CompPerf_ComponentName"]</th>
                            <th class="text-end">@L["CompPerf_RenderCount"]</th>
                            <th class="text-end">@L["CompPerf_AvgTime"]</th>
                            <th class="text-end">@L["CompPerf_MaxTime"]</th>
                            <th class="text-end">@L["CompPerf_SlowRenderCountCol"]</th>
                            <th>@L["CompPerf_LastRender"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in slowComponents)
                        {
                            <tr class="@(comp.AverageRenderTimeMs > ComponentPerformanceService.SlowThresholdMs * 2 ? "table-danger" : "table-warning")">
                                <td><code>@comp.ComponentName</code></td>
                                <td class="text-end">@comp.RenderCount</td>
                                <td class="text-end font-monospace">@comp.AverageRenderTimeMs.ToString("F1") ms</td>
                                <td class="text-end font-monospace">@comp.MaxRenderTimeMs.ToString("F1") ms</td>
                                <td class="text-end">
                                    <span class="badge bg-danger">@comp.SlowRenderCount</span>
                                </td>
                                <td class="text-muted small">@comp.LastRenderTime.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- 所有组件详情 -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@L["CompPerf_AllComponentDetails"]</h5>
    </div>
    <div class="card-body p-0">
        @if (allMetrics?.Any() != true)
        {
            <div class="text-center py-5 text-muted">
                <div class="mb-3">📭</div>
                <p>@L["CompPerf_NoData"]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@L["CompPerf_ComponentName"]</th>
                            <th class="text-end">@L["CompPerf_RenderCount"]</th>
                            <th class="text-end">@L["CompPerf_AvgTime"]</th>
                            <th class="text-end">@L["CompPerf_MinTime"]</th>
                            <th class="text-end">@L["CompPerf_MaxTime"]</th>
                            <th class="text-end">@L["CompPerf_TotalTime"]</th>
                            <th class="text-end">@L["CompPerf_SlowRenderCol"]</th>
                            <th>@L["CompPerf_LastRender"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in allMetrics)
                        {
                            <tr class="@(comp.AverageRenderTimeMs > ComponentPerformanceService.SlowThresholdMs ? "table-warning" : "")">
                                <td><code>@comp.ComponentName</code></td>
                                <td class="text-end">@comp.RenderCount</td>
                                <td class="text-end font-monospace">
                                    <span class="badge @(GetBadgeClass(comp.AverageRenderTimeMs))">
                                        @comp.AverageRenderTimeMs.ToString("F1") ms
                                    </span>
                                </td>
                                <td class="text-end font-monospace text-muted">@comp.MinRenderTimeMs.ToString("F1") ms</td>
                                <td class="text-end font-monospace">@comp.MaxRenderTimeMs.ToString("F1") ms</td>
                                <td class="text-end font-monospace">@comp.TotalRenderTimeMs.ToString("F0") ms</td>
                                <td class="text-end">
                                    @if (comp.SlowRenderCount > 0)
                                    {
                                        <span class="badge bg-danger">@comp.SlowRenderCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-muted small">@comp.LastRenderTime.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- 最近渲染事件 -->
@if (recentEvents?.Any() == true)
{
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">@L["CompPerf_RecentEvents"]</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>@L["CompPerf_Time"]</th>
                            <th>@L["CompPerf_ComponentName"]</th>
                            <th>@L["CompPerf_Elapsed"]</th>
                            <th>@L["CompPerf_Type"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in recentEvents.Take(50))
                        {
                            <tr class="@(evt.IsSlow ? "table-danger" : "")">
                                <td class="small text-nowrap">@evt.Timestamp.ToString("HH:mm:ss.fff")</td>
                                <td><code class="small">@evt.ComponentName</code></td>
                                <td class="font-monospace">
                                    <span class="badge @(GetBadgeClass(evt.ElapsedMilliseconds))">
                                        @evt.ElapsedMilliseconds.ToString("F1") ms
                                    </span>
                                </td>
                                <td>
                                    @if (evt.IsFirstRender)
                                    {
                                        <span class="badge bg-info">@L["CompPerf_FirstRender"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public required ComponentPerformanceService ComponentPerformanceService { get; set; }
    private PerformanceSummary? summary;
    private List<ComponentMetrics>? allMetrics;
    private List<ComponentMetrics>? slowComponents;
    private List<RenderEvent>? recentEvents;
    private int slowThreshold = 100;

    protected override void OnInitialized()
    {
        RefreshData();
    }

    private void RefreshData()
    {
        summary = ComponentPerformanceService.GetSummary();
        allMetrics = ComponentPerformanceService.GetAllMetrics();
        slowComponents = ComponentPerformanceService.GetSlowComponents();
        recentEvents = ComponentPerformanceService.GetRecentEvents(100);
    }

    private void UpdateThreshold()
    {
        ComponentPerformanceService.SlowThresholdMs = slowThreshold;
        RefreshData();
    }

    private string GetBadgeClass(double elapsedMs)
    {
        var threshold = ComponentPerformanceService.SlowThresholdMs;
        if (elapsedMs > threshold * 2) return "bg-danger";
        if (elapsedMs > threshold) return "bg-warning text-dark";
        if (elapsedMs > threshold / 2) return "bg-info";
        return "bg-success";
    }
}
