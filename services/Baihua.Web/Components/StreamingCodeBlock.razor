@* 流式文本输出块（如 CodeAgent 的输出 / 流水线各阶段）。把每 delta 的文本更新隔离在本组件内，
    父组件 StateHasChanged 时仅本组件在 Text 变化时重新渲染。 *@

<pre class="@Class" id="@Id"><code>@Text</code></pre>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Class { get; set; } = "code-output";
    [Parameter] public string? Id { get; set; }

    private string _lastText = "";

    protected override bool ShouldRender()
    {
        // 引用相同时走 O(1) 快速路径：未变化的阶段块跳过渲染。
        return !string.Equals(Text, _lastText, StringComparison.Ordinal);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _lastText = Text;
    }
}
