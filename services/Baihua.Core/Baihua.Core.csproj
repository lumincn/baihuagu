  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Baihua.Contracts/Baihua.Contracts.csproj" />
    <ProjectReference Include="../Baihua.Data/Baihua.Data.csproj" />
  </ItemGroup>
</Project>
