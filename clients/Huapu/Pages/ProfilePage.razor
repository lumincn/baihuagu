@page "/profile"
@inject BaihuaSdk.Signing.RequestSigner Signer
@inject BaihuaSdk.Storage.IServerConfigStore ServerStore
@inject BaihuaSdk.Storage.ISecureStore SecureStore
@inject NavigationManager Nav

<PageTitle>我的</PageTitle>

<div class="profile-header">
    <div class="profile-avatar">👤</div>
    <div class="profile-info">
        <div class="profile-name">@Signer.DeviceName</div>
        <div class="profile-id">ID: @Signer.DeviceId[..8]</div>
    </div>
</div>

<div class="profile-stats">
    <div class="stat-item">
        <span class="stat-value">@_serverCount</span>
        <span class="stat-label">服务器</span>
    </div>
    <div class="stat-item">
        <span class="stat-value">@_vaultCount</span>
        <span class="stat-label">知识库</span>
    </div>
    <div class="stat-item">
        <span class="stat-value">@_fileCount</span>
        <span class="stat-label">文件</span>
    </div>
</div>

<div class="profile-menu">
    <div class="menu-item" @onclick="GoPairing">
        <span class="menu-icon">🔗</span>
        <span class="menu-label">配对服务器</span>
        <span class="menu-arrow">›</span>
    </div>
    <div class="menu-item" @onclick="GoSync">
        <span class="menu-icon">📥</span>
        <span class="menu-label">获取知识库</span>
        <span class="menu-arrow">›</span>
    </div>
    <div class="menu-item" @onclick="GoVaults">
        <span class="menu-icon">📁</span>
        <span class="menu-label">浏览已同步</span>
        <span class="menu-arrow">›</span>
    </div>
    <div class="menu-item" @onclick="GoSettings">
        <span class="menu-icon">⚙️</span>
        <span class="menu-label">设置</span>
        <span class="menu-arrow">›</span>
    </div>
</div>

<div class="profile-footer">
    <p>百花移动端 · 花圃</p>
    <p>版本 1.0.0-preview</p>
    <p class="tech-info">.NET MAUI Blazor Hybrid + BaihuaSdk</p>
</div>

@code {
    private int _serverCount;
    private int _vaultCount;
    private int _fileCount;

    protected override async Task OnInitializedAsync()
    {
        var servers = await ServerStore.GetServersAsync();
        _serverCount = servers.Count;

        var baseDir = Path.Combine(FileSystem.AppDataDirectory, "vaults");
        if (Directory.Exists(baseDir))
        {
            var vaultDirs = Directory.GetDirectories(baseDir);
            _vaultCount = vaultDirs.Length;
            foreach (var vd in vaultDirs)
            {
                _fileCount += Directory.GetFiles(vd, "*.*", SearchOption.AllDirectories)
                    .Count(f => !Path.GetFileName(f).Equals(".vault-info.json", StringComparison.OrdinalIgnoreCase));
            }
        }
    }

    private void GoPairing() => Nav.NavigateTo("/pairing");
    private void GoSync() => Nav.NavigateTo("/sync");
    private void GoVaults() => Nav.NavigateTo("/vaults");
    private void GoSettings() => Nav.NavigateTo("/settings");
}