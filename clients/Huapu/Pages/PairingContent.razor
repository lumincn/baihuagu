@inject BaihuaSdk.Services.PairingServiceImpl PairingService
@inject MobileContract.Services.IDeviceRegistrationService DeviceRegistration
@inject BaihuaSdk.Storage.IServerConfigStore ServerStore
@inject BaihuaSdk.Signing.IRequestSigner Signer
@inject BaihuaSdk.Storage.ISecureStore SecureStore
@inject MobileApp.Maui.Services.IQrScanner QrScanner
@inject BaihuaSdk.Push.PushWebSocketService PushService

@implements IDisposable

<div class="pair-methods">
    <div class="method-card">
        <h3>扫码连接</h3>
        <p>扫描花圃管理后台的二维码</p>
        <button class="btn primary" @onclick="ScanQrCode" disabled="@_isLoading">
            @(_isLoading ? "打开相机..." : "扫描二维码")
        </button>
        <p class="or-divider">或手动粘贴</p>
        <textarea @bind="_qrInput" placeholder="粘贴二维码内容..." rows="3"></textarea>
        <button class="btn" @onclick="ParseAndPair" disabled="@_isLoading">
            @(_isLoading ? "解析中..." : "解析并配对")
        </button>
        @if (!string.IsNullOrEmpty(_qrError))
        {
            <p class="error">@_qrError</p>
        }
    </div>

    <div class="method-card">
        <h3>手动输入</h3>
        <p>直接输入花圃服务器地址</p>
        <input @bind="_manualUrl" placeholder="例如: http://192.168.1.100" />
        <button class="btn primary" @onclick="ManualRegister" disabled="@_isLoading">
            @(_isLoading ? "注册中..." : "注册设备")
        </button>
        @if (!string.IsNullOrEmpty(_manualError))
        {
            <p class="error">@_manualError</p>
        }
    </div>
</div>

@if (_result != null)
{
    <div class="result @(_result.Success ? "success" : "error")">
        <p>注册结果: @(_result.Success ? "成功" : "失败")</p>
        @if (!_result.Success && !string.IsNullOrEmpty(_result.ErrorMessage))
        {
            <p>错误: @_result.ErrorMessage</p>
        }
        @if (_result.Authorized)
        {
            <p>设备已授权! SharedSecret 已保存。</p>
        }
        @if (!_result.Authorized && !string.IsNullOrEmpty(_pendingUrl))
        {
            <p>已注册，等待 WebUI 批准；批准后 WebSocket 推送将自动完成授权。</p>
            <span class="ws-badge @(_pushConnected ? "ws-on" : "ws-off")">
                @(_pushConnected ? "WebSocket 已连接，实时等待授权" : "WebSocket 未连接")
            </span>
        }
        @if (!string.IsNullOrEmpty(_result.DeviceName))
        {
            <p>服务器: @_result.DeviceName</p>
        }
    </div>
}

@code {
    private string _qrInput = "";
    private string _manualUrl = "";
    private string? _qrError;
    private string? _manualError;
    private bool _isLoading;
    private MobileContract.Pairing.RegisterDeviceResult? _result;
    private EventHandler? _pushAuthorizedHandler;
    private string? _pendingUrl;
    private bool _pushConnected;

    /// <summary>订阅 WebSocket 授权推送：WebUI 批准后自动重新注册拿到 SharedSecret，无需手动再点注册。</summary>
    private void SubscribeToAuthorized(string httpUrl)
    {
        UnsubscribeFromAuthorized();
        _pendingUrl = httpUrl;
        _pushAuthorizedHandler = async (s, e) =>
        {
            try
            {
                var url = _pendingUrl;
                if (string.IsNullOrEmpty(url)) return;

                // 收到授权推送 → 重新注册（已授权设备会直接返回 SharedSecret）
                var result = await DeviceRegistration.RegisterDeviceAsync(url);
                if (result is { Success: true, Authorized: true, SharedSecret: not null })
                {
                    Signer.SetServerSecret(url, result.SharedSecret);
                    await SecureStore.SetAsync($"secret_{url}", result.SharedSecret);
                    _result = result;
                    await InvokeAsync(StateHasChanged);
                    UnsubscribeFromAuthorized();
                }
            }
            catch (Exception ex)
            {
                _manualError = $"授权后自动获取密钥失败: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        };
        PushService.Authorized += _pushAuthorizedHandler;
    }

    private void UnsubscribeFromAuthorized()
    {
        if (_pushAuthorizedHandler != null)
        {
            PushService.Authorized -= _pushAuthorizedHandler;
            _pushAuthorizedHandler = null;
        }
    }

    private void OnPushConnectionStateChanged(bool connected)
    {
        _pushConnected = connected;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UnsubscribeFromAuthorized();
        PushService.ConnectionStateChanged -= OnPushConnectionStateChanged;
    }

    private async Task ScanQrCode()
    {
        _qrError = null;
        _isLoading = true;
        StateHasChanged();
        try
        {
            var scanned = await QrScanner.ScanAsync();
            if (string.IsNullOrEmpty(scanned))
            {
                _qrError = "未识别到二维码";
                return;
            }

            _qrInput = scanned;
            await ParseAndPair();
        }
        catch (Exception ex)
        {
            _qrError = $"扫码失败: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ParseAndPair()
    {
        _qrError = null;
        _isLoading = true;
        StateHasChanged();
        try
        {
            var content = BaihuaSdk.Services.PairingServiceImpl.ParseQrCode(_qrInput);
            if (content == null) { _qrError = "无法解析二维码内容"; StateHasChanged(); return; }

            var addrs = BaihuaSdk.Services.PairingServiceImpl.GetServerAddresses(content);
            _result = await DeviceRegistration.RegisterDeviceAsync(addrs.HttpUrl);
            await SaveResult(addrs.ServerId, addrs.HostName, addrs.HttpUrl);
        }
        catch (Exception ex) { _qrError = ex.Message; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task ManualRegister()
    {
        _manualError = null;
        _isLoading = true;
        StateHasChanged();
        try
        {
            var input = _manualUrl.Trim();
            if (input.Length == 0) { _manualError = "请输入服务器地址"; return; }

            // 支持粘贴二维码 JSON（含 serverId/baseUrl）或纯 URL
            var isJson = input.StartsWith("{");
            var parsed = isJson ? BaihuaSdk.Services.PairingServiceImpl.ParseQrCode(input) : null;
            if (isJson && parsed == null) { _manualError = "无法解析二维码内容"; return; }

            var url = isJson
                ? BaihuaSdk.Transport.HttpTransport.NormalizeBaseUrl(parsed!.HttpUrl ?? parsed.ServerUrl ?? "")
                : BaihuaSdk.Transport.HttpTransport.NormalizeBaseUrl(input);
            _result = await DeviceRegistration.RegisterDeviceAsync(url);

            // 服务器 id 优先用服务端实例 ID（WebSocket serverId 匹配，避免知识库被误判 IP 撞车隐藏）
            var serverId = _result.ServerId
                ?? (isJson && !string.IsNullOrEmpty(parsed!.DeviceId) ? parsed!.DeviceId! : null)
                ?? $"manual-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
            await SaveResult(serverId, new Uri(url).Host, url);
        }
        catch (Exception ex) { _manualError = ex.Message; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task SaveResult(string serverId, string serverName, string httpUrl)
    {
        if (_result == null || !_result.Success) return;

        if (_result.Authorized && !string.IsNullOrEmpty(_result.SharedSecret))
        {
            Signer.SetServerSecret(httpUrl, _result.SharedSecret);
            await SecureStore.SetAsync($"secret_{httpUrl}", _result.SharedSecret);
        }

        await ServerStore.AddOrUpdateServerAsync(new BaihuaSdk.Models.ServerConfig
        {
            Id = serverId, Name = serverName,
            HttpUrl = httpUrl, IsOnline = true, LastUsedAt = DateTimeOffset.UtcNow
        });

        // WebSocket 实时等待授权：WebUI 批准后推送到达，自动完成授权拿 SharedSecret
        PushService.ConnectionStateChanged -= OnPushConnectionStateChanged;
        PushService.ConnectionStateChanged += OnPushConnectionStateChanged;
        await PushService.ConnectAsync(httpUrl, DeviceInfoHelper.GetDeviceName());
        if (!_result.Authorized)
        {
            SubscribeToAuthorized(httpUrl);
        }
        else
        {
            UnsubscribeFromAuthorized();
            _pendingUrl = null;
        }
    }
}