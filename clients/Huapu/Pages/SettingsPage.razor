@page "/settings"
@inject BaihuaSdk.Signing.RequestSigner Signer
@inject BaihuaSdk.Storage.IServerConfigStore ServerStore
@inject IJSRuntime JS

<PageTitle>花圃 - 设置</PageTitle>

<h1>设置</h1>

<div class="settings-section">
    <h3>外观</h3>
    <div class="setting-row">
        <span>暗色模式</span>
        <button class="btn small" @onclick="ToggleTheme">
            @(_isDark ? "☀️ 亮色" : "🌙 暗色")
        </button>
    </div>
</div>

<div class="settings-section">
    <h3>设备信息</h3>
    <p>设备 ID: <code>@Signer.DeviceId[..8]</code></p>
    <p>设备名称: <code>@Signer.DeviceName</code></p>
</div>

<div class="settings-section">
    <h3>数据管理</h3>
    <button class="btn" @onclick="ClearCache">清除缓存</button>
    <button class="btn danger" @onclick="ConfirmDeleteVaults">删除已同步数据</button>
    <p class="empty-hint">已同步数据位于: <code>@_vaultsPath</code></p>
</div>

@if (_confirmDelete)
{
    <div class="confirm-overlay">
        <div class="confirm-dialog">
            <p>确认删除所有已同步的知识库数据？此操作不可恢复。</p>
            <div class="confirm-actions">
                <button class="btn danger" @onclick="DeleteVaultsData">确认删除</button>
                <button class="btn" @onclick="() => _confirmDelete = false">取消</button>
            </div>
        </div>
    </div>
}

@if (_message != null)
{
    <p class="status-message">@_message</p>
}

<div class="settings-section">
    <h3>关于</h3>
    <p>花圃（BaiHua.Nursery）</p>
    <p>版本: 1.0.0-preview</p>
    <p class="empty-hint">花圃服务移动端技术验证工具</p>
</div>

@code {
    private string _vaultsPath = "";
    private bool _confirmDelete = false;
    private string? _message;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        _vaultsPath = Path.Combine(FileSystem.AppDataDirectory, "vaults");
        try { _isDark = await JS.InvokeAsync<string>("getTheme") == "dark"; } catch { }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var theme = await JS.InvokeAsync<string>("toggleTheme");
            _isDark = theme == "dark";
        }
        catch { }
    }

    private async Task ClearCache()
    {
        var current = await ServerStore.GetCurrentServerAsync();
        if (current != null)
        {
            BaihuaSdk.Services.SyncServiceImpl.ClearVaultListCache(current.HttpUrl);
        }
        _message = "缓存已清除";
        StateHasChanged();
    }

    private void ConfirmDeleteVaults()
    {
        _confirmDelete = true;
    }

    private void DeleteVaultsData()
    {
        try
        {
            if (Directory.Exists(_vaultsPath))
            {
                Directory.Delete(_vaultsPath, recursive: true);
                _message = "已同步数据已删除";
            }
            else
            {
                _message = "没有已同步数据";
            }
        }
        catch (Exception ex)
        {
            _message = $"删除失败: {ex.Message}";
        }
        _confirmDelete = false;
        StateHasChanged();
    }
}
