@page "/"
@inject BaihuaSdk.Storage.IServerConfigStore ServerStore
@inject BaihuaSdk.Storage.ISecureStore SecureStore
@inject BaihuaSdk.Signing.IRequestSigner Signer
@inject NavigationManager Nav

<PageTitle>花圃</PageTitle>

<div class="home-header">
    <h1>花圃</h1>
    <p class="home-subtitle">个人知识库集散地</p>
</div>

<div class="search-bar" @onclick="GoSearch">
    <span class="search-icon">🔍</span>
    <span class="search-placeholder">搜索知识库...</span>
</div>

<div class="home-section">
    <h2>快捷入口</h2>
    <div class="quick-grid">
        <div class="quick-item" @onclick="GoPairing">
            <span class="quick-icon">🔗</span>
            <span class="quick-label">配对服务器</span>
        </div>
        <div class="quick-item" @onclick="GoSync">
            <span class="quick-icon">📥</span>
            <span class="quick-label">获取知识库</span>
        </div>
        <div class="quick-item" @onclick="GoVaults">
            <span class="quick-icon">📁</span>
            <span class="quick-label">浏览已同步</span>
        </div>
        <div class="quick-item" @onclick="GoSettings">
            <span class="quick-icon">⚙️</span>
            <span class="quick-label">设置</span>
        </div>
        <div class="quick-item" @onclick="GoMasterList">
            <span class="quick-icon">🧙</span>
            <span class="quick-label">拜师</span>
        </div>
    </div>
</div>

@if (_servers.Count > 0)
{
    <div class="home-section">
        <h2>已配对服务器</h2>
        <div class="server-list">
            @foreach (var s in _servers)
            {
                <div class="server-card @(s.IsOnline ? "online" : "offline")" @onclick="() => SelectServer(s)">
                    <div class="server-status-dot @(s.IsOnline ? "dot-online" : "dot-offline")"></div>
                    <div class="server-info">
                        <div class="server-name">@s.Name</div>
                        <div class="server-url">@s.HttpUrl</div>
                    </div>
                    <span class="server-arrow">›</span>
                </div>
            }
        </div>
    </div>
}

@if (_selectedServer != null)
{
    <div class="home-section">
        <h2>@_selectedServer.Name</h2>
        <div class="action-cards">
            <button class="action-card primary" @onclick="GoSync">
                <span class="action-icon">📥</span>
                <span>获取知识库</span>
            </button>
            <button class="action-card" @onclick="GoVaults">
                <span class="action-icon">�</span>
                <span>浏览已同步</span>
            </button>
        </div>
    </div>
}

@if (_confirmDelete != null)
{
    <div class="confirm-overlay">
        <div class="confirm-dialog">
            <p>确认删除服务器 "@_confirmDelete.Name"？</p>
            <div class="confirm-actions">
                <button class="btn danger" @onclick="ConfirmDelete">确认删除</button>
                <button class="btn" @onclick="() => _confirmDelete = null">取消</button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<BaihuaSdk.Models.ServerConfig> _servers = Array.Empty<BaihuaSdk.Models.ServerConfig>();
    private BaihuaSdk.Models.ServerConfig? _selectedServer;
    private BaihuaSdk.Models.ServerConfig? _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        _servers = await ServerStore.GetServersAsync();
        foreach (var s in _servers)
        {
            if (!Signer.HasServerSecret(s.HttpUrl))
            {
                var secret = await SecureStore.GetAsync($"secret_{s.HttpUrl}");
                if (!string.IsNullOrEmpty(secret))
                    Signer.SetServerSecret(s.HttpUrl, secret);
            }
        }
        var current = await ServerStore.GetCurrentServerAsync();
        if (current != null) _selectedServer = current;
    }

    private async Task SelectServer(BaihuaSdk.Models.ServerConfig server)
    {
        _selectedServer = server;
        await ServerStore.SetCurrentServerAsync(server.Id);
        StateHasChanged();
    }

    private void DeleteServer(BaihuaSdk.Models.ServerConfig server)
    {
        _confirmDelete = server;
    }

    private async Task ConfirmDelete()
    {
        if (_confirmDelete == null) return;

        await ServerStore.DeleteServerAsync(_confirmDelete.Id);
        Signer.ClearSecrets();

        _servers = await ServerStore.GetServersAsync();
        if (_selectedServer?.Id == _confirmDelete.Id)
            _selectedServer = null;
        _confirmDelete = null;
        StateHasChanged();
    }

    private void GoSearch() { Nav.NavigateTo("/search"); }
    private void GoSync() { Nav.NavigateTo("/sync"); }
    private void GoVaults() { Nav.NavigateTo("/vaults"); }
    private void GoPairing() { Nav.NavigateTo("/pairing"); }
    private void GoSettings() { Nav.NavigateTo("/settings"); }
    private void GoMasterList() { Nav.NavigateTo("/master-list"); }
}
