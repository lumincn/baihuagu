@page "/master-stage/{MasterId}"
@inject IMasterService MasterService
@inject NavigationManager Nav

<PageTitle>阶段进度</PageTitle>

<div class="stage-page">
    @if (_isLoading || _profile == null)
    {
        <div class="loading">
            <div class="spinner"></div>
            <div class="loading-text">加载中...</div>
        </div>
    }
    else if (_profile == null || !_profile.Success)
    {
        <div class="error-state">
            <div class="error-icon">⚠️</div>
            <div class="error-msg">加载失败</div>
            <div class="error-detail">@_errorMessage</div>
            <div class="error-actions">
                <button class="btn btn-primary" @onclick="@LoadProfileAsync">重试</button>
                <button class="btn" @onclick="@GoBack">返回</button>
            </div>
        </div>
    }
    else
    {
        <div class="stage-header">
            <button class="btn-icon" @onclick="@GoToChat" title="返回聊天">&larr;</button>
            <div class="header-info">
                <span class="title">@_profile.MasterId · 修炼进度</span>
                <span class="subtitle">@_profile.Goal</span>
            </div>
        </div>

        <div class="profile-card">
            <div class="profile-item"><span class="label">🎯 学习目标</span><span class="value">@_profile.Goal</span></div>
            <div class="profile-item"><span class="label">📚 所属行业</span><span class="value">@_profile.Industry</span></div>
            <div class="profile-item"><span class="label">📍 当前阶段</span><span class="value current">@_profile.CurrentStage</span></div>
            @if (!string.IsNullOrEmpty(_profile.EstimatedTime))
            {
                <div class="profile-item"><span class="label">⏱️ 预计时长</span><span class="value">@_profile.EstimatedTime</span></div>
            }
        </div>

        <div class="stage-timeline">
            @for (int i = 0; i < _profile.StageHistory.Count; i++)
            {
                var stage = _profile.StageHistory[i];
                var isCurrent = stage.IsCurrent;
                var isGraduated = stage.IsGraduated;
                var isUpcoming = !isCurrent && !isGraduated;

                <div class="stage-node @(isCurrent ? "current" : isGraduated ? "graduated" : "upcoming")">
                    <div class="stage-indicator">
                        @if (isGraduated) { <span class="indicator-icon">✓</span> }
                        else if (isCurrent) { <span class="indicator-icon">›</span> }
                        else { <span class="indicator-icon upcoming">○</span> }
                    </div>
                    <div class="stage-content">
                        <div class="stage-name">
                            @stage.DisplayName
                            @if (!string.IsNullOrEmpty(stage.RoleName))
                            {
                                <span class="stage-role">—— @stage.RoleName</span>
                            }
                        </div>
                        <div class="stage-desc">@stage.Description</div>

                        @if (isCurrent)
                        {
                            <div class="stage-progress-bar">
                                <div class="progress-fill" style="width: @stage.ProgressPct%"></div>
                            </div>
                            <div class="progress-label">学习进度：@stage.ProgressPct%</div>
                        }

                        @if (isGraduated && !string.IsNullOrEmpty(stage.Summary))
                        {
                            <div class="stage-summary-card">
                                <div class="summary-header">
                                    <span class="summary-icon">📝</span>
                                    <span class="summary-title">阶段小结</span>
                                </div>
                                <div class="summary-text">
                                    <MarkdownView Content="@stage.Summary" />
                                </div>
                            </div>
                        }

                        @if (isCurrent)
                        {
                            <button class="btn btn-sm btn-complete" @onclick="@(() => CompleteStageAsync(stage.Name))" disabled="@_isCompleting">
                                @(_isCompleting ? "请稍候..." : "完成本阶段")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_showStageCompleteModal)
        {
            <div class="modal-overlay" @onclick="@CloseModal">
                <div class="modal-content stage-complete-modal" @onclick:stopPropagation>
                    <div class="modal-icon">🎉</div>
                    <h4>恭喜！阶段完成</h4>
                    @if (!string.IsNullOrEmpty(_completedStageName))
                    {
                        <p class="completed-stage-name">「@_completedStageName」</p>
                    }
                    @if (!string.IsNullOrEmpty(_stageCompleteSummary))
                    {
                        <div class="complete-summary">
                            <div class="complete-summary-title">师父寄语：</div>
                            <div class="complete-summary-content">
                                <MarkdownView Content="@_stageCompleteSummary" />
                            </div>
                        </div>
                    }
                    <div class="modal-actions">
                        <button class="btn btn-primary" @onclick="@CloseModal">好的，继续努力</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .stage-page { min-height: 100vh; }
    .loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3rem; color: var(--text-secondary); }
    .loading .spinner { width: 32px; height: 32px; border: 3px solid var(--border); border-top-color: var(--primary-color); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 1rem; }
    .loading-text { font-size: 0.95rem; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .error-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3rem; color: var(--text-secondary); }
    .error-icon { font-size: 48px; margin-bottom: 0.5rem; }
    .error-msg { font-size: 1.1rem; font-weight: 500; margin-bottom: 0.25rem; color: var(--primary-text); }
    .error-detail { font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1.5rem; text-align: center; }
    .error-actions { display: flex; gap: 0.75rem; }
    .stage-header { display: flex; align-items: center; padding: 0.75rem 1rem; background: var(--card-bg); border-bottom: 1px solid var(--border); }
    .btn-icon { background: none; border: none; font-size: 1.2rem; cursor: pointer; padding: 0.5rem; margin-right: 0.5rem; color: var(--text-primary); }
    .header-info .title { font-weight: 600; font-size: 1rem; display: block; }
    .header-info .subtitle { font-size: 0.8rem; color: var(--text-tertiary); }
    .profile-card { margin: 1rem; padding: 1rem; background: var(--card-bg); border-radius: 12px; display: grid; gap: 0.75rem; }
    .profile-item { display: flex; justify-content: space-between; align-items: center; }
    .profile-item .label { color: var(--text-tertiary); font-size: 0.85rem; }
    .profile-item .value { font-weight: 500; text-align: right; max-width: 60%; }
    .profile-item .value.current { color: var(--primary-color); font-weight: 600; }
    .stage-timeline { padding: 1rem; display: flex; flex-direction: column; gap: 0; }
    .stage-node { display: flex; gap: 0.75rem; position: relative; padding-bottom: 1.5rem; }
    .stage-node:not(:last-child)::after {
        content: ''; position: absolute; left: 18px; top: 36px; bottom: 0;
        width: 2px; background: var(--border);
    }
    .stage-node.graduated:not(:last-child)::after { background: var(--success-color, #4caf50); }
    .stage-indicator { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; }
    .stage-node.current .stage-indicator { background: var(--primary-color); }
    .stage-node.graduated .stage-indicator { background: var(--success-color, #4caf50); }
    .stage-node.upcoming .stage-indicator { background: var(--surface-alt); }
    .indicator-icon { color: white; font-size: 0.9rem; font-weight: bold; }
    .indicator-icon.upcoming { color: var(--text-tertiary); }
    .stage-content { flex: 1; }
    .stage-name { font-weight: 600; font-size: 1rem; margin-bottom: 0.25rem; }
    .stage-role { font-weight: 400; font-size: 0.85rem; color: var(--text-secondary); }
    .stage-node.upcoming .stage-name { color: var(--text-tertiary); }
    .stage-desc { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.5rem; line-height: 1.5; }
    .stage-progress-bar { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; margin: 0.5rem 0; }
    .progress-fill { height: 100%; background: var(--primary-color); border-radius: 3px; transition: width 0.3s; }
    .progress-label { font-size: 0.8rem; color: var(--text-tertiary); }
    .stage-summary-card {
        margin-top: 0.75rem; padding: 0.85rem 1rem;
        background: linear-gradient(135deg, rgba(255,215,0,0.08), rgba(255,152,0,0.06));
        border: 1px solid rgba(255,152,0,0.25);
        border-radius: 10px;
    }
    .summary-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
    .summary-icon { font-size: 1rem; }
    .summary-title { font-weight: 600; font-size: 0.9rem; color: var(--primary-text); }
    .summary-text { font-size: 0.85rem; line-height: 1.6; }
    .summary-text :deep(p) { margin: 6px 0; }
    .btn-complete { margin-top: 0.75rem; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 200; padding: 20px; }
    .modal-content { background: var(--surface); padding: 24px; border-radius: 16px; max-width: 360px; width: 100%; box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
    .stage-complete-modal { text-align: center; }
    .stage-complete-modal .modal-icon { font-size: 48px; margin-bottom: 0.5rem; }
    .stage-complete-modal h4 { font-size: 1.3rem; margin-bottom: 0.5rem; color: var(--primary-text); }
    .completed-stage-name { font-size: 1.1rem; color: var(--primary-color); font-weight: 600; margin-bottom: 1rem; }
    .complete-summary { text-align: left; background: var(--card-bg); border-radius: 10px; padding: 12px 14px; margin-bottom: 1rem; }
    .complete-summary-title { font-size: 0.85rem; color: var(--text-tertiary); margin-bottom: 6px; }
    .complete-summary-content { font-size: 0.9rem; line-height: 1.6; color: var(--primary-text); }
    .modal-actions { display: flex; gap: 10px; margin-top: 16px; }
    .modal-actions .btn { flex: 1; }
</style>

@code {
    [Parameter] public string MasterId { get; set; } = "";

    private ApprenticeProfileResponse? _profile;
    private bool _isLoading = true;
    private bool _isCompleting;
    private string _errorMessage = "";
    private bool _showStageCompleteModal;
    private string _completedStageName = "";
    private string _stageCompleteSummary = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(MasterId))
            await LoadProfileAsync();
    }

    private void GoBack()
    {
        Nav.NavigateTo("/master-list");
    }

    private void GoToChat()
    {
        if (_profile != null)
            Nav.NavigateTo($"/master-chat/{_profile.MasterId}");
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true;
        _errorMessage = "";
        try
        {
            _profile = await MasterService.GetProfileAsync(MasterId, useCache: false);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            System.Diagnostics.Debug.WriteLine($"Load profile failed: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CompleteStageAsync(string stageName)
    {
        if (_profile == null) return;

        _isCompleting = true;
        try
        {
            var result = await MasterService.CompleteStageAsync(MasterId, stageName);
            if (result.Success)
            {
                _completedStageName = stageName;
                _stageCompleteSummary = result.Summary ?? "";
                _showStageCompleteModal = true;
                await LoadProfileAsync();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Stage complete failed: {ex.Message}");
        }
        finally
        {
            _isCompleting = false;
            StateHasChanged();
        }
    }

    private void CloseModal()
    {
        _showStageCompleteModal = false;
        StateHasChanged();
    }
}
