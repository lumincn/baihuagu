@page "/master-chat/{MasterId}"
@inject IMasterService MasterService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>Master Chat</PageTitle>

<div class="chat-page">
    @if (_isLoading || _profile == null)
    {
        <div class="loading">Loading...</div>
    }
    else if (_profile == null || !_profile.Success)
    {
        <div class="error-state">
            <div class="error-icon">Error</div>
            <div class="error-msg">Failed to load</div>
            <button class="btn" @onclick="@GoBack">Back</button>
        </div>
    }
    else
    {
        <div class="chat-header">
            <button class="btn-icon" @onclick="@GoBack">&larr;</button>
            <div class="header-info">
                <span class="master-name">@_profile.MasterId</span>
                <span class="master-stage">@_profile.CurrentStage - @_profile.Goal</span>
            </div>
            <button class="btn-icon" @onclick="@GoToStage">Stats</button>
        </div>

        <div class="chat-tip">
            @GetStageTip(_profile.CurrentStage)
        </div>

        <div class="chat-messages" @ref="_chatContainer">
            @if (_messages.Count == 0 && !_isSending)
            {
                <div class="empty-chat">
                    <div class="empty-icon">M</div>
                    <div class="empty-text">@_profile.MasterId Ready</div>
                    <div class="empty-hint">Start chatting</div>
                </div>
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    <div class="message @(msg.IsUser ? "user" : "master")">
                        <div class="message-avatar">
                            @(msg.IsUser ? "U" : GetAvatar())
                        </div>
                        <div class="message-content">
                            <div class="message-text">@msg.Content</div>
                            <div class="message-time">@msg.Time.ToString("HH:mm")</div>
                        </div>
                    </div>
                }
                @if (_isSending && string.IsNullOrEmpty(_streamingText))
                {
                    <div class="message master">
                        <div class="message-avatar">@GetAvatar()</div>
                        <div class="message-content">
                            <div class="typing-indicator">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_streamingText))
                {
                    <div class="message master">
                        <div class="message-avatar">@GetAvatar()</div>
                        <div class="message-content">
                            <div class="message-text streaming">@_streamingText</div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="chat-input">
            <textarea @bind="_inputMessage"
                      placeholder="Ask your master..."
                      @onkeydown="@HandleKeyDown"
                      class="form-control"
                      rows="1"
                      disabled="@_isSending"></textarea>
            @if (_isSending)
            {
                <button class="btn btn-danger" @onclick="@StopChat">Stop</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="@SendMessage" disabled="@(!CanSend)">Send</button>
            }
        </div>
    }
</div>

<style>
    .chat-page { display: flex; flex-direction: column; height: 100vh; }
    .loading, .error-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-secondary); }
    .error-icon { font-size: 48px; margin-bottom: 1rem; }
    .error-msg { margin-bottom: 1rem; }
    .chat-header { display: flex; align-items: center; padding: 0.75rem 1rem; background: var(--card-bg); border-bottom: 1px solid var(--border); }
    .btn-icon { background: none; border: none; font-size: 1.2rem; cursor: pointer; padding: 0.5rem; margin-right: 0.5rem; color: var(--text-primary); }
    .header-info { flex: 1; }
    .master-name { font-weight: 600; font-size: 1rem; }
    .master-stage { font-size: 0.8rem; color: var(--text-tertiary); }
    .chat-tip { padding: 0.5rem 1rem; background: rgba(46,139,175,0.1); font-size: 0.85rem; color: var(--text-secondary); }
    .chat-messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .empty-chat { text-align: center; padding: 3rem; color: var(--text-secondary); }
    .empty-chat .empty-icon { font-size: 36px; margin-bottom: 0.5rem; }
    .empty-text { font-size: 1rem; }
    .empty-hint { font-size: 0.85rem; margin-top: 0.25rem; }
    .message { display: flex; gap: 0.5rem; max-width: 85%; }
    .message.user { align-self: flex-end; flex-direction: row-reverse; }
    .message.master { align-self: flex-start; }
    .message-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
    .message.user .message-avatar { background: var(--primary-color); }
    .message.master .message-avatar { background: var(--surface-alt); }
    .message-content { max-width: 100%; }
    .message-text { padding: 0.5rem 0.75rem; border-radius: 12px; line-height: 1.5; font-size: 0.95rem; white-space: pre-wrap; word-break: break-word; }
    .message.user .message-text { background: var(--primary-color); color: white; border-bottom-right-radius: 4px; }
    .message.master .message-text { background: var(--surface-alt); color: var(--text-primary); border-bottom-left-radius: 4px; }
    .message-text.streaming::after { content: '|'; animation: blink 1s infinite; }
    .message-time { font-size: 0.7rem; color: var(--text-tertiary); margin-top: 0.25rem; }
    .typing-indicator { display: flex; gap: 4px; padding: 0.5rem; background: var(--surface-alt); border-radius: 12px; }
    .typing-indicator span { width: 8px; height: 8px; border-radius: 50%; background: var(--text-tertiary); animation: typing 1.4s infinite; }
    .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
    .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
    .chat-input { display: flex; gap: 0.5rem; padding: 0.75rem 1rem; background: var(--card-bg); border-top: 1px solid var(--border); }
    .chat-input .form-control { flex: 1; resize: none; min-height: 36px; max-height: 100px; overflow-y: auto; padding: 0.5rem 0.75rem; border-radius: 20px; }
    @@keyframes blink { 50% { opacity: 0; } }
    @@keyframes typing { 0%, 60%, 100% { transform: translateY(0); opacity: 0.4; } 30% { transform: translateY(-6px); opacity: 1; } }
</style>

@code {
    [Parameter] public string MasterId { get; set; } = "";

    private ApprenticeProfileResponse? _profile;
    private List<ChatMessage> _messages = new();
    private string _inputMessage = "";
    private string _streamingText = "";
    private bool _isSending;
    private bool _isLoading = true;
    private CancellationTokenSource? _cts;
    private ElementReference _chatContainer;

    private bool CanSend => !_isSending && !string.IsNullOrWhiteSpace(_inputMessage);
    private string GetAvatar() => !string.IsNullOrEmpty(_profile?.MasterId) ? _profile.MasterId[..1].ToString() : "M";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(MasterId))
            await LoadProfileAsync();
    }

    private void GoBack()
    {
        Nav.NavigateTo("/master-list");
    }

    private void GoToStage()
    {
        if (_profile != null)
            Nav.NavigateTo($"/master-stage/{_profile.MasterId}");
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true;
        try
        {
            _profile = await MasterService.GetProfileAsync(MasterId);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Load profile failed: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_inputMessage) || _profile == null)
            return;

        var userText = _inputMessage.Trim();
        _inputMessage = "";
        _isSending = true;
        _streamingText = "";

        _messages.Add(new ChatMessage
        {
            Id = $"user_{DateTime.Now:HH:mm:ss}",
            IsUser = true,
            Content = userText,
            Time = DateTime.Now
        });
        StateHasChanged();
        await ScrollToBottomAsync();

        _cts = new CancellationTokenSource();
        try
        {
            await foreach (var chunk in MasterService.StreamChatAsync(
                MasterId, userText, _profile.CurrentStage, null, _cts.Token))
            {
                _streamingText += chunk;
                StateHasChanged();
                await ScrollToBottomAsync();
            }

            if (!string.IsNullOrEmpty(_streamingText))
            {
                _messages.Add(new ChatMessage
                {
                    Id = $"master_{DateTime.Now:HH:mm:ss}",
                    IsUser = false,
                    Content = _streamingText,
                    Time = DateTime.Now
                });
            }
        }
        catch (OperationCanceledException)
        {
            if (!string.IsNullOrEmpty(_streamingText))
                _streamingText += "\n\n(Stopped)";
            else
                _streamingText = "(Stopped)";
        }
        catch (Exception ex)
        {
            _streamingText = $"Error: {ex.Message}";
        }
        finally
        {
            if (!string.IsNullOrEmpty(_streamingText) && !_messages.LastOrDefault()?.IsUser == false)
            {
                _messages.Add(new ChatMessage
                {
                    Id = $"master_{DateTime.Now:HH:mm:ss}",
                    IsUser = false,
                    Content = _streamingText,
                    Time = DateTime.Now
                });
            }
            _streamingText = "";
            _isSending = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    private void StopChat()
    {
        try { _cts?.Cancel(); } catch { }
    }

    private async Task ScrollToBottomAsync()
    {
        await Task.Delay(100);
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "setTimeout(() => { var el = document.querySelector('.chat-messages'); if (el) el.scrollTop = el.scrollHeight; }, 0);");
        }
        catch { }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = SendMessage();
        }
    }

    private static string GetStageTip(string stage) => stage switch
    {
        "入道" => "Stage 1: Master will learn your background and goals.",
        "筑基" => "Stage 2: Master will focus on fundamentals with daily assignments.",
        "精进" => "Stage 3: Master will be strict about details and correct every error.",
        "磨砺" => "Stage 4: Master will simulate real exam conditions.",
        "出师" => "Stage 5: Master will share exam tips and real-world experience.",
        _ => ""
    };
}
