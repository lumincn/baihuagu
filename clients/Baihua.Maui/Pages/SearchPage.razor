@page "/search"
@inject BaihuaSdk.Storage.IServerConfigStore ServerStore
@inject BaihuaSdk.Storage.ISecureStore SecureStore
@inject BaihuaSdk.Signing.IRequestSigner Signer
@inject NavigationManager Nav

<PageTitle>搜索</PageTitle>

<div class="search-page-header">
    <button class="btn small" @onclick="GoBack">← 返回</button>
</div>

<div class="search-input-wrap">
    <span class="search-icon">🔍</span>
    <input @bind="_query" @bind:event="oninput" @bind:after="OnSearch" placeholder="搜索知识库..." autofocus />
    @if (!string.IsNullOrEmpty(_query))
    {
        <button class="search-clear" @onclick="ClearQuery">✕</button>
    }
</div>

@if (_isSearching)
{
    <div class="search-loading">
        <p>搜索中...</p>
    </div>
}
else if (!string.IsNullOrEmpty(_query) && _results.Count == 0)
{
    <div class="search-empty">
        <p>未找到匹配的内容</p>
    </div>
}
else if (_results.Count > 0)
{
    <div class="search-results">
        <p class="result-count">共 @_results.Count 条结果</p>
        @foreach (var r in _results)
        {
            <div class="search-result-item" @onclick="() => ViewFile(r)">
                <span class="result-icon">📄</span>
                <div class="result-info">
                    <div class="result-name">@r.DisplayName</div>
                    <div class="result-path">@r.VaultName / @r.RelPath</div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="search-hint">
        <p>输入关键词搜索已同步的知识库内容</p>
    </div>
}

@if (_viewContent != null)
{
    <div class="view-header">
        <button class="btn small" @onclick="ClosePreview">← 返回结果</button>
        <span class="view-path">@_viewFilePath</span>
    </div>
    <div class="markdown-content">@((MarkupString)_viewContent)</div>
}

@code {
    private string _query = "";
    private bool _isSearching;
    private List<SearchResult> _results = new();
    private string? _viewContent;
    private string? _viewFilePath;

    private record SearchResult(string VaultId, string VaultName, string RelPath, string FullPath, string DisplayName);

    private async Task OnSearch()
    {
        if (string.IsNullOrWhiteSpace(_query) || _query.Length < 2)
        {
            _results.Clear();
            StateHasChanged();
            return;
        }

        _isSearching = true;
        _viewContent = null;
        StateHasChanged();

        try
        {
            var baseDir = Path.Combine(FileSystem.AppDataDirectory, "vaults");
            if (!Directory.Exists(baseDir)) { _results.Clear(); return; }

            var results = new List<SearchResult>();
            var keyword = _query.ToLowerInvariant();

            foreach (var vaultDir in Directory.GetDirectories(baseDir))
            {
                var vaultId = Path.GetFileName(vaultDir);
                var vaultName = ReadVaultDisplayName(vaultDir, vaultId);

                foreach (var file in Directory.GetFiles(vaultDir, "*.md", SearchOption.AllDirectories))
                {
                    if (Path.GetFileName(file).Equals(".vault-info.json", StringComparison.OrdinalIgnoreCase))
                        continue;

                    var relPath = Path.GetRelativePath(vaultDir, file);
                    var fileName = Path.GetFileNameWithoutExtension(file);

                    if (fileName.ToLowerInvariant().Contains(keyword))
                    {
                        results.Add(new SearchResult(vaultId, vaultName, relPath, file, fileName));
                        continue;
                    }

                    try
                    {
                        var content = await File.ReadAllTextAsync(file);
                        if (content.ToLowerInvariant().Contains(keyword))
                        {
                            results.Add(new SearchResult(vaultId, vaultName, relPath, file, fileName));
                        }
                    }
                    catch { }
                }
            }

            _results = results.Take(50).ToList();
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private void ClearQuery()
    {
        _query = "";
        _results.Clear();
        _viewContent = null;
        StateHasChanged();
    }

    private void ViewFile(SearchResult result)
    {
        _viewFilePath = result.RelPath;
        try
        {
            var markdown = File.ReadAllText(result.FullPath);
            _viewContent = Markdig.Markdown.ToHtml(markdown);
        }
        catch { _viewContent = "<p>[无法预览]</p>"; }
    }

    private void ClosePreview()
    {
        _viewContent = null;
    }

    private void GoBack() => Nav.NavigateTo("/");

    private string ReadVaultDisplayName(string vaultDir, string fallbackId)
    {
        try
        {
            var infoPath = Path.Combine(vaultDir, ".vault-info.json");
            if (File.Exists(infoPath))
            {
                var json = File.ReadAllText(infoPath);
                var doc = System.Text.Json.JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("Name", out var nameEl))
                {
                    var name = nameEl.GetString();
                    if (!string.IsNullOrWhiteSpace(name)) return name;
                }
            }
        }
        catch { }
        return fallbackId;
    }
}