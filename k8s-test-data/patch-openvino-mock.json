{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "bh-openvino",
            "image": "bh-openvino-mock:latest",
            "resources": {
              "limits": { "memory": "512Mi" },
              "requests": { "cpu": "100m", "memory": "128Mi" }
            },
            "readinessProbe": {
              "httpGet": { "path": "/health", "port": 8000 },
              "initialDelaySeconds": 5,
              "periodSeconds": 5,
              "failureThreshold": 5
            }
          }
        ]
      }
    }
  }
}
