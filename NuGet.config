<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 本地离线包源优先（Docker 构建时容器内网络访问外网不稳定，
         依赖包已预先同步到 nuget-local/，构建全程离线） -->
    <add key="local" value="./nuget-local" />
    <!-- 国内镜像（本机/开发环境使用；Docker 容器内可能不可达，由 local 兜底） -->
    <add key="nuget.cn" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
