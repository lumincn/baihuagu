<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Docker 构建时通过 myhysteria HTTP 代理(7890)访问 nuget.org，比国内镜像更稳定 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value="./nuget-local" />
  </packageSources>
</configuration>
