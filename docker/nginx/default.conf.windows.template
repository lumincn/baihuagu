# 百花 Docker 部署 - Windows bridge 网络专用 Nginx 模板
# 与 docker-compose.windows.yml 配套使用
# upstream 通过 Docker DNS 服务名解析（taskrunner / webui），而非 127.0.0.1

server {
    listen ${BAIHUA_NGINX_PORT};
    server_name _;
    client_max_body_size ${BAIHUA_NGINX_CLIENT_MAX_BODY_SIZE};

    # ==============================================================
    # 安全头部（家庭版不强制 HTTPS，但防点击劫持/MIME 嗅探）
    # ==============================================================
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ==============================================================
    # 1. Blazor 静态资源（带 hash 的文件名 → 1 年强缓存）
    #    优先级最高，提前命中可减轻 Kestrel 压力
    # ==============================================================
    location ^~ ${BAIHUA_WEBUI_PREFIX}/_framework/ {
        proxy_pass http://webui:5177${BAIHUA_WEBUI_PREFIX}/_framework/;
        include /etc/nginx/family-proxy-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location ^~ ${BAIHUA_WEBUI_PREFIX}/css/ {
        proxy_pass http://webui:5177${BAIHUA_WEBUI_PREFIX}/css/;
        include /etc/nginx/family-proxy-headers.conf;
        expires 7d;
        add_header Cache-Control "public";
    }

    # ==============================================================
    # 2. Blazor SignalR Hub（WebSocket Upgrade + 长超时）
    # ==============================================================
    location ${BAIHUA_WEBUI_PREFIX}/hubs/status {
        proxy_pass http://webui:5177${BAIHUA_WEBUI_PREFIX}/hubs/status;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # ==============================================================
    # 3. 移动端 API（Family 统一授权入口）
    #    关键：/mg/* /ws/devices /api/ai/chat 等必须先到 Family，
    #    绝对不能直连 Vault/AI（否则绕过授权）
    # ==============================================================
    location /mg/ {
        proxy_pass http://taskrunner:8788/mg/;
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 600;
    }

    location = /pair {
        proxy_pass http://taskrunner:8788/pair;
        include /etc/nginx/family-proxy-headers.conf;
    }
    location = /pair/code {
        proxy_pass http://taskrunner:8788/pair/code;
        include /etc/nginx/family-proxy-headers.conf;
    }
    location = /vault/pair {
        proxy_pass http://taskrunner:8788/vault/pair;
        include /etc/nginx/family-proxy-headers.conf;
    }

    # 移动端设备推送 WebSocket
    location /ws/devices {
        proxy_pass http://taskrunner:8788/ws/devices;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # 管理侧 API + /api/ai/chat（Family 会再分发到 AI；SSE 关缓冲）
    location /api/ {
        proxy_pass http://taskrunner:8788/api/;
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 3600;
        proxy_buffering off;
    }

    # Family SignalR hubs（task-progress/devices）
    location /hubs/ {
        proxy_pass http://taskrunner:8788/hubs/;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # ==============================================================
    # 4. WebUI 根路径（放最后，最短匹配优先级最低）
    # ==============================================================
    location ${BAIHUA_WEBUI_PREFIX}/ {
        proxy_pass http://webui:5177/;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
        proxy_cache_bypass $http_upgrade;
    }
}
