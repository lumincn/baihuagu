# 百花 Docker 部署 - Windows bridge 网络专用 Nginx 模板
# 与 docker-compose.windows.yml 配套使用
# upstream 通过 Docker DNS 服务名解析（taskrunner / webui），而非 127.0.0.1

server {
    listen ${BAIHUA_NGINX_PORT};
    server_name _;
    client_max_body_size ${BAIHUA_NGINX_CLIENT_MAX_BODY_SIZE};

    # ==============================================================
    # Docker DNS 解析：127.0.0.11 是 Docker 内置 DNS Server
    # 关键：Nginx 默认在启动时解析 upstream hostname 一次并缓存，
    # 若后端容器被重建（IP 改变），缓存过期前会 502 Connection refused。
    # 解决方案：
    #   1) resolver + 短 valid（每 10s 刷新）
    #   2) proxy_pass 目标写成 set 变量（host:port，不带路径）
    #   3) 每个 location 里用 rewrite ... break 明确生成上游 URI
    #      （因为变量形式 proxy_pass 不会做 location 前缀自动替换，
    #       必须手动精确控制上游 URI，避免出现 /mg//mg/xxx 双层前缀）
    # ==============================================================
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 3s;

    # 变量形式 + 只写 host:port（每次请求都走 resolver，不缓存启动时解析）
    set $bh_family_upstream http://taskrunner:8788;
    set $bh_webui_upstream  http://webui:5177;

    # ==============================================================
    # 安全头部（家庭版不强制 HTTPS，但防点击劫持/MIME 嗅探）
    # ==============================================================
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ==============================================================
    # 工具宏：保留前缀透传
    #   对于 Family /mg/* /api/* /hubs/* /ws/* 等，请求路径就是上游路径，
    #   无需前缀剥离。统一 rewrite 后由 proxy_pass 变量拼接到 host 上。
    # ==============================================================

    # ==============================================================
    # 1. Blazor 静态资源（带 hash 的文件名 → 1 年强缓存）
    #    优先级最高，提前命中可减轻 Kestrel 压力
    # ==============================================================
    location ^~ ${BAIHUA_WEBUI_PREFIX}/_framework/ {
        rewrite ^${BAIHUA_WEBUI_PREFIX}/(.*)$ /$1 break;
        proxy_pass $bh_webui_upstream;
        include /etc/nginx/family-proxy-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location ^~ ${BAIHUA_WEBUI_PREFIX}/css/ {
        rewrite ^${BAIHUA_WEBUI_PREFIX}/(.*)$ /$1 break;
        proxy_pass $bh_webui_upstream;
        include /etc/nginx/family-proxy-headers.conf;
        expires 7d;
        add_header Cache-Control "public";
    }

    # ==============================================================
    # 2. Blazor SignalR Hub（WebSocket Upgrade + 长超时）
    # ==============================================================
    location ${BAIHUA_WEBUI_PREFIX}/hubs/status {
        rewrite ^${BAIHUA_WEBUI_PREFIX}/(.*)$ /$1 break;
        proxy_pass $bh_webui_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # ==============================================================
    # 3. 移动端 API（Family 统一授权入口）
    #    关键：/mg/* /ws/devices /api/ai/chat 等必须先到 Family，
    #    绝对不能直连 Vault/AI（否则绕过授权）
    # ==============================================================
    location /mg/ {
        rewrite ^/(.*)$ /$1 break;
        proxy_pass $bh_family_upstream;
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 600;
    }

    location = /pair {
        rewrite ^ /pair break;
        proxy_pass $bh_family_upstream;
        include /etc/nginx/family-proxy-headers.conf;
    }
    location = /pair/code {
        rewrite ^ /pair/code break;
        proxy_pass $bh_family_upstream;
        include /etc/nginx/family-proxy-headers.conf;
    }
    location = /vault/pair {
        rewrite ^ /vault/pair break;
        proxy_pass $bh_family_upstream;
        include /etc/nginx/family-proxy-headers.conf;
    }

    # 移动端设备推送 WebSocket
    location /ws/devices {
        rewrite ^ /ws/devices break;
        proxy_pass $bh_family_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # 管理侧 API + /api/ai/chat（Family 会再分发到 AI；SSE 关缓冲）
    location /api/ {
        rewrite ^/(.*)$ /$1 break;
        proxy_pass $bh_family_upstream;
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 3600;
        proxy_buffering off;
    }

    # Family SignalR hubs（task-progress/devices）
    location /hubs/ {
        rewrite ^/(.*)$ /$1 break;
        proxy_pass $bh_family_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # ==============================================================
    # 4. WebUI 根路径（放最后，最短匹配优先级最低）
    #    BAIHUA_WEBUI_PREFIX 非空时，在上游端剥掉前缀
    # ==============================================================
    location ${BAIHUA_WEBUI_PREFIX}/ {
        rewrite ^${BAIHUA_WEBUI_PREFIX}/(.*)$ /$1 break;
        proxy_pass $bh_webui_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        include /etc/nginx/family-proxy-headers.conf;
        proxy_read_timeout 86400;
        proxy_buffering off;
        proxy_cache_bypass $http_upgrade;
    }
}
