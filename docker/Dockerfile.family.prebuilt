# bh-family (K8s 轻量版): 不含 OpenVINO/Python
# OpenVINO 推理已拆分到 bh-openvino 独立容器
# Family 通过 K8s Service DNS (http://bh-openvino:8000) 调用 OpenVINO API
#
# 构建命令（由 deploy.sh 调用）：
#   docker build -f docker/Dockerfile.family.prebuilt -t bh-family:latest .
#
# 与 Dockerfile.family-openvino.prebuilt 的区别：
#   - 不安装 Python/OpenVINO/Intel GPU 运行时
#   - 镜像体积 ~800MB（vs ~3GB）
#   - 不需要 GPU 资源

FROM bh/base-runtime:latest AS runtime
WORKDIR /app

COPY publish/family .

EXPOSE 8788

ENV ASPNETCORE_URLS=http://0.0.0.0:8788
ENV BAIHUA_HOME=/app/data
ENV TASKRUNNER_SKIP_MUTEX=true

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8788/health || exit 1

ENTRYPOINT ["dotnet", "bh-family.dll"]
