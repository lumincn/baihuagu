[Unit]
Description=Baihua Vault
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/baihua/Baihua.Vault
EnvironmentFile=/etc/systemd/system/vault.env
Environment=BAIHUA_HOME=/opt/baihua/data
ExecStart=/usr/bin/dotnet Baihua.Vault.dll --urls http://0.0.0.0:8790
Restart=always
RestartSec=5
StandardOutput=append:/opt/baihua/logs/baihua-vault.log
StandardError=append:/opt/baihua/logs/baihua-vault.log

[Install]
WantedBy=multi-user.target
