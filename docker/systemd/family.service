[Unit]
Description=Baihua Family
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/baihua/family
EnvironmentFile=/etc/systemd/system/family.env
Environment=BAIHUA_HOME=/opt/baihua/data
ExecStart=/usr/bin/dotnet bh-family.dll --urls http://0.0.0.0:8788
Restart=always
RestartSec=5
StandardOutput=append:/opt/baihua/logs/baihua-family.log
StandardError=append:/opt/baihua/logs/baihua-family.log

[Install]
WantedBy=multi-user.target
