[Unit]
Description=TaskRunner Family
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/baihua/TaskRunner.Family
EnvironmentFile=/etc/systemd/system/taskrunner.env
Environment=BAIHUA_HOME=/opt/baihua/data
ExecStart=/usr/bin/dotnet TaskRunner.Family.dll --urls http://0.0.0.0:8788
Restart=always
RestartSec=5
StandardOutput=append:/opt/baihua/logs/taskrunner.log
StandardError=append:/opt/baihua/logs/taskrunner.log

[Install]
WantedBy=multi-user.target
