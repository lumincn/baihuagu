# WebUI.Family - 瀹跺涵鐗堢鐞嗗悗鍙帮紙Blazor Server锛?
# 鍩轰簬棰勬瀯寤虹殑鍩虹闀滃儚锛屽姞閫熸瀯寤鸿繃绋?
#
# 棣栨鏋勫缓鍓嶉渶瑕佸厛鏋勫缓鍩虹闀滃儚锛?
#   docker build -f Dockerfile.base-build -t yj-family/base-build:latest ..
#   docker build -f Dockerfile.base-runtime -t yj-family/base-runtime:latest ..

# ==================== Build 闃舵 ====================
FROM yj-family/base-build:latest AS build
WORKDIR /src

# 鍏堝鍒堕」鐩枃浠朵互鍒╃敤 Docker 缂撳瓨灞?
COPY services/Baihua.Contracts/Baihua.Contracts.csproj services/Baihua.Contracts/
COPY services/Baihua.Web/Baihua.Web.csproj services/Baihua.Web/
RUN dotnet restore services/Baihua.Web/Baihua.Web.csproj

# 澶嶅埗鍏ㄩ儴婧愮爜骞跺彂甯?
COPY services/ services/
# 娓呯悊瀹夸富鏈哄彲鑳藉甫鍏ョ殑 bin/obj 缂撳瓨锛岀‘淇?dotnet publish 瀹屾暣鐢熸垚鎵€鏈夋枃浠讹紙鍖呮嫭 _framework锛?
RUN find /src/services -type d -name bin -exec rm -rf {} + 2>/dev/null; \
    find /src/services -type d -name obj -exec rm -rf {} + 2>/dev/null; \
    dotnet restore services/Baihua.Web/Baihua.Web.csproj && \
    dotnet publish services/Baihua.Web/Baihua.Web.csproj \
    -c Release -o /app/publish

# ==================== Runtime 闃舵 ====================
FROM yj-family/base-runtime:latest AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
LABEL git.commit=$GIT_COMMIT
LABEL git.branch=$GIT_BRANCH

EXPOSE 5177

ENV ASPNETCORE_URLS=http://0.0.0.0:5177
ENV WEBUI_CONFIG_DIR=/app/data
# Docker 缃戠粶鍐呴€氳繃鏈嶅姟鍚嶈闂?TaskRunner
# host 缃戠粶妯″紡涓嬮€氳繃 localhost 璁块棶 TaskRunner
# bridge 缃戠粶妯″紡涓嬫敼涓?http://taskrunner:8788/
ENV TaskRunnerApi__BaseUrl=http://127.0.0.1:8788/
ENV TaskRunnerVaultApi__BaseUrl=http://127.0.0.1:8790/

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5177/ || exit 1

ENTRYPOINT ["dotnet", "WebUI.Family.dll"]
