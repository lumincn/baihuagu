# bh-family with OpenVINO + Intel GPU support
# 基于 .NET 10 ASP.NET + Python 3.12 + openvino-genai
# 适用于 K8s + Intel GPU Device Plugin 环境
#
# 构建命令（prebuilt 模式，由 deploy.sh 调用）：
#   docker build -f docker/Dockerfile.family-openvino.prebuilt -t bh-family-openvino:latest .
#
# 与标准 Dockerfile.family.win-prebuilt 的区别：
#   1. 基础镜像加装 Python 3.12 + Intel GPU 运行时库
#   2. 安装 openvino-genai + openvino（支持 CPU/GPU/NPU 推理）
#   3. 安装 level-zero / intel-opencl-icd（GPU 设备访问）
#   4. 镜像体积增加 ~2GB（OpenVINO + 依赖），但无需在运行时拉取

FROM bh/base-runtime:latest AS runtime

# ============================================================
# 安装 Intel GPU 运行时 + Python 3.12 + OpenVINO
# ============================================================

# 使用华为云镜像源加速
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null; \
    sed -i 's|http://security.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null; \
    sed -i 's|http://archive.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list 2>/dev/null; \
    sed -i 's|http://security.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list 2>/dev/null; \
    true

# 安装系统依赖：
# - Python 3.12 + pip: OpenVINO 推理服务
# - intel-opencl-icd: Intel GPU OpenCL 运行时
# - level-zero-dev: Intel Level Zero（OpenVINO GPU 后端）
# - libigdgmm12: Intel Graphics Memory Manager
# - clinfo: GPU 检测工具（调试用）
# - pciutils: lspci（GPU 检测用）
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        intel-opencl-icd \
        level-zero-dev \
        libigdgmm12 \
        clinfo \
        pciutils \
        && \
    rm -rf /var/lib/apt/lists/*

# 安装 OpenVINO Python 包
# openvino-genai: 生成式 AI 推理（LLM/VLM）
# openvino: 核心推理引擎
# 使用国内 PyPI 镜像加速
RUN pip3 install --break-system-packages \
        -i https://mirrors.huaweicloud.com/repository/pypi/simple \
        --trusted-host mirrors.huaweicloud.com \
        openvino-genai==2026.2.1 \
        openvino==2026.2.1 \
        fastapi \
        uvicorn

# 验证 OpenVINO 安装
RUN python3 -c "from openvino.runtime import Core; core = Core(); print('OpenVINO devices:', core.available_devices)" || echo "OpenVINO installed (GPU will be available when /dev/dri is mounted)"

WORKDIR /app

# 复制预构建产物
COPY publish/family .

# 确保 LocalVision/openvino_llm_server.py 存在（随发布打包）
RUN ls -la LocalVision/openvino_llm_server.py || echo "WARNING: openvino_llm_server.py not found in publish output"

EXPOSE 8788

ENV ASPNETCORE_URLS=http://0.0.0.0:8788
ENV BAIHUA_HOME=/app/data
ENV BAIHUA_SKIP_MUTEX=true
ENV OPENVINO_DEVICE=GPU

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8788/health || exit 1

ENTRYPOINT ["dotnet", "bh-family.dll"]
