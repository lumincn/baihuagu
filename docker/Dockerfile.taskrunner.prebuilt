# 预构建模式：宿主机 dotnet publish 后，仅将产物打包为 Docker 镜像
# 适用于 Windows Docker Desktop（避免容器内 NuGet 下载超时）
# 由 bh.ps1 build 自动调用，无需手动执行

FROM bh-family/base-runtime:latest AS runtime
WORKDIR /app

COPY publish/family .

EXPOSE 8788

ENV ASPNETCORE_URLS=http://0.0.0.0:8788
ENV YJ_DATA_DIR=/app/data
ENV TASKRUNNER_SKIP_MUTEX=true

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8788/health || exit 1

ENTRYPOINT ["dotnet", "bh-family.dll"]
