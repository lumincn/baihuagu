# Baihua.AI - 百花 AI 微服务
# 基于预构建的基础镜像，加速构建过程
#
# 首次构建前需要先构建基础镜像：
#   docker build -f Dockerfile.base-build -t bh/base-build:latest ..
#   docker build -f Dockerfile.base-runtime -t bh/base-runtime:latest ..

# ==================== Build 阶段 ====================
FROM bh/base-build:latest AS build
WORKDIR /src

# 先复制项目文件以利用 Docker 缓存层
COPY services/Baihua.Contracts/Baihua.Contracts.csproj services/Baihua.Contracts/
COPY services/Baihua.Data/Baihua.Data.csproj services/Baihua.Data/
COPY services/Baihua.Core/Baihua.Core.csproj services/Baihua.Core/
COPY services/Baihua.AI/Baihua.AI.csproj services/Baihua.AI/
COPY services/Baihua.AI.Provider/Baihua.AI.Provider.csproj services/Baihua.AI.Provider/
COPY NuGet.config .
COPY nuget-local/ nuget-local/
RUN dotnet restore services/Baihua.AI/Baihua.AI.csproj -r linux-x64

# 复制全部源码并发布
COPY services/ services/
COPY libs/ libs/
RUN dotnet publish services/Baihua.AI/Baihua.AI.csproj \
    -c Release -o /app/publish --no-restore

# ==================== Runtime 阶段 ====================
FROM bh/base-runtime:latest AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
LABEL git.commit=$GIT_COMMIT
LABEL git.branch=$GIT_BRANCH

EXPOSE 8791

ENV ASPNETCORE_URLS=http://0.0.0.0:8791
ENV BAIHUA_HOME=/app/data

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8791/health || exit 1

ENTRYPOINT ["dotnet", "bh-ai.dll"]
