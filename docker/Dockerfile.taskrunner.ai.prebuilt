# 预构建模式：宿主机 dotnet publish 后，仅将产物打包为 Docker 镜像

FROM bh-family/base-runtime:latest AS runtime
WORKDIR /app

COPY publish/ai .

EXPOSE 8791

ENV ASPNETCORE_URLS=http://0.0.0.0:8791
ENV YJ_DATA_DIR=/app/data

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8791/health || exit 1

ENTRYPOINT ["dotnet", "bh-ai.dll"]
