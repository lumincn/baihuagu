# 离线 SDK 基础镜像：把 NuGet.config + nuget-local/ 离线包源沉进镜像，
# 下游 .NET 服务镜像的 build 阶段 FROM 本镜像后，restore 全程离线且
# 构建 context 不再携带 1GB 包目录。
#
# nuget-local 以 build-context 传入（主 context 被 .dockerignore 排除该目录，
# 避免每次构建打包 1GB）：
#   nerdctl build --build-context "nuget=<仓库根>/nuget-local" -f k8s/images/Dockerfile.sdk-offline -t bh/sdk-offline:latest .
#   docker buildx build --build-context "nuget=<仓库根>/nuget-local" -f k8s/images/Dockerfile.sdk-offline -t bh/sdk-offline:latest .

# Ubuntu 26.04 (resolute) SDK：与运行时 aspnet 10.0-resolute 同波段。
# 注意：Blazor 框架静态资源（blazor.web.js）已由 Baihua.Web.csproj 显式引用
# Microsoft.AspNetCore.App.Internal.Assets 兜底，浮动 SDK 版本也不会再缺 _framework。
FROM mcr.microsoft.com/dotnet/sdk:10.0-resolute
WORKDIR /src
COPY NuGet.config .
COPY --from=nuget . ./nuget-local/
