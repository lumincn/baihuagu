# 源码构建（多阶段）：build 阶段在离线 SDK 镜像（bh/sdk-offline，含 nuget-local 包源）内现场 publish，
# 宿主/发布机无需安装 .NET SDK，也无需维护 prebuilt 产物；restore 全程离线。
#
# 构建上下文 = 仓库根（services/ + libs/ 源码；nuget-local 已沉底在 sdk-offline 镜像，无需携带）。
#
# 构建命令（nerdctl/docker 通用，context=仓库根）：
#   nerdctl build -f k8s/images/Dockerfile.ai -t bh-ai:latest .

FROM bh/sdk-offline:latest AS build
WORKDIR /src
# 先 COPY 各 csproj 恢复依赖（依赖不变则 restore 层命中缓存）
COPY services/Baihua.Contracts/Baihua.Contracts.csproj services/Baihua.Contracts/
COPY services/Baihua.Data/Baihua.Data.csproj services/Baihua.Data/
COPY services/Baihua.Core/Baihua.Core.csproj services/Baihua.Core/
COPY services/Baihua.AI.Provider/Baihua.AI.Provider.csproj services/Baihua.AI.Provider/
COPY services/Baihua.AI.Provider.OpenVino/Baihua.AI.Provider.OpenVino.csproj services/Baihua.AI.Provider.OpenVino/
COPY services/Baihua.AI/Baihua.AI.csproj services/Baihua.AI/
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    dotnet restore services/Baihua.AI/Baihua.AI.csproj -r linux-x64 --nologo
# 再 COPY 源码（代码变更只影响编译层）
COPY services/ services/
COPY libs/ libs/
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    dotnet publish services/Baihua.AI/Baihua.AI.csproj \
        -c Release -o /publish --no-restore --nologo

FROM bh/base-runtime:latest AS runtime
WORKDIR /app

# LLamaSharp Vulkan backend 专用（仅本容器需要，base-runtime 不含）:
# libvulkan1 + mesa-vulkan-drivers → /dev/dri 真机 GPU 推理；vulkan-tools 供排查
# 镜像源先换华为云（容器内 archive.ubuntu.com 不可达），与 base-runtime 同策略
RUN sed -i 's|http://archive.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null; \
    sed -i 's|http://security.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null; \
    sed -i 's|http://archive.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list 2>/dev/null; \
    sed -i 's|http://security.ubuntu.com|https://mirrors.huaweicloud.com|g' /etc/apt/sources.list 2>/dev/null; \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libvulkan1 \
        mesa-vulkan-drivers \
        vulkan-tools && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /publish .

EXPOSE 8791

ENV ASPNETCORE_URLS=http://0.0.0.0:8791
ENV BAIHUA_HOME=/app/data

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8791/health || exit 1

ENTRYPOINT ["dotnet", "bh-ai.dll"]
