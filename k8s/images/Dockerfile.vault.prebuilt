# 预构建模式：宿主机 dotnet publish 后，仅将产物打包为 Docker 镜像

FROM bh/base-runtime:latest AS runtime
WORKDIR /app

COPY publish/vault .

EXPOSE 8790

ENV ASPNETCORE_URLS=http://0.0.0.0:8790
ENV BAIHUA_HOME=/app/data
ENV BAIHUA_SKIP_MUTEX=true

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8790/health || exit 1

ENTRYPOINT ["dotnet", "bh-vault.dll"]
